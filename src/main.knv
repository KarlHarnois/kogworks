(use knave-commandant defcli defcommand run-command)
(use synth error->message factory-module synth-factory)

(export greeting)

(defcommand synth "Writes <dir>/factory.json." (dir string))

(defcommand module "Writes the module that synth evaluates."
  (dir string))

(defcli kogworks "Builds the factory."
  (commands synth module))

(defn greeting () "hello")

(defn main ()
  (match (:command (run-command kogworks))
    ((kogworks-command/synth options)
     (synth-and-exit (:dir options)))
    ((kogworks-command/module options)
     (module-and-exit (:dir options)))))

(type synth-and-exit
  (fn ((ref str)) unit))

(defn synth-and-exit (directory)
  (match (synth-factory directory)
    ((ok _) (do))
    ((err failure) (eprintln (error->message failure)) (exit 1))))

(type module-and-exit
  (fn ((ref str)) unit))

(defn module-and-exit (directory)
  (match (factory-module directory)
    ((ok module-text) (print module-text))
    ((err failure) (eprintln (error->message failure)) (exit 1))))
