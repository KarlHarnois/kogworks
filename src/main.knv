(use knave-commandant run-command)
(use apply apply-and-exit)
(use controller/controller controller-and-exit)
(use cli kogworks-command kogworks-spec matches->kogworks)

(use synth error->message factory-format-module
           factory-module synth-factory)

(defn main ()
  (match (:command (run-command kogworks))
    ((kogworks-command/synth options)
     (synth-and-exit (:dir options)))
    ((kogworks-command/module options)
     (module-and-exit (:dir options)))
    ((kogworks-command/format options)
     (format-and-exit (:dir options)))
    ((kogworks-command/controller options)
     (controller-and-exit (as-str (:repo options))
                          (:poll options)
                          (:merge-poll options)
                          (:merge-timeout options)
                          (:once options)))
    ((kogworks-command/apply options)
     (apply-and-exit (as-str (:repo options))))))

(defn synth-and-exit (dir)
  (match (synth-factory dir)
    ((ok _) (do))
    ((err failure) (eprintln (error->message failure)) (exit 1))))

(type module-and-exit
  (fn ((ref str)) unit))

(defn module-and-exit (dir)
  (match (factory-module dir)
    ((ok module-text) (print module-text))
    ((err failure) (eprintln (error->message failure)) (exit 1))))

(type format-and-exit
  (fn ((ref str)) unit))

(defn format-and-exit (dir)
  (match (factory-format-module dir)
    ((ok module-text) (print module-text))
    ((err failure) (eprintln (error->message failure)) (exit 1))))
