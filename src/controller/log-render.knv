(module
  "Renders the controller log lines from the line model.")

(use controller/log-model ->stage-entry banner-line
                          log-settings log-status
                          output-target pr-summary
                          running-item running-status
                          stage-entry stage-state stop-line
                          sub-line track track-form
                          tree-branch)

(use controller/log-palette color-mode style-open
                            text-style)

(use controller/log-width append-lines! display-width
                          fitted-title push-line! spaces
                          strip-prefix wrap-value)

(export render-alive render-banner render-controller-failure
        render-item render-stop render-sub-lines)

(def status-column-width 11)

(def label-column-width 12)

(def value-column-offset 16)

(def full-track-width 24)

(def glyph-track-width 3)

(def narrow-track-threshold 110)

(def sub-line-indent-width 10)

(defstruct sub-line-gutter
  :text string
  :width int)

(defstruct text-span
  :style text-style
  :text string)

(defstruct running-split
  :before string
  :after string)

(defn render-alive (settings alive)
  (let (full (full-alive-text alive))
    (if (alive-full? settings alive full)
      (vec (styled settings text-style/secondary (as-str full)))
      (vec (styled settings text-style/secondary
                   (as-str (counts-alive-text alive)))))))

(defn render-banner (settings banner)
  (vec (banner-text settings banner)))

(defn render-controller-failure (settings failure)
  (let (line (str (styled settings text-style/secondary
                          (as-str (:time failure)))
                  "  controller  "
                  (:status failure)))
    (with-first-line line
                     (render-sub-lines settings "controller"
                                       (:sub-lines failure)))))

(defn render-item (settings item)
  (let (form (track-form-of settings)
        prefix-width (item-prefix-width item form)
        line (str (styled settings text-style/secondary (as-str (:time item)))
                  "  "
                  (styled settings text-style/bold (as-str (:id item)))
                  "  "
                  (track-text settings (clone (:track item)))
                  "  "
                  (status-cell settings (:status item))
                  "  "
                  (fitted-title (:width settings) prefix-width (:title item)))
        sub-lines (render-sub-lines settings (:id item) (:sub-lines item)))
    (with-first-line line sub-lines)))

(defn render-stop (settings stop)
  (let (line (stop-text settings stop))
    (with-first-line line
                     (render-sub-lines settings "controller"
                                       (stop-sub-lines stop)))))

(defn render-sub-lines (settings owner sub-lines)
  (loop (index 0
         lines (vec))
    (if (>= index (len sub-lines))
      lines
      (recur (inc index)
             (append-lines! lines
                            (render-sub-line settings owner
                                             (branch-at sub-lines index)
                                             (at sub-lines index)))))))

(defn alive-full? (settings alive text)
  (if (empty? (:running alive))
    false
    (alive-fits? settings text)))

(defn alive-fits? (settings text)
  (match (:width settings)
    (none true)
    ((some width) (<= (display-width (as-str text)) width))))

(type banner-text
  (fn (log-settings (ref banner-line)) string))

(defn banner-text (settings banner)
  (str (styled settings text-style/secondary
               (as-str (:time banner)))
       "  ● "
       (styled settings text-style/bold "kogworks")
       "  "
       (styled settings text-style/secondary "roadmap")
       " "
       (:roadmap banner)
       " "
       (styled settings text-style/secondary "·")
       " "
       (manager-text settings (:manager banner))
       " "
       (styled settings text-style/secondary "·")
       " "
       (poll-text settings (:poll-seconds banner))))

(defn counts-alive-text (alive)
  (str (:time alive)
       "  · "
       (len (:running alive))
       " running · "
       (:merged alive)
       " merged · "
       (:accepted alive)
       " accepted"))

(defn full-alive-text (alive)
  (str (:time alive)
       "  · running "
       (join (collect (map (:running alive) running-description))
             ", ")
       " · "
       (:merged alive)
       " merged"))

(defn item-prefix-width (item form)
  (let (status-width (max status-column-width
                          (display-width (as-str (status-plain-text (:status
                                                                      item))))))
    (+ (display-width (as-str (:time item)))
       2
       (display-width (as-str (:id item)))
       2
       (track-cell-width form)
       2 status-width 2)))

(defn status-cell (settings status)
  (let (plain (status-plain-text status))
    (str (styled settings
                 (status-style status)
                 (as-str (status-text settings status)))
         (spaces (max 0
                      (- status-column-width
                         (display-width (as-str plain))))))))

(defn stop-sub-lines (stop)
  (loop (index 0
         lines (vec))
    (if (>= index (len (:running stop)))
      (push-line! lines
                  (sub-line/rerun (clone (:rerun stop))))
      (recur (inc index)
             (push-line! lines
                         (sub-line/running (clone (at (:running stop)
                                                      index))))))))

(type stop-text
  (fn ((ref log-settings) (ref stop-line))
    string))

(defn stop-text (settings stop)
  (let (time (as-str (:time stop))
        merged (str (:merged stop) " merged")
        accepted (str (:accepted stop) " accepted")
        failed (str (:failed stop) " failed")
        running (str (len (:running stop)) " running"))
    (str (styled settings text-style/secondary time)
         "  "
         (styled settings text-style/failure "■")
         " "
         (styled settings text-style/bold "controller stopped")
         "  "
         (styled settings text-style/success (as-str merged))
         " "
         (styled settings text-style/secondary "·")
         " "
         (styled settings text-style/success (as-str accepted))
         " "
         (styled settings text-style/secondary "·")
         " "
         (styled settings text-style/failure (as-str failed))
         " "
         (styled settings text-style/secondary "·")
         " " running)))

(defn track-text (settings track)
  (let (form (track-form-of settings)
        stages (track-stages track))
    (str (rendered-track settings form stages)
         (track-padding form stages))))

(defn with-first-line (line lines)
  (append-lines! (vec line) lines))

(defn branch-at (lines index)
  (if (= index (dec (len lines)))
    tree-branch/last tree-branch/middle))

(defn manager-text (settings manager)
  (match manager
    (none (styled settings text-style/outcome "no manager"))
    ((some session)
     (str (styled settings text-style/secondary "manager")
          " " session))))

(defn poll-text (settings poll-seconds)
  (styled settings text-style/secondary
          (as-str (str "poll " poll-seconds "s"))))

(defn render-sub-line (settings owner branch line)
  (let (gutter (sub-line-base settings owner))
    (match line
      ((running item)
       (render-running-sub-line settings gutter branch item))
      (_ (render-plain-sub-line settings gutter branch line)))))

(defn render-plain-sub-line (settings gutter branch line)
  (let (values (wrap-value (sub-line-limit settings gutter)
                           (sub-line-value line))
        first-line (sub-line-first settings gutter branch line values))
    (append-wrap-lines settings gutter branch line values 1
                       (vec first-line))))

(defn render-running-sub-line (settings gutter branch item)
  (let (values (wrap-value (sub-line-limit settings gutter)
                           (running-sub-line-value item)))
    (render-running-lines settings gutter branch item values)))

(defn render-running-lines (settings gutter branch item values)
  (loop (index 0
         in-suffix false
         lines (vec))
    (if (>= index (len values))
      lines
      (let (value (as-str (at values index))
            line (running-sub-line-render settings gutter
                                          branch item value
                                          (= index 0)
                                          in-suffix))
        (recur (inc index)
               (or in-suffix (running-suffix-line? value))
               (push-line! lines line))))))

(defn running-sub-line-render (settings gutter branch item
                                        value first?
                                        in-suffix)
  (let (spans (running-line-spans item value first? in-suffix))
    (if first?
      (str (:text gutter)
           (styled settings text-style/secondary (tree-glyph branch))
           (label-cell settings "running")
           (spans-text settings spans))
      (str (continuation-prefix settings gutter branch)
           (spans-text settings spans)))))

(defn running-line-spans (item value first? in-suffix)
  (if in-suffix
    (vec (secondary-span value))
    (running-prefix-line-spans item value first?)))

(defn running-prefix-line-spans (item value first?)
  (match (running-suffix-split value)
    (none (running-prefix-spans item value first?))
    ((some halves)
     (append-spans! (running-prefix-spans item (as-str (:before halves)) first?)
                    (vec (secondary-span (str "·" (:after halves))))))))

(defn running-prefix-spans (item value first?)
  (if first?
    (vec (->text-span :style text-style/bold
                      :text (clone (:id item)))
         (->text-span :style text-style/plain
                      :text (strip-prefix value (as-str (:id item)))))
    (vec (->text-span :style text-style/plain :text (str value)))))

(defn running-suffix-line? (value) (contains? value "·"))

(defn running-suffix-split (value)
  (let (halves (collect (map (split value "·")
                          (fn (part) (str part)))))
    (if (= (len halves) 2)
      (some (->running-split :before (clone (at halves 0))
                             :after (clone (at halves 1))))
      none)))

(defn secondary-span (text)
  (->text-span :style text-style/secondary :text (str text)))

(type spans-text
  (fn ((ref log-settings)
       (iterator (ref text-span)))
    string))

(defn spans-text (settings spans)
  (join (collect (map spans
                   (fn (span)
                     (styled settings
                             (:style span)
                             (as-str (:text span))))))
        ""))

(defn append-spans! (left right)
  (loop (index 0
         spans left)
    (if (>= index (len right))
      spans
      (recur (inc index)
             (push-span! spans (clone (at right index)))))))

(defn push-span! (spans span)
  (do (push! spans span) spans))

(defn rendered-track (settings form stages)
  (match form
    (full (full-track settings stages))
    (glyphs (glyph-track settings stages))))

(type running-description
  (fn ((ref running-item)) string))

(defn running-description (item)
  (str (:id item)
       " "
       (running-status-text (:status item))
       " "
       (:minutes item)
       "m"))

(defn status-style (status)
  (match status
    (building text-style/secondary)
    (researching text-style/secondary)
    (designing text-style/secondary)
    (working text-style/secondary)
    (reviewing text-style/secondary)
    (verifying text-style/secondary)
    (changes text-style/outcome)
    ((fixing _) text-style/secondary)
    (new-head text-style/outcome)
    (abandoned text-style/outcome)
    (merging text-style/secondary)
    ((merged _) text-style/success)
    (reported text-style/secondary)
    (accepted text-style/success)
    (head-moved text-style/bold-failure)
    (timed-out text-style/bold-failure)
    (refused text-style/bold-failure)
    (failed text-style/bold-failure)))

(defn status-text (settings status)
  (match status
    ((merged number)
     (str "merged " (pr-number-text settings number)))
    (_ (status-plain-text status))))

(defn status-plain-text (status)
  (match status
    (building (str "building"))
    (researching (str "researching"))
    (designing (str "designing"))
    (working (str "working"))
    (reviewing (str "reviewing"))
    (verifying (str "verifying"))
    (changes (str "changes"))
    ((fixing round) (str "fixing (" round ")"))
    (new-head (str "new head"))
    (abandoned (str "abandoned"))
    (merging (str "merging"))
    ((merged number) (str "merged #" number))
    (reported (str "reported"))
    (accepted (str "accepted"))
    (head-moved (str "head moved"))
    (timed-out (str "timed out"))
    (refused (str "refused"))
    (failed (str "failed"))))

(defn track-cell-width (form)
  (match form
    (full full-track-width)
    (glyphs glyph-track-width)))

(defn track-form-of (settings)
  (match (:width settings)
    (none track-form/full)
    ((some width) (track-form-of-width width))))

(defn track-form-of-width (width)
  (if (< width narrow-track-threshold)
    track-form/glyphs track-form/full))

(defn track-padding (form stages)
  (let (count (len stages))
    (match form
      (full (spaces (- full-track-width (plain-track-width stages))))
      (glyphs (spaces (- glyph-track-width count))))))

(defn track-stages (track)
  (match track
    ((build-track build review merge)
     (vec (->stage-entry :name (str "build") :state build)
          (->stage-entry :name (str "review") :state review)
          (->stage-entry :name (str "merge") :state merge)))
    ((write-track write accept)
     (vec (->stage-entry :name (str "write") :state write)
          (->stage-entry :name (str "accept") :state accept)))))

(defn append-wrap-lines (settings gutter branch line values index lines)
  (if (>= index (len values))
    lines
    (recur settings gutter branch line values
           (inc index)
           (push-line! lines
                       (sub-line-continuation
                         settings gutter branch line
                         (as-str (at values index)))))))

(type full-track
  (fn ((ref log-settings)
       (iterator (ref stage-entry)))
    string))

(defn full-track (settings stages)
  (join (collect (map stages
                   (fn (entry) (stage-text settings entry))))
        " "))

(type glyph-track
  (fn ((ref log-settings)
       (iterator (ref stage-entry)))
    string))

(defn glyph-track (settings stages)
  (join (collect (map stages
                   (fn (entry)
                     (styled settings
                             (stage-glyph-style (:state entry))
                             (stage-glyph (:state entry))))))
        ""))

(type plain-track-width
  (fn ((ref (vec stage-entry))) int))

(defn plain-track-width (stages)
  (let (count (len stages))
    (+ (sum (map stages plain-stage-width))
       (max 0 (- count 1)))))

(defn sub-line-base (settings owner)
  (->sub-line-gutter :text (str (spaces sub-line-indent-width)
                                (owner-prefix settings owner))
                     :width (+ sub-line-indent-width
                               (owner-plain-width settings owner))))

(defn sub-line-first (settings gutter branch line values)
  (let (value (sub-line-display-value settings line values))
    (str (:text gutter)
         (styled settings text-style/secondary (tree-glyph branch))
         (label-cell settings (as-str (sub-line-label line)))
         (styled settings (sub-line-style line) (as-str value)))))

(defn sub-line-display-value (settings line values)
  (match line
    ((pr summary) (pr-display-value settings summary values))
    (_ (clone (at values 0)))))

(defn pr-display-value (settings summary values)
  (if (= (len values) 1)
    (pr-value settings summary)
    (pr-wrapped-value settings summary (clone (at values 0)))))

(defn pr-wrapped-value (settings summary first-line)
  (let (plain-number (str "#" (:number summary)))
    (if (starts-with? (as-str first-line) (as-str plain-number))
      (str (pr-number-text settings (:number summary))
           (strip-prefix (as-str first-line) (as-str plain-number)))
      (str first-line))))

(defn sub-line-limit (settings gutter)
  (match (:width settings)
    (none none)
    ((some width) (sub-line-limit-at width (:width gutter)))))

(defn sub-line-value (line)
  (match line
    ((error message) (clone message))
    ((exit _ command) (clone command))
    ((pr summary) (pr-plain-value summary))
    ((disarmed command) (clone command))
    ((cleanup command) (clone command))
    ((manager session) (str "message sent to " session))
    ((next step) (clone step))
    ((criterion _ note) (clone note))
    ((criteria text) (clone text))
    ((reviewer text) (clone text))
    ((session text) (clone text))
    ((moved text) (clone text))
    ((running item) (running-sub-line-value item))
    ((rerun command) (clone command))))

(defn label-cell (settings label)
  (str (styled settings text-style/secondary label)
       (spaces (max 0 (- label-column-width (display-width label))))
       " "))

(defn owner-prefix (settings owner)
  (match (:target settings)
    (terminal (str))
    (stream (str (styled settings text-style/secondary owner) "  "))))

(defn owner-plain-width (settings owner)
  (match (:target settings)
    (terminal 0)
    (stream (+ (display-width owner) 2))))

(defn plain-stage-width (entry)
  (+ (display-width (as-str (:name entry)))
     2))

(type pr-number-text
  (fn ((ref log-settings) int) string))

(defn pr-number-text (settings number)
  (match (:remote settings)
    (none (str "#" number))
    ((some remote) (pr-number-link settings remote number))))

(defn pr-number-link (settings remote number)
  (if (= (:colors settings) color-mode/no-color)
    (str "#" number)
    (osc-link (str remote "/pull/" number) (str "#" number))))

(defn osc-link (url text)
  (str "\u{1b}]8;;" url "\u{1b}\\" text "\u{1b}]8;;\u{1b}\\"))

(type pr-value
  (fn ((ref log-settings) (ref pr-summary))
    string))

(defn pr-value (settings summary)
  (match (:head summary)
    (none (str (pr-number-text settings (:number summary))
               "  "
               (:branch summary)))
    ((some head)
     (str (pr-number-text settings (:number summary))
          "  "
          (:branch summary)
          " @ " head))))

(type pr-plain-value
  (fn ((ref pr-summary)) string))

(defn pr-plain-value (summary)
  (match (:head summary)
    (none (str "#" (:number summary) "  " (:branch summary)))
    ((some head)
     (str "#"
          (:number summary)
          "  "
          (:branch summary)
          " @ " head))))

(defn running-sub-line-value (item)
  (str (:id item)
       " "
       (running-status-text (:status item))
       " "
       (:minutes item)
       "m · its session keeps running"))

(defn stage-text (settings entry)
  (str (styled settings
               (stage-name-style (:state entry))
               (:name entry))
       " "
       (styled settings
               (stage-glyph-style (:state entry))
               (stage-glyph (:state entry)))))

(defn sub-line-continuation (settings gutter branch line value)
  (str (continuation-prefix settings gutter branch)
       (styled settings (sub-line-style line) value)))

(defn sub-line-label (line)
  (match line
    ((error _) (str "error"))
    ((exit code _) (str "exit " code))
    ((pr _) (str "pr"))
    ((disarmed _) (str "disarmed"))
    ((cleanup _) (str "cleanup"))
    ((manager _) (str "manager"))
    ((next _) (str "next"))
    ((criterion index _) (str "criterion " index))
    ((criteria _) (str "criteria"))
    ((reviewer _) (str "reviewer"))
    ((session _) (str "session"))
    ((moved _) (str "moved"))
    ((running _) (str "running"))
    ((rerun _) (str "rerun"))))

(defn sub-line-limit-at (width base-width)
  (some (max 1 (- width (+ base-width value-column-offset)))))

(defn tree-glyph (branch)
  (match branch (middle "├─ ") (last "╰─ ")))

(defn continuation-prefix (settings gutter branch)
  (match branch
    (middle (str (:text gutter)
                 (styled settings text-style/secondary "│")
                 (spaces (dec value-column-offset))))
    (last (str (:text gutter) (spaces value-column-offset)))))

(defn running-status-text (status)
  (match status
    (building (str "building"))
    (researching (str "researching"))
    (designing (str "designing"))
    (working (str "working"))
    (reviewing (str "reviewing"))
    (verifying (str "verifying"))
    (changes (str "changes"))
    (fixing (str "fixing"))
    (new-head (str "new head"))
    (abandoned (str "abandoned"))
    (merging (str "merging"))
    (reported (str "reported"))))

(defn stage-glyph (state)
  (match state
    (active "▸")
    (done "✓")
    (waiting "○")
    (sent-back "↺")
    (failed "✗")))

(defn stage-glyph-style (state)
  (match state
    (active text-style/active)
    (done text-style/success)
    (waiting text-style/secondary)
    (sent-back text-style/outcome)
    (failed text-style/failure)))

(defn stage-name-style (state)
  (match state
    (active text-style/bold)
    (done text-style/secondary)
    (waiting text-style/secondary)
    (sent-back text-style/bold)
    (failed text-style/bold)))

(type styled
  (fn ((ref log-settings) text-style (ref str))
    string))

(defn styled (settings style text)
  (colored-span (style-open (:colors settings) style) text))

(defn sub-line-style (line)
  (match line
    ((error _) text-style/failure)
    ((rerun _) text-style/bold)
    (_ text-style/plain)))

(defn colored-span (open text)
  (if (= open (str))
    (str text)
    (str open text "\u{1b}[0m")))
