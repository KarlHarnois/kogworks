(module
  "Merges approved pull requests across controller passes, arming auto-merge without waiting.")

(use controller/failure ->signal-stop-report
                        controller-error disarm-status
                        merge-error)

(use controller/fields field-error->message required-number
                       required-object)

(use controller/json json-error->message json-field
                     json-text parse-json)

(use controller/merge-commands advance-command
                               auto-merge-command
                               fixing-command merge-command
                               merge-mode pr-show-command
                               record-head-command
                               repo-view-command
                               required-checks-command
                               send-command show-command
                               update-branch-command)

(use controller/merge-poll auto-merge-state close-item
                           disarm-and-stop disarm-once
                           head-change-error
                           item-fixing-error merge-state
                           read-resume-state
                           timed-out-error)

(use controller/merge-retry execute-github)

(use controller/merge-target ->merge-settings ->merge-target
                             invalid-item-output
                             merge-approval
                             merge-command-failure
                             merge-event merge-item-status
                             merge-outcome merge-settings
                             merge-target read-merge-target
                             read-merging-items
                             read-watched-items
                             report-event)

(use controller/merge-time merge-timed-out?)

(use controller/process command command-detail execute
                        successful?)

(export ->merge-settings check-merges merge-pass
        merge-settings start-merge stop-merges)

(def clean-status-message
  (str "Pull request is in clean status"))

(defenum arming-failure
  recover
  report)

(defenum state-verdict
  merged
  moved
  waiting
  rearm)

(defstruct merge-pass
  :ids (vec string)
  :checked int
  :merged int
  :acted bool
  :failure (option controller-error))

(defn start-merge (repo config settings item)
  (match (read-merge-target repo item)
    ((err failure) (err failure))
    ((ok target)
     (guard-merge-target repo config settings item target))))

(defn check-merges (repo config settings roadmap)
  (match (read-watched-items repo roadmap)
    ((err failure) (err failure))
    ((ok ids)
     (check-item-ids repo config settings ids
                     (->merge-pass :ids (clone ids)
                                   :checked 0
                                   :merged 0
                                   :acted false
                                   :failure none)))))

(defn stop-merges (repo roadmap signal)
  (match (read-merging-items repo roadmap)
    ((err failure) (err failure))
    ((ok ids) (ok (disarm-reports repo ids signal)))))

(defn check-item-ids (repo config settings ids summary)
  (if (>= (:checked summary) (len ids))
    (finish-check summary)
    (check-next-id repo config settings ids summary)))

(defn check-next-id (repo config settings ids summary)
  (match (check-merging-item repo config settings
                             (at ids (:checked summary)))
    ((ok outcome)
     (check-item-ids repo config settings ids
                     (record-outcome summary outcome)))
    ((err failure)
     (check-item-ids repo config settings ids
                     (record-failure summary failure)))))

(defn finish-check (summary)
  (let (ids (clone (:ids summary)))
    (match (:failure summary)
      ((some failure) (err (clone failure)))
      (none (ok (->merge-pass :ids ids
                              :checked (:checked summary)
                              :merged (:merged summary)
                              :acted (:acted summary)
                              :failure none))))))

(defn record-outcome (summary outcome)
  (match outcome
    (merge-outcome/merged (record-merged summary))
    (merge-outcome/waiting (record-checked summary))
    (_ (record-acted summary))))

(defn record-checked (summary)
  (->merge-pass :ids (clone (:ids summary))
                :checked (inc (:checked summary))
                :merged (:merged summary)
                :acted (:acted summary)
                :failure (clone (:failure summary))))

(defn record-merged (summary)
  (->merge-pass :ids (clone (:ids summary))
                :checked (inc (:checked summary))
                :merged (inc (:merged summary))
                :acted true
                :failure (clone (:failure summary))))

(defn record-acted (summary)
  (->merge-pass :ids (clone (:ids summary))
                :checked (inc (:checked summary))
                :merged (:merged summary)
                :acted true
                :failure (clone (:failure summary))))

(defn record-failure (summary failure)
  (->merge-pass :ids (clone (:ids summary))
                :checked (inc (:checked summary))
                :merged (:merged summary)
                :acted (:acted summary)
                :failure (recorded-failure (:failure summary) failure)))

(defn recorded-failure (recorded failure)
  (match recorded
    (none (some failure))
    ((some _) (clone recorded))))

(defn check-merging-item (repo config settings item)
  (match (read-merge-target repo item)
    ((err failure)
     (disarm-unreadable-item repo settings item failure))
    ((ok target)
     (check-target-status repo config settings item target))))

(defn disarm-unreadable-item (repo settings item failure)
  (match (read-item-pull-request repo settings item)
    ((ok pull-request)
     (disarm-and-stop repo settings item
                      (target-with-pull-request item pull-request)
                      (clone failure)))
    ((err _) (err (clone failure)))))

(defn read-item-pull-request (repo settings item)
  (let (command (pr-show-command item))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (parse-pull-request-number item command (:stdout outcome))
        (err (merge-command-failure item command outcome))))))

(defn target-with-pull-request (item pull-request)
  (->merge-target :id (clone item)
                  :pull-request pull-request
                  :head (str)
                  :item-status merge-item-status/other
                  :approval merge-approval/not-approved
                  :title (str)
                  :kind (str)
                  :branch none))

(defn parse-pull-request-number (item command text)
  (match (parse-json (as-str text))
    ((ok document)
     (map-err (required-pull-request-number document)
       (fn (failure)
         (invalid-item-output item command
                              (field-error->message failure)))))
    ((err failure)
     (err (invalid-item-output item command
                               (json-error->message failure))))))

(defn required-pull-request-number (document)
  (let-try (pull (required-object document "pull_request" "pull_request")
            number (required-number pull "number" "pull_request.number"))
    (ok number)))

(defn check-target-status (repo config settings item target)
  (match (:item-status target)
    (fixing (check-fixing-merge repo settings item target))
    (in-review (check-in-review-merge repo settings item target))
    (_ (check-target-approval repo config settings item target))))

(defn check-fixing-merge (repo settings item target)
  (match (read-resume-state repo settings item target)
    ((err failure)
     (disarm-and-stop repo settings item target failure))
    ((ok state)
     (check-fixing-armed repo settings item target state))))

(defn check-fixing-armed (repo settings item target state)
  (match (:auto-merge state)
    (auto-merge-state/armed (disarm-and-stop repo settings
                                             item target
                                             (item-fixing-error item target)))
    (auto-merge-state/not-armed (ok merge-outcome/waiting))))

(defn check-in-review-merge (repo settings item target)
  (match (read-resume-state repo settings item target)
    ((err failure)
     (disarm-and-stop repo settings item target failure))
    ((ok state)
     (check-in-review-armed repo settings item target state))))

(defn check-in-review-armed (repo settings item target state)
  (match (:auto-merge state)
    (auto-merge-state/armed
      (check-in-review-moved repo settings item target state))
    (auto-merge-state/not-armed (ok merge-outcome/waiting))))

(type check-in-review-moved
  (fn ((ref str)
       (ref merge-settings)
       (ref string)
       (ref merge-target)
       (ref merge-state))
    (result merge-outcome controller-error)))

(defn check-in-review-moved (repo settings item target state)
  (if (= (:head state) (:head target))
    (ok merge-outcome/waiting)
    (disarm-and-stop repo settings item target
                     (head-change-error item target state))))

(defn check-target-approval (repo config settings item target)
  (match (:approval target)
    (not-approved (disarm-and-stop repo settings item target
                                   (not-approved-error item target)))
    (approved (check-target-state repo config settings item target))))

(defn check-target-state (repo config settings item target)
  (match (read-resume-state repo settings item target)
    ((err failure)
     (disarm-and-stop repo settings item target failure))
    ((ok state)
     (check-state-verdict repo config settings item target state))))

(defn check-state-verdict (repo config settings item target state)
  (match (state-verdict-of target state)
    (merged (close-item repo settings item target))
    (moved (disarm-and-stop repo settings item target
                            (head-change-error item target state)))
    (waiting (check-state-timeout repo config settings item
                                  target
                                  state-verdict/waiting))
    (rearm (check-state-timeout repo config settings item
                                target
                                state-verdict/rearm))))

(defn check-state-timeout (repo config settings item target verdict)
  (match (merge-timed-out? repo settings item)
    ((err failure)
     (disarm-and-stop repo settings item target failure))
    ((ok true)
     (disarm-and-stop repo settings item target
                      (timed-out-error item target settings)))
    ((ok false)
     (apply-state-verdict repo config settings item target
                          verdict))))

(defn apply-state-verdict (repo config settings item target verdict)
  (match verdict
    (state-verdict/waiting (ok merge-outcome/waiting))
    (state-verdict/rearm (enable-auto-merge repo config settings item target))
    (_ (ok merge-outcome/waiting))))

(type state-verdict-of
  (fn ((ref merge-target) (ref merge-state))
    state-verdict))

(defn state-verdict-of (target state)
  (if (= (:head state) (:head target))
    (state-of-merge (:state state) (:auto-merge state))
    state-verdict/moved))

(defn state-of-merge (state auto-merge)
  (if (= (as-str state) (str "MERGED"))
    state-verdict/merged
    (auto-merge-verdict auto-merge)))

(defn auto-merge-verdict (auto-merge)
  (match auto-merge
    (armed state-verdict/waiting)
    (not-armed state-verdict/rearm)))

(defn guard-merge-target (repo config settings item target)
  (match (:item-status target)
    (fixing (disarm-and-stop repo settings item target
                             (item-fixing-error item target)))
    (_ (guard-approval repo config settings item target))))

(defn guard-approval (repo config settings item target)
  (match (:approval target)
    (approved (prepare-merge repo config settings item target))
    (not-approved (disarm-and-stop repo settings item target
                                   (not-approved-error item target)))))

(defn prepare-merge (repo config settings item target)
  (match (:item-status target)
    (merging (ok merge-outcome/waiting))
    (_ (first-merge repo config settings item target))))

(defn first-merge (repo config settings item target)
  (match (preflight repo settings item)
    ((err failure) (err failure))
    ((ok _)
     (advance-and-enable repo config settings item target))))

(defn preflight (repo settings item)
  (match (repo-slug repo settings item)
    ((err failure) (err failure))
    ((ok slug) (check-settings repo settings item slug))))

(defn repo-slug (repo settings item)
  (let (command (repo-view-command))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (slug-from-text item (trim (:stdout outcome)))
        (err (merge-command-failure item command outcome))))))

(defn slug-from-text (item text)
  (if (empty? text)
    (err (settings-refused-error (clone item)
                                 (str "the repository slug is empty")))
    (ok (str text))))

(defn check-settings (repo settings item slug)
  (match (auto-merge-enabled repo settings item slug)
    ((err failure) (err failure))
    ((ok _) (required-status-checked repo settings item slug))))

(defn auto-merge-enabled (repo settings item slug)
  (let (command (auto-merge-command slug))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (checked-auto-merge item command (trim (:stdout outcome)))
        (err (merge-command-failure item command outcome))))))

(type checked-auto-merge
  (fn ((ref string) (ref command) (ref str))
    (result unit controller-error)))

(defn checked-auto-merge (item command text)
  (if (= text (str "true"))
    (ok (do))
    (err (settings-refused-error (clone item)
                                 (str "`"
                                      (:label command)
                                      "` printed `" text
                                      "`, not `true`")))))

(defn required-status-checked (repo settings item slug)
  (let (command (required-checks-command slug))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (checked-required-count item command
                                (trim (:stdout outcome)))
        (err (merge-command-failure item command outcome))))))

(defn checked-required-count (item command text)
  (match (the (result int parse-int-error) (parse text))
    ((ok count) (positive-required-count item command count))
    ((err _)
     (err (settings-refused-error (clone item)
                                  (str "`"
                                       (:label command)
                                       "` printed `" text
                                       "`, not a count"))))))

(defn positive-required-count (item command count)
  (if (> count 0)
    (ok (do))
    (err (settings-refused-error (clone item)
                                 (str "`"
                                      (:label command)
                                      "` reports no required status check")))))

(defn advance-and-enable (repo config settings item target)
  (match (advance-item repo item)
    ((err failure) (err failure))
    ((ok _)
     (do
       (report-event settings merge-event/merging target)
       (enable-auto-merge repo config settings item target)))))

(defn advance-item (repo item)
  (let (command (advance-command item))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (ok (do))
        (err (merge-command-failure item command outcome))))))

(defn enable-auto-merge (repo config settings item target)
  (arm-auto-merge repo config settings item target
                  (merge-command (:merge config) merge-mode/auto target)
                  arming-failure/recover))

(defn arm-auto-merge (repo config settings item target command recovery)
  (let (outcome (execute-github repo command
                                (:retry-delay-seconds settings)))
    (armed-result repo config settings item target command
                  outcome recovery)))

(defn armed-result (repo config settings item target command outcome recovery)
  (if (successful? outcome)
    (ok merge-outcome/armed)
    (failed-arming repo config settings item target command
                   outcome recovery)))

(defn failed-arming (repo config settings item target command outcome recovery)
  (match recovery
    (recover (handle-merge-failure repo config settings item
                                   target command outcome))
    (report (err (merge-command-failure item command outcome)))))

(defn handle-merge-failure (repo config settings item target command outcome)
  (if (clean-status-refusal? outcome)
    (merge-directly repo config settings item target)
    (handle-other-merge-failure repo config settings item
                                target command outcome)))

(defn handle-other-merge-failure (repo config settings item
                                       target command
                                       outcome)
  (if (merge-conflict? outcome)
    (update-branch-after-conflict repo config settings item
                                  target)
    (err (merge-command-failure item command outcome))))

(defn merge-conflict? (outcome)
  (or (contains? (lower-case (as-str (:stderr outcome)))
                 "merge conflict")
      (contains? (lower-case (as-str (:stdout outcome)))
                 "merge conflict")))

(defn update-branch-after-conflict (repo config settings item target)
  (let (command (update-branch-command (:pull-request target))
        outcome (execute-github repo command
                                (:retry-delay-seconds settings)))
    (if (successful? outcome)
      (resume-after-update repo config settings item target)
      (rebase-fallback repo item target outcome))))

(defn resume-after-update (repo config settings item target)
  (match (read-resume-state repo settings item target)
    ((err failure) (err failure))
    ((ok state)
     (resume-at-head repo config settings item target
                     (clone (:head state))))))

(defn resume-at-head (repo config settings item target head)
  (let (current (clone (:head target)))
    (if (= head current)
      (retry-enable-auto-merge repo config
                               (clone settings)
                               item target)
      (record-head repo item head))))

(defn record-head (repo item head)
  (let (command (record-head-command item head)
        outcome (execute repo command))
    (if (successful? outcome)
      (ok merge-outcome/handed-back)
      (err (merge-command-failure item command outcome)))))

(defn retry-enable-auto-merge (repo config settings item target)
  (arm-auto-merge repo config settings item target
                  (merge-command (:merge config) merge-mode/auto target)
                  arming-failure/report))

(defn rebase-fallback (repo item target outcome)
  (match (advance-to-fixing repo item)
    ((err failure) (err failure))
    ((ok _) (send-rebase-fix repo item target outcome))))

(defn advance-to-fixing (repo item)
  (let (command (fixing-command item)
        outcome (execute repo command))
    (if (successful? outcome)
      (ok (do))
      (err (merge-command-failure item command outcome)))))

(defn send-rebase-fix (repo item target outcome)
  (let-try (worker (read-worker repo item))
    (send-rebase-with-worker repo item target worker outcome)))

(defn read-worker (repo item)
  (let (command (show-command item)
        outcome (execute repo command))
    (if (successful? outcome)
      (parse-worker item command (:stdout outcome))
      (err (merge-command-failure item command outcome)))))

(defn parse-worker (item command text)
  (match (parse-json (as-str text))
    ((ok document) (ok (optional-worker document)))
    ((err failure)
     (err (invalid-item-output item command
                               (json-error->message failure))))))

(defn optional-worker (document)
  (match (json-field document "item")
    (none none)
    ((some item) (worker-from-item item))))

(defn worker-from-item (item)
  (match (json-field item "session")
    (none none)
    ((some session) (worker-from-session session))))

(defn worker-from-session (session)
  (match (json-field session "name")
    (none none)
    ((some name) (json-text name))))

(defn send-rebase-with-worker (repo item target worker outcome)
  (match worker
    (none (err (settings-refused-error (clone item)
                                       (str "the item has no worker session to rebase"))))
    ((some name)
     (send-rebase-message repo item target name outcome))))

(defn send-rebase-message (repo item target worker outcome)
  (let (command (send-command worker (rebase-message item target outcome))
        outcome (execute repo command))
    (if (successful? outcome)
      (ok merge-outcome/handed-back)
      (err (merge-command-failure item command outcome)))))

(defn rebase-message (item target outcome)
  (let (detail (command-detail outcome)
        suffix (if (empty? detail)
                 (str)
                 (str ": " detail)))
    (str "rebase: " item ": PR "
         (:pull-request target)
         " has merge conflicts and `gh pr update-branch "
         (:pull-request target)
         "` exited "
         (:code outcome)
         suffix
         ". Rebase the pull request branch on main, push it, and record"
         " a fixed report with the new head. A fresh review is needed"
         " at the new head.")))

(defn merge-directly (repo config settings item target)
  (let (command (merge-command (:merge config) merge-mode/direct target))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (close-item repo settings item target)
        (err (merge-command-failure item command outcome))))))

(defn clean-status-refusal? (outcome)
  (contains? (:stderr outcome) (as-str clean-status-message)))

(defn settings-refused-error (item detail)
  (controller-error/merge-failed (merge-error/settings-refused item detail)))

(defn not-approved-error (item target)
  (controller-error/merge-failed (merge-error/not-approved
                                   (clone item)
                                   (clone (:pull-request target))
                                   (clone (:head target)))))

(defn disarm-reports (repo ids signal)
  (loop (index 0
         reports (vec))
    (if (>= index (len ids))
      reports
      (recur (inc index)
             (push-report! reports
                           (disarm-report repo (at ids index) signal))))))

(defn push-report! (reports report)
  (do (push! reports report) reports))

(defn disarm-report (repo item signal)
  (match (read-merge-target repo item)
    ((err _) (unreadable-report item signal))
    ((ok target)
     (->signal-stop-report :item (clone item)
                           :pull-request-number (clone (:pull-request target))
                           :signal signal
                           :disarm (disarm-once repo (:pull-request target))))))

(defn unreadable-report (item signal)
  (->signal-stop-report :item (clone item)
                        :pull-request-number (str "-")
                        :signal signal
                        :disarm (disarm-status/not-disarmed 0
                                                            (str "the item could not be read"))))
