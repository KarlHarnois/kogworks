(module
  "Merges an approved pull request through GitHub auto-merge and closes its item.")

(use controller/failure ->action-failure controller-error
                        merge-error)

(use controller/fields field-error->message required-number
                       required-object required-text)

(use controller/json json-error->message parse-json)

(use controller/merge-commands advance-command
                               auto-merge-command
                               close-command merge-command
                               merge-mode repo-view-command
                               required-checks-command
                               show-command view-command)

(use controller/merge-retry execute-github)
(use controller/merge-target ->merge-target)

(use controller/process command command-detail execute
                        successful?)

(export ->merge-settings merge-settings start-merge)

(def clean-status-message
  (str "Pull request is in clean status"))

(defstruct merge-settings
  :poll-seconds int
  :retry-delay-seconds int
  :timeout-seconds int)

(defstruct merge-state
  :state string
  :head string)

(defenum poll-verdict
  merged
  moved
  waiting)

(defn start-merge (repo config settings item)
  (match (read-merge-target repo item)
    ((err failure) (err failure))
    ((ok target)
     (prepare-merge repo config settings item target))))

(defn read-merge-target (repo item)
  (let (command (show-command item))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (parse-merge-target item command (:stdout outcome))
        (err (merge-command-failure item command outcome))))))

(defn parse-merge-target (item command text)
  (match (parse-json (as-str text))
    ((ok document) (target-from-json item command document))
    ((err failure)
     (err (invalid-item-output item command
                               (json-error->message failure))))))

(defn target-from-json (item command document)
  (match (required-object document "pull_request" "pull_request")
    ((err failure)
     (err (invalid-item-output item command
                               (field-error->message failure))))
    ((ok pull) (target-from-pull item command pull))))

(defn target-from-pull (item command pull)
  (match (required-number pull "number" "pull_request.number")
    ((err failure)
     (err (invalid-item-output item command
                               (field-error->message failure))))
    ((ok pr) (target-from-pull-approval item command pull pr))))

(defn target-from-pull-approval (item command pull pr)
  (match (required-object pull "approval" "pull_request.approval")
    ((err failure)
     (err (invalid-item-output item command
                               (field-error->message failure))))
    ((ok approval)
     (target-from-approval item command approval pr))))

(defn target-from-approval (item command approval pr)
  (match (required-text approval "head" "pull_request.approval.head")
    ((err failure)
     (err (invalid-item-output item command
                               (field-error->message failure))))
    ((ok head)
     (ok (->merge-target :pull-request (clone pr) :head head)))))

(defn prepare-merge (repo config settings item target)
  (match (preflight repo settings item)
    ((err failure) (err failure))
    ((ok _)
     (advance-and-enable repo config settings item target))))

(defn preflight (repo settings item)
  (match (repo-slug repo settings item)
    ((err failure) (err failure))
    ((ok slug) (check-settings repo settings item slug))))

(defn repo-slug (repo settings item)
  (let (command (repo-view-command))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (slug-from-text item (trim (:stdout outcome)))
        (err (merge-command-failure item command outcome))))))

(defn slug-from-text (item text)
  (if (empty? text)
    (err (settings-refused-error (clone item)
                                 (str "the repository slug is empty")))
    (ok (str text))))

(defn check-settings (repo settings item slug)
  (match (auto-merge-enabled repo settings item slug)
    ((err failure) (err failure))
    ((ok _) (required-status-checked repo settings item slug))))

(defn auto-merge-enabled (repo settings item slug)
  (let (command (auto-merge-command slug))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (checked-auto-merge item command (trim (:stdout outcome)))
        (err (merge-command-failure item command outcome))))))

(type checked-auto-merge
  (fn ((ref string) (ref command) (ref str))
    (result unit controller-error)))

(defn checked-auto-merge (item command text)
  (if (= text (str "true"))
    (ok (do))
    (err (settings-refused-error (clone item)
                                 (str "`"
                                      (:label command)
                                      "` printed `" text
                                      "`, not `true`")))))

(defn required-status-checked (repo settings item slug)
  (let (command (required-checks-command slug))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (checked-required-count item command
                                (trim (:stdout outcome)))
        (err (merge-command-failure item command outcome))))))

(defn checked-required-count (item command text)
  (match (the (result int parse-int-error) (parse text))
    ((ok count) (positive-required-count item command count))
    ((err _)
     (err (settings-refused-error (clone item)
                                  (str "`"
                                       (:label command)
                                       "` printed `" text
                                       "`, not a count"))))))

(defn positive-required-count (item command count)
  (if (> count 0)
    (ok (do))
    (err (settings-refused-error (clone item)
                                 (str "`"
                                      (:label command)
                                      "` reports no required status check")))))

(defn advance-and-enable (repo config settings item target)
  (match (advance-item repo item)
    ((err failure) (err failure))
    ((ok _)
     (enable-auto-merge repo config settings item target))))

(defn advance-item (repo item)
  (let (command (advance-command item))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (ok (do))
        (err (merge-command-failure item command outcome))))))

(defn enable-auto-merge (repo config settings item target)
  (let (command (merge-command (:merge config) merge-mode/auto target))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (poll-merge repo item target settings)
        (handle-merge-failure repo config settings item
                              target command outcome)))))

(defn handle-merge-failure (repo config settings item target command outcome)
  (if (clean-status-refusal? outcome)
    (merge-directly repo config settings item target)
    (err (merge-command-failure item command outcome))))

(defn merge-directly (repo config settings item target)
  (let (command (merge-command (:merge config) merge-mode/direct target))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (poll-merge repo item target settings)
        (err (merge-command-failure item command outcome))))))

(defn clean-status-refusal? (outcome)
  (contains? (:stderr outcome) (as-str clean-status-message)))

(defn poll-merge (repo item target settings)
  (let (start (now))
    (poll-iteration repo item target settings start)))

(defn poll-iteration (repo item target settings start)
  (match (read-poll-state repo settings item target)
    ((err failure) (err failure))
    ((ok state)
     (handle-poll repo item target settings start state))))

(defn read-poll-state (repo settings item target)
  (let (command (view-command (:pull-request target)))
    (let (outcome (execute-github repo command
                                  (:retry-delay-seconds settings)))
      (if (successful? outcome)
        (parse-poll-state item command (:stdout outcome))
        (err (merge-command-failure item command outcome))))))

(defn parse-poll-state (item command text)
  (match (parse-json (as-str text))
    ((ok document) (state-from-json item command document))
    ((err failure)
     (err (invalid-poll-output item command
                               (json-error->message failure))))))

(defn state-from-json (item command document)
  (match (required-text document "state" "state")
    ((err failure)
     (err (invalid-poll-output item command
                               (field-error->message failure))))
    ((ok state)
     (poll-head-from-json item command document state))))

(defn poll-head-from-json (item command document state)
  (match (required-text document "headRefOid" "headRefOid")
    ((err failure)
     (err (invalid-poll-output item command
                               (field-error->message failure))))
    ((ok head)
     (ok (->merge-state :state (clone state) :head head)))))

(defn handle-poll (repo item target settings start state)
  (match (poll-verdict-of target state)
    (merged (close-item repo item))
    (moved (err (head-change-error item target state)))
    (waiting (retry-poll repo item target settings start))))

(defn poll-verdict-of (target state)
  (if (= (:head state) (:head target))
    (merged-verdict (:state state))
    poll-verdict/moved))

(defn merged-verdict (state)
  (if (= (as-str state) (str "MERGED"))
    poll-verdict/merged poll-verdict/waiting))

(defn settings-refused-error (item detail)
  (controller-error/merge-failed (merge-error/settings-refused item detail)))

(defn head-change-error (item target state)
  (controller-error/merge-failed (merge-error/head-changed
                                   (clone item)
                                   (clone (:pull-request target))
                                   (clone (:head target))
                                   (clone (:head state)))))

(defn retry-poll (repo item target settings start)
  (if (elapsed? settings start)
    (err (controller-error/merge-failed (merge-error/timed-out
                                          (clone item)
                                          (clone (:pull-request target))
                                          (:timeout-seconds settings))))
    (do
      (sleep (seconds (:poll-seconds settings)))
      (poll-iteration repo item target settings start))))

(defn elapsed? (settings start)
  (>= (elapsed start)
      (seconds (:timeout-seconds settings))))

(defn close-item (repo item)
  (let (command (close-command item))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (ok (do))
        (err (merge-command-failure item command outcome))))))

(type invalid-item-output
  (fn ((ref string) (ref command) string)
    controller-error))

(defn invalid-item-output (item command reason)
  (invalid-output item command
                  (str "invalid item JSON")
                  reason))

(type invalid-poll-output
  (fn ((ref string) (ref command) string)
    controller-error))

(defn invalid-poll-output (item command reason)
  (invalid-output item command
                  (str "invalid poll JSON")
                  reason))

(defn invalid-output (item command description reason)
  (controller-error/command-failed (->action-failure
                                     :action (str "merge")
                                     :item (clone item)
                                     :command (clone (:label command))
                                     :code 0
                                     :detail (str description ": " reason))))

(defn merge-command-failure (item command outcome)
  (controller-error/command-failed (->action-failure
                                     :action (str "merge")
                                     :item (clone item)
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))
