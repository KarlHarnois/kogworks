(module
  "Renders the controller log lines that docs/controller-log.md specifies.")

(use controller/log-palette color-mode style-open
                            text-style)

(use controller/log-width append-lines display-width
                          fitted-title push-line! spaces
                          wrap-value)

(export ->alive-line ->banner-line ->controller-failure
        ->item-line ->log-settings ->pr-summary
        ->running-item ->stop-line alive-line banner-line
        color-mode controller-failure display-width
        item-line log-settings log-status output-target
        pr-summary render-alive render-banner
        render-controller-failure render-item render-stop
        render-sub-lines running-item running-status
        stage-state stop-line sub-line text-style track)

(defstruct alive-line
  :time string
  :running (vec running-item)
  :merged int
  :accepted int)

(defstruct banner-line
  :time string
  :roadmap string
  :manager (option string)
  :poll-seconds int)

(defstruct controller-failure
  :time string
  :status string
  :sub-lines (vec sub-line))

(defstruct item-line
  :time string
  :id string
  :track track
  :status log-status
  :title string
  :sub-lines (vec sub-line))

(defstruct log-settings
  :colors color-mode
  :width (option int)
  :target output-target)

(defstruct pr-summary
  :number int
  :branch string
  :head (option string))

(defstruct running-item
  :id string
  :status running-status
  :minutes int)

(defstruct stage-entry
  :name string
  :state stage-state)

(defstruct stop-line
  :time string
  :merged int
  :accepted int
  :failed int
  :running (vec running-item)
  :rerun string)

(defenum log-status
  building
  researching
  designing
  working
  reviewing
  verifying
  changes
  (fixing int)
  new-head
  abandoned
  merging
  (merged int)
  reported
  accepted
  head-moved
  timed-out
  refused
  failed)

(defenum output-target
  terminal
  stream)

(defenum running-status
  building
  researching
  designing
  working
  reviewing
  verifying
  changes
  fixing
  new-head
  abandoned
  merging
  reported)

(defenum stage-state
  active
  done
  waiting
  sent-back
  failed)

(defenum sub-line
  (error string)
  (exit int string)
  (pr pr-summary)
  (disarmed string)
  (cleanup string)
  (manager string)
  (next string)
  (criterion int string)
  (criteria string)
  (reviewer string)
  (session string)
  (moved string)
  (running running-item)
  (rerun string))

(defenum track
  (build-track stage-state stage-state stage-state)
  (write-track stage-state stage-state))

(defenum track-form
  full
  glyphs)

(defenum tree-branch
  middle
  last)

(defn render-alive (settings alive)
  (let (full (full-alive-text alive))
    (if (alive-full? settings alive full)
      (vec (styled settings text-style/secondary (as-str full)))
      (vec (styled settings text-style/secondary
                   (as-str (counts-alive-text alive)))))))

(defn render-banner (settings banner)
  (vec (banner-text settings banner)))

(defn render-controller-failure (settings failure)
  (let (line (str (:time failure) "  controller  " (:status failure)))
    (with-first-line line
                     (render-sub-lines settings
                                       (str "controller")
                                       (:sub-lines failure)))))

(defn render-item (settings item)
  (let (form (track-form-of settings)
        prefix-width (item-prefix-width item form)
        line (str (:time item)
                  "  "
                  (:id item)
                  "  "
                  (track-text settings (clone (:track item)))
                  "  "
                  (status-cell settings (:status item))
                  "  "
                  (fitted-title (:width settings) prefix-width (:title item)))
        sub-lines (render-sub-lines settings (:id item) (:sub-lines item)))
    (with-first-line line sub-lines)))

(defn render-stop (settings stop)
  (let (line (stop-text stop))
    (with-first-line line
                     (render-sub-lines settings
                                       (str "controller")
                                       (stop-sub-lines stop)))))

(defn render-sub-lines (settings owner sub-lines)
  (loop (index 0
         lines (vec))
    (if (>= index (len sub-lines))
      lines
      (recur (inc index)
             (append-lines lines
                           (render-sub-line settings owner
                                            (branch-at sub-lines index)
                                            (at sub-lines index)))))))

(defn alive-full? (settings alive text)
  (if (empty? (:running alive))
    false
    (alive-fits? settings text)))

(defn alive-fits? (settings text)
  (match (:width settings)
    (none true)
    ((some width) (<= (display-width (as-str text)) width))))

(type banner-text
  (fn (log-settings (ref banner-line)) string))

(defn banner-text (settings banner)
  (str (:time banner)
       "  ● kogworks  roadmap "
       (:roadmap banner)
       " · "
       (manager-text settings (:manager banner))
       " · poll "
       (:poll-seconds banner)
       "s"))

(defn counts-alive-text (alive)
  (str (:time alive)
       "  · "
       (len (:running alive))
       " running · "
       (:merged alive)
       " merged · "
       (:accepted alive)
       " accepted"))

(defn full-alive-text (alive)
  (str (:time alive)
       "  · running "
       (join (collect (map (:running alive) running-description))
             ", ")
       " · "
       (:merged alive)
       " merged"))

(defn item-prefix-width (item form)
  (let (status-width (max 11
                          (display-width (as-str (status-text (:status
                                                                item))))))
    (+ (display-width (as-str (:time item)))
       2
       (display-width (as-str (:id item)))
       2
       (track-cell-width form)
       2 status-width 2)))

(defn status-cell (settings status)
  (let (text (status-text status))
    (str (styled settings (status-style status) (as-str text))
         (spaces (max 0
                      (- 11 (display-width (as-str text))))))))

(defn stop-sub-lines (stop)
  (loop (index 0
         lines (vec))
    (if (>= index (len (:running stop)))
      (push-line! lines
                  (sub-line/rerun (clone (:rerun stop))))
      (recur (inc index)
             (push-line! lines
                         (sub-line/running (clone (at (:running stop)
                                                      index))))))))

(defn stop-text (stop)
  (str (:time stop)
       "  ■ controller stopped  "
       (:merged stop)
       " merged · "
       (:accepted stop)
       " accepted · "
       (:failed stop)
       " failed · "
       (len (:running stop))
       " running"))

(defn track-text (settings track)
  (let (form (track-form-of settings)
        stages (track-stages track))
    (str (rendered-track settings form stages)
         (track-padding form stages))))

(defn with-first-line (line lines)
  (append-lines (vec line) lines))

(defn branch-at (lines index)
  (if (= index (dec (len lines)))
    tree-branch/last tree-branch/middle))

(defn manager-text (settings manager)
  (match manager
    (none (styled settings text-style/outcome "no manager"))
    ((some session) (str "manager " session))))

(defn render-sub-line (settings owner branch line)
  (let (base (sub-line-base settings owner)
        values (wrap-value (sub-line-limit settings (as-str base))
                           (sub-line-value line))
        first-line (sub-line-first settings base branch line
                                   (as-str (at values 0))))
    (append-wrap-lines settings base branch line values 1
                       (vec first-line))))

(defn rendered-track (settings form stages)
  (match form
    (full (full-track settings stages))
    (glyphs (glyph-track settings stages))))

(type running-description
  (fn ((ref running-item)) string))

(defn running-description (item)
  (str (:id item)
       " "
       (running-status-text (:status item))
       " "
       (:minutes item)
       "m"))

(defn status-style (status)
  (match status
    (building text-style/secondary)
    (researching text-style/secondary)
    (designing text-style/secondary)
    (working text-style/secondary)
    (reviewing text-style/plain)
    (verifying text-style/plain)
    (changes text-style/outcome)
    ((fixing _) text-style/secondary)
    (new-head text-style/outcome)
    (abandoned text-style/outcome)
    (merging text-style/plain)
    ((merged _) text-style/success)
    (reported text-style/plain)
    (accepted text-style/success)
    (head-moved text-style/bold-failure)
    (timed-out text-style/bold-failure)
    (refused text-style/bold-failure)
    (failed text-style/bold-failure)))

(defn status-text (status)
  (match status
    (building (str "building"))
    (researching (str "researching"))
    (designing (str "designing"))
    (working (str "working"))
    (reviewing (str "reviewing"))
    (verifying (str "verifying"))
    (changes (str "changes"))
    ((fixing round) (str "fixing (" round ")"))
    (new-head (str "new head"))
    (abandoned (str "abandoned"))
    (merging (str "merging"))
    ((merged number) (str "merged #" number))
    (reported (str "reported"))
    (accepted (str "accepted"))
    (head-moved (str "head moved"))
    (timed-out (str "timed out"))
    (refused (str "refused"))
    (failed (str "failed"))))

(defn track-cell-width (form)
  (match form (full 24) (glyphs 3)))

(defn track-form-of (settings)
  (match (:width settings)
    (none track-form/full)
    ((some width) (track-form-of-width width))))

(defn track-form-of-width (width)
  (if (< width 110) track-form/glyphs track-form/full))

(defn track-padding (form stages)
  (let (count (len stages))
    (match form
      (full (spaces (- 24 (plain-track-width stages))))
      (glyphs (spaces (- 3 count))))))

(defn track-stages (track)
  (match track
    ((build-track build review merge)
     (vec (->stage-entry :name (str "build") :state build)
          (->stage-entry :name (str "review") :state review)
          (->stage-entry :name (str "merge") :state merge)))
    ((write-track write accept)
     (vec (->stage-entry :name (str "write") :state write)
          (->stage-entry :name (str "accept") :state accept)))))

(defn append-wrap-lines (settings base branch line values index lines)
  (if (>= index (len values))
    lines
    (recur settings base branch line values
           (inc index)
           (push-line! lines
                       (sub-line-continuation settings base
                                              branch line
                                              (as-str (at values index)))))))

(type full-track
  (fn ((ref log-settings)
       (iterator (ref stage-entry)))
    string))

(defn full-track (settings stages)
  (join (collect (map stages
                   (fn (entry) (stage-text settings entry))))
        " "))

(type glyph-track
  (fn ((ref log-settings)
       (iterator (ref stage-entry)))
    string))

(defn glyph-track (settings stages)
  (join (collect (map stages
                   (fn (entry)
                     (styled settings
                             (stage-glyph-style (:state entry))
                             (stage-glyph (:state entry))))))
        ""))

(type plain-track-width
  (fn ((ref (vec stage-entry))) int))

(defn plain-track-width (stages)
  (let (count (len stages))
    (+ (sum (map stages plain-stage-width))
       (max 0 (- count 1)))))

(defn sub-line-base (settings owner)
  (str "          " (owner-prefix settings owner)))

(defn sub-line-first (settings base branch line value)
  (str base
       (tree-glyph branch)
       (label-cell settings (as-str (sub-line-label line)))
       (styled settings (sub-line-style line) value)))

(defn sub-line-limit (settings base)
  (match (:width settings)
    (none none)
    ((some width) (sub-line-limit-at width base))))

(defn sub-line-value (line)
  (match line
    ((error message) (clone message))
    ((exit _ command) (clone command))
    ((pr summary) (pr-value summary))
    ((disarmed command) (clone command))
    ((cleanup command) (clone command))
    ((manager session) (str "message sent to " session))
    ((next step) (clone step))
    ((criterion _ note) (clone note))
    ((criteria text) (clone text))
    ((reviewer text) (clone text))
    ((session text) (clone text))
    ((moved text) (clone text))
    ((running item) (running-sub-line-value item))
    ((rerun command) (clone command))))

(defn label-cell (settings label)
  (str (styled settings text-style/secondary label)
       (spaces (max 0 (- 12 (display-width label))))
       " "))

(defn owner-prefix (settings owner)
  (match (:target settings)
    (terminal (str))
    (stream (str owner "  "))))

(defn plain-stage-width (entry)
  (+ (display-width (as-str (:name entry)))
     2))

(type pr-value
  (fn ((ref pr-summary)) string))

(defn pr-value (summary)
  (match (:head summary)
    (none (str "#" (:number summary) "  " (:branch summary)))
    ((some head)
     (str "#"
          (:number summary)
          "  "
          (:branch summary)
          " @ " head))))

(defn running-sub-line-value (item)
  (str (:id item)
       " "
       (running-status-text (:status item))
       " "
       (:minutes item)
       "m · its session keeps running"))

(defn stage-text (settings entry)
  (str (styled settings
               (stage-name-style (:state entry))
               (:name entry))
       " "
       (styled settings
               (stage-glyph-style (:state entry))
               (stage-glyph (:state entry)))))

(defn sub-line-continuation (settings base branch line value)
  (str (continuation-prefix (as-str base) branch)
       (styled settings (sub-line-style line) value)))

(defn sub-line-label (line)
  (match line
    ((error _) (str "error"))
    ((exit code _) (str "exit " code))
    ((pr _) (str "pr"))
    ((disarmed _) (str "disarmed"))
    ((cleanup _) (str "cleanup"))
    ((manager _) (str "manager"))
    ((next _) (str "next"))
    ((criterion index _) (str "criterion " index))
    ((criteria _) (str "criteria"))
    ((reviewer _) (str "reviewer"))
    ((session _) (str "session"))
    ((moved _) (str "moved"))
    ((running _) (str "running"))
    ((rerun _) (str "rerun"))))

(defn sub-line-limit-at (width base)
  (some (max 1
             (- width (+ (display-width base) 16)))))

(defn tree-glyph (branch)
  (match branch (middle "├─ ") (last "╰─ ")))

(defn continuation-prefix (base branch)
  (str base
       (continuation-marker branch)
       (spaces (- (+ (display-width base) 16)
                  (display-width base)
                  1))))

(defn running-status-text (status)
  (match status
    (building (str "building"))
    (researching (str "researching"))
    (designing (str "designing"))
    (working (str "working"))
    (reviewing (str "reviewing"))
    (verifying (str "verifying"))
    (changes (str "changes"))
    (fixing (str "fixing"))
    (new-head (str "new head"))
    (abandoned (str "abandoned"))
    (merging (str "merging"))
    (reported (str "reported"))))

(defn stage-glyph (state)
  (match state
    (active "▸")
    (done "✓")
    (waiting "○")
    (sent-back "↺")
    (failed "✗")))

(defn stage-glyph-style (state)
  (match state
    (active text-style/active)
    (done text-style/success)
    (waiting text-style/secondary)
    (sent-back text-style/outcome)
    (failed text-style/failure)))

(defn stage-name-style (state)
  (match state
    (active text-style/bold)
    (done text-style/secondary)
    (waiting text-style/secondary)
    (sent-back text-style/bold)
    (failed text-style/bold)))

(type styled
  (fn ((ref log-settings) text-style (ref str))
    string))

(defn styled (settings style text)
  (match (:colors settings)
    (no-color (str text))
    (_ (colored-span (style-open (:colors settings) style) text))))

(defn sub-line-style (line)
  (match line
    ((error _) text-style/failure)
    ((rerun _) text-style/bold)
    (_ text-style/plain)))

(defn colored-span (open text)
  (if (= open (str))
    (str text)
    (str open text "\u{1b}[0m")))

(defn continuation-marker (branch)
  (match branch (middle "│") (last " ")))
