(module
  "Runs the controller loop.")

(use knave-commandant switch-state)
(use controller/dispatch dispatch)

(use controller/failure ->action-failure ->failure-report
                        controller-error error->message
                        failure-report)

(use controller/factory factory-config read-factory
                        read-manager)

(use controller/json json json-error->message parse-json)

(use controller/merge ->merge-settings merge-settings
                      start-merge)

(use controller/process ->command canonical-path command
                        command-detail execute outcome
                        successful?)

(use controller/review review-mode start-review)

(use controller/rules action-kind action-kind->text
                      first-build first-controller-action
                      item-action parse-next-response
                      parse-ready-response ready-item)

(export controller-and-exit)

(defenum run-mode
  one-pass
  polling)

(defenum pass-outcome
  dispatched
  merged
  idle)

(defstruct controller-settings
  :poll-seconds int
  :merge-wait merge-settings)

(defn controller-and-exit (repo poll merge-poll merge-timeout once)
  (match (canonical-repo repo)
    ((ok absolute)
     (run-controller-and-exit
       (as-str absolute)
       (build-controller-settings poll merge-poll merge-timeout)
       once))
    ((err failure) (eprintln (error->message failure)) (exit 1))))

(defn build-controller-settings (poll merge-poll merge-timeout)
  (let (pass-seconds (poll-seconds poll)
        merge-wait (->merge-settings :poll-seconds (poll-seconds merge-poll)
                                     :timeout-seconds (poll-seconds
                                                        merge-timeout)))
    (->controller-settings :poll-seconds pass-seconds
                           :merge-wait merge-wait)))

(defn canonical-repo (repo)
  (map-err (canonical-path repo)
    (fn (reason)
      (controller-error/unreadable-repository (str repo) reason))))

(defn run-controller-and-exit (repo settings once)
  (let (mode (match once (on run-mode/one-pass) (off run-mode/polling)))
    (match (run-controller repo settings mode)
      ((ok _) (do))
      ((err report) (fail-stop repo report)))))

(defn run-controller (repo settings mode)
  (loop ()
    (let (pass (run-pass repo settings))
      (if (pass-complete? mode pass)
        (pass-result pass)
        (do (wait-before-repeat settings pass) (recur))))))

(defn pass-complete? (mode pass)
  (match pass
    ((ok _) (one-pass? mode))
    ((err _) true)))

(defn one-pass? (mode)
  (match mode (one-pass true) (polling false)))

(defn wait-before-repeat (settings pass)
  (match pass
    ((ok idle) (sleep (seconds (:poll-seconds settings))))
    (_ (do))))

(defn pass-result (pass)
  (match pass
    ((ok _) (ok (do)))
    ((err report) (err report))))

(type poll-seconds (fn (u32) int))

(defn poll-seconds (poll)
  (the int (convert poll)))

(defn run-pass (repo settings)
  (match (read-factory repo)
    ((err failure)
     (err (->failure-report :manager (read-manager repo)
                            :error (controller-error/factory-failed failure))))
    ((ok config) (run-pass-with repo config settings))))

(type run-pass-with
  (fn ((ref str)
       (ref factory-config)
       (ref controller-settings))
    (result pass-outcome failure-report)))

(defn run-pass-with (repo config settings)
  (let (manager (some (clone (:manager config))))
    (match (poll-next repo config)
      ((err failure)
       (err (->failure-report :manager manager :error failure)))
      ((ok pending)
       (continue-from-next repo config manager settings pending)))))

(defn continue-from-next (repo config manager settings pending)
  (match pending
    ((some action)
     (take-controller-action repo config manager settings action))
    (none (run-ready repo config manager))))

(type take-controller-action
  (fn ((ref str)
       (ref factory-config)
       (option string)
       (ref controller-settings)
       (ref item-action))
    (result pass-outcome failure-report)))

(defn take-controller-action (repo config manager settings action)
  (match (:kind action)
    (review (start-review-report repo config manager action
                                 review-mode/review))
    (verify (start-review-report repo config manager action
                                 review-mode/verify))
    (merge (start-merge-report repo config manager settings action))
    (_ (out-of-scope-report config manager action))))

(defn start-merge-report (repo config manager settings action)
  (match (start-merge repo config
                      (:merge-wait settings)
                      (:item action))
    ((ok _) (ok pass-outcome/merged))
    ((err failure)
     (err (->failure-report :manager manager :error failure)))))

(defn start-review-report (repo config manager action mode)
  (match (start-review repo config (:item action) mode)
    ((ok _) (ok pass-outcome/dispatched))
    ((err failure)
     (err (->failure-report :manager manager :error failure)))))

(defn out-of-scope-report (config manager action)
  (err (->failure-report :manager manager
                         :error (out-of-scope-error config action))))

(defn run-ready (repo config manager)
  (match (poll-ready repo config)
    ((err failure)
     (err (->failure-report :manager manager :error failure)))
    ((ok items) (dispatch-first repo config manager items))))

(defn dispatch-first (repo config manager items)
  (match (first-build items)
    (none (ok pass-outcome/idle))
    ((some item) (dispatch-ready repo config manager item))))

(defn dispatch-ready (repo config manager item)
  (match (dispatch repo config item)
    ((ok _) (ok pass-outcome/dispatched))
    ((err failure)
     (err (->failure-report :manager manager :error failure)))))

(defn poll-next (repo config)
  (let (command (next-command (:roadmap config)))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (check-next-output command (:stdout outcome))
        (err (command-failed (str "next") (str "-") command outcome))))))

(defn check-next-output (command text)
  (let (document (parse-document (str "next") command text))
    (match document
      ((err failure) (err failure))
      ((ok value) (check-next-document command value)))))

(defn check-next-document (command document)
  (match (parse-next-response document)
    ((ok lines) (ok (first-controller-action lines)))
    ((err reason)
     (err (output-failed (str "next") command reason)))))

(defn poll-ready (repo config)
  (let (command (ready-command (:roadmap config)))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (check-ready-output command (:stdout outcome))
        (err (command-failed (str "ready") (str "-") command outcome))))))

(defn check-ready-output (command text)
  (let (document (parse-document (str "ready") command text))
    (match document
      ((err failure) (err failure))
      ((ok value) (check-ready-document command value)))))

(defn check-ready-document (command document)
  (match (parse-ready-response document)
    ((ok items) (ok items))
    ((err reason)
     (err (output-failed (str "ready") command reason)))))

(defn parse-document (action command text)
  (match (parse-json (as-str text))
    ((ok document) (ok document))
    ((err failure)
     (err (output-failed action command (json-error->message failure))))))

(type output-failed
  (fn (string (ref command) string) controller-error))

(defn output-failed (action command reason)
  (controller-error/command-failed (->action-failure
                                     :action action
                                     :item (str "-")
                                     :command (clone (:label command))
                                     :code 0
                                     :detail (str "invalid JSON: " reason))))

(defn command-failed (action item command outcome)
  (controller-error/command-failed (->action-failure
                                     :action action
                                     :item item
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))

(defn ready-command (roadmap)
  (->command :program (str "rmap")
             :arguments (vec (str "ready")
                             (str "--roadmap")
                             (clone roadmap)
                             (str "--json"))
             :label (str "rmap ready --roadmap " roadmap " --json")))

(defn out-of-scope-error (config action)
  (let (command (next-command (:roadmap config)))
    (controller-error/out-of-scope (->action-failure
                                     :action (action-kind->text (:kind action))
                                     :item (clone (:item action))
                                     :command (clone (:label command))
                                     :code 0
                                     :detail (str)))))

(defn next-command (roadmap)
  (->command :program (str "rmap")
             :arguments (vec (str "next")
                             (str "--roadmap")
                             (clone roadmap)
                             (str "--taken-by")
                             (str "controller")
                             (str "--json"))
             :label (str "rmap next --roadmap " roadmap
                         " --taken-by controller --json")))

(defn fail-stop (repo report)
  (let (message (error->message (:error report)))
    (match (:manager report)
      ((some manager)
       (let (_outcome (execute repo (send-command manager message)))
         (do)))
      (none (do)))
    (eprintln message)
    (exit 1)))

(defn send-command (manager message)
  (->command :program (str "ringleader")
             :arguments (vec (str "send")
                             (clone manager)
                             (clone message))
             :label (str "ringleader send " manager)))
