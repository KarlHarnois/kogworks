(module
  "Runs the controller loop.")

(use knave-commandant switch-state)
(use controller/cap read-cap set-command)
(use controller/dispatch dispatch)

(use controller/failure ->action-failure ->failure-report
                        controller-error error->message
                        failure-report manager-message?)

(use controller/factory factory-config read-factory
                        read-manager)

(use controller/json json-error->message parse-json)
(use controller/log-lines log-action)

(use controller/log-report print-action print-banner
                           print-failure print-merge-line
                           print-stop read-log-item
                           review-log-item)

(use controller/merge ->merge-settings merge-settings
                      start-merge)

(use controller/merge-commands send-command)

(use controller/merge-target ->merge-report ignore-report
                             merge-outcome)

(use controller/notice ->notice-clock notice
                       waiting-actions)

(use controller/notice-delivery ->notice-route send-notices)

(use controller/process ->command canonical-path command
                        command-detail execute successful?)

(use controller/remote read-remote)

(use controller/review design-review-gate review-mode
                       start-review)

(use controller/rules action-kind action-kind->text
                      first-controller-action first-dispatch
                      item-action next-line
                      parse-next-response
                      parse-ready-response)

(export controller-and-exit)

(def whole-seconds
  (rust "i64::try_from({0}.as_secs()).unwrap_or(i64::MAX)"
    (fn (duration) int)))

(defenum run-mode
  one-pass
  polling)

(defstruct pass-progress
  :outcome pass-outcome
  :notices (vec notice))

(defenum pass-outcome
  dispatched
  merged
  handed-back
  idle)

(defstruct controller-settings
  :poll-seconds int
  :stall-seconds int
  :started instant
  :merge-wait merge-settings
  :remote (option string))

(defstruct run-state
  :notices (vec notice)
  :merged int)

(defstruct failed-run
  :report failure-report
  :merged int)

(defn controller-and-exit (repo poll stall merge-poll
                                merge-timeout retry-delay
                                once rerun)
  (match (canonical-repo repo)
    ((ok absolute)
     (let (remote (read-remote (as-str absolute)))
       (run-controller-and-exit (as-str absolute)
                                (build-controller-settings
                                  poll stall merge-poll
                                  merge-timeout retry-delay
                                  remote)
                                once rerun)))
    ((err failure)
     (do
       (print-failure repo none none failure)
       (print-stop none 0 1 rerun)
       (exit 1)))))

(defn build-controller-settings (poll stall merge-poll
                                      merge-timeout
                                      retry-delay remote)
  (let (pass-seconds (poll-seconds poll)
        merge-wait (->merge-settings
                     :poll-seconds (poll-seconds merge-poll)
                     :timeout-seconds (poll-seconds merge-timeout)
                     :retry-delay-seconds (poll-seconds retry-delay)
                     :report ignore-report
                     :report-data (->merge-report :remote none :item (str))))
    (->controller-settings :poll-seconds pass-seconds
                           :stall-seconds (poll-seconds stall)
                           :started (now)
                           :merge-wait merge-wait
                           :remote (clone remote))))

(defn canonical-repo (repo)
  (map-err (canonical-path repo)
    (fn (reason)
      (controller-error/unreadable-repo (str repo) reason))))

(defn run-controller-and-exit (repo settings once rerun)
  (let (mode (match once (on run-mode/one-pass) (off run-mode/polling)))
    (match (run-controller repo settings mode)
      ((ok _) (do))
      ((err failed)
       (fail-stop repo
                  (:report failed)
                  (:merged failed)
                  rerun settings)))))

(type run-controller
  (fn ((ref str) (ref controller-settings) run-mode)
    (result unit failed-run)))

(defn run-controller (repo settings mode)
  (match (read-factory repo)
    ((err failure)
     (err (->failed-run :report (->failure-report :manager (read-manager repo)
                                                  :error (controller-error/factory-failed
                                                           failure))
                        :merged 0)))
    ((ok config)
     (match (set-start-cap repo config)
       ((err report) (err (->failed-run :report report :merged 0)))
       ((ok _) (begin-run repo config settings mode))))))

(type set-start-cap
  (fn ((ref str) (ref factory-config))
    (result unit failure-report)))

(defn set-start-cap (repo config)
  (match (read-cap repo)
    ((err failure)
     (err (->failure-report :manager (some (clone (:manager config)))
                            :error (controller-error/factory-failed failure))))
    ((ok cap) (run-set-cap repo config cap))))

(defn run-set-cap (repo config cap)
  (let (command (set-command cap)
        outcome (execute repo command))
    (if (successful? outcome)
      (ok (do))
      (err (->failure-report :manager (some (clone (:manager config)))
                             :error (cap-command-failed command outcome))))))

(defn cap-command-failed (command outcome)
  (controller-error/command-failed (->action-failure
                                     :action (str "max active")
                                     :item (str "-")
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))

(type begin-run
  (fn ((ref str)
       (ref factory-config)
       (ref controller-settings)
       run-mode)
    (result unit failed-run)))

(defn begin-run (repo config settings mode)
  (do
    (print-banner (:remote settings)
                  (:roadmap config)
                  (some (clone (:manager config)))
                  (:poll-seconds settings))
    (run-controller-loop repo config settings mode
                         (->run-state :notices (vec) :merged 0))))

(type run-controller-loop
  (fn ((ref str)
       (ref factory-config)
       (ref controller-settings)
       run-mode run-state)
    (result unit failed-run)))

(defn run-controller-loop (repo config settings mode state)
  (let (pass (run-pass repo settings (:notices state)))
    (if (pass-complete? mode pass)
      (pass-result pass state)
      (do
        (wait-before-repeat settings pass)
        (recur repo config settings mode (next-state state pass))))))

(type next-state
  (fn (run-state (result pass-progress failure-report))
    run-state))

(defn next-state (state pass)
  (match pass
    ((ok progress)
     (->run-state :notices (clone (:notices progress))
                  :merged (+ (:merged state)
                             (merged-increment (:outcome progress)))))
    ((err _) state)))

(defn merged-increment (outcome)
  (match outcome (pass-outcome/merged 1) (_ 0)))

(defn pass-complete? (mode pass)
  (match pass
    ((ok _) (one-pass? mode))
    ((err _) true)))

(defn one-pass? (mode)
  (match mode (one-pass true) (polling false)))

(defn wait-before-repeat (settings pass)
  (match pass
    ((ok progress) (wait-after settings (:outcome progress)))
    ((err _) (do))))

(defn wait-after (settings outcome)
  (match outcome
    (idle (sleep (seconds (:poll-seconds settings))))
    (_ (do))))

(type pass-result
  (fn ((result pass-progress failure-report) run-state)
    (result unit failed-run)))

(defn pass-result (pass state)
  (match pass
    ((ok _) (ok (do)))
    ((err report)
     (err (->failed-run :report report :merged (:merged state))))))

(type poll-seconds (fn (u32) int))

(defn poll-seconds (poll)
  (the int (convert poll)))

(defn run-pass (repo settings notices)
  (match (read-factory repo)
    ((err failure)
     (err (->failure-report :manager (read-manager repo)
                            :error (controller-error/factory-failed failure))))
    ((ok config) (run-pass-with repo config settings notices))))

(defn run-pass-with (repo config settings notices)
  (match (poll-next repo config)
    ((err failure)
     (err (->failure-report :manager (some (clone (:manager config)))
                            :error failure)))
    ((ok lines)
     (run-pass-from repo config settings notices lines))))

(type run-pass-from
  (fn ((ref str)
       (ref factory-config)
       (ref controller-settings)
       (ref (vec notice))
       (ref (vec next-line)))
    (result pass-progress failure-report)))

(defn run-pass-from (repo config settings notices lines)
  (let (waiting (waiting-actions lines)
        sent (send-notices (notice-route-of repo config settings)
                           notices waiting)
        manager (some (clone (:manager config))))
    (with-notices (continue-from-next repo config manager
                                      settings
                                      (first-controller-action lines))
                  sent)))

(defn notice-route-of (repo config settings)
  (->notice-route :repo (str repo)
                  :manager (clone (:manager config))
                  :clock (->notice-clock :now (whole-seconds (elapsed (:started settings)))
                                         :stall (:stall-seconds settings))))

(defn with-notices (outcome notices)
  (match outcome
    ((ok done)
     (ok (->pass-progress :outcome done :notices notices)))
    ((err report) (err report))))

(defn continue-from-next (repo config manager settings pending)
  (match pending
    ((some action)
     (take-controller-action repo config manager settings action))
    (none (run-ready repo config manager settings))))

(type take-controller-action
  (fn ((ref str)
       (ref factory-config)
       (option string)
       (ref controller-settings)
       (ref item-action))
    (result pass-outcome failure-report)))

(defn take-controller-action (repo config manager settings action)
  (match (:kind action)
    (review (start-review-report repo config manager
                                 settings action
                                 review-mode/review))
    (verify (start-review-report repo config manager
                                 settings action
                                 review-mode/verify))
    (merge (start-merge-report repo config manager settings action))
    (_ (out-of-scope-report config manager action))))

(defn start-merge-report (repo config manager settings action)
  (match (:design-reviewer config)
    (none (merge-report repo config manager settings action))
    ((some role)
     (design-gated-merge repo config manager settings action
                         role))))

(defn design-gated-merge (repo config manager settings action role)
  (match (design-review-gate repo config (:item action) role)
    ((err failure)
     (err (->failure-report :manager manager :error failure)))
    ((ok none)
     (merge-report repo config manager settings action))
    ((ok (some started))
     (started-review-progress settings
                              (:item action)
                              started review-mode/design))))

(defn merge-report (repo config manager settings action)
  (let (merge-wait (assoc (clone (:merge-wait settings))
                          :report print-merge-line
                          :report-data (->merge-report :remote (clone (:remote settings))
                                                       :item (clone (:item action)))))
    (match (start-merge repo config merge-wait (:item action))
      ((ok merge-outcome/merged) (ok pass-outcome/merged))
      ((ok merge-outcome/handed-back)
       (ok pass-outcome/handed-back))
      ((err failure)
       (err (->failure-report :manager manager :error failure))))))

(defn start-review-report (repo config manager settings action mode)
  (match (start-review repo config (:item action) mode)
    ((ok result)
     (started-review-progress settings
                              (:item action)
                              result mode))
    ((err failure)
     (err (->failure-report :manager manager :error failure)))))

(defn started-review-progress (settings item result mode)
  (do
    (print-action (:remote settings)
                  (review-log-item (clone item)
                                   (clone (:title (:detail result)))
                                   (clone (:kind (:detail result)))
                                   (clone (:branch (:detail result)))
                                   (clone (:pr (:detail result)))
                                   (clone (:head (:detail result))))
                  (review-log-action mode))
    (ok pass-outcome/dispatched)))

(defn review-log-action (mode)
  (match mode
    (review-mode/review log-action/review)
    (review-mode/verify log-action/verify)
    (review-mode/design log-action/review)))

(defn out-of-scope-report (config manager action)
  (err (->failure-report :manager manager
                         :error (out-of-scope-error config action))))

(defn run-ready (repo config manager settings)
  (match (poll-ready repo config)
    ((err failure)
     (err (->failure-report :manager manager :error failure)))
    ((ok items)
     (dispatch-first repo config manager settings items))))

(defn dispatch-first (repo config manager settings items)
  (match (first-dispatch items)
    (none (ok pass-outcome/idle))
    ((some item)
     (dispatch-ready repo config manager settings item))))

(defn dispatch-ready (repo config manager settings item)
  (match (dispatch repo config item)
    ((ok _)
     (do
       (print-action (:remote settings)
                     (read-log-item repo (:id item))
                     log-action/dispatch)
       (ok pass-outcome/dispatched)))
    ((err failure)
     (err (->failure-report :manager manager :error failure)))))

(defn poll-next (repo config)
  (let (command (next-command (:roadmap config)))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (check-next-output command (:stdout outcome))
        (err (command-failed (str "next") (str "-") command outcome))))))

(defn check-next-output (command text)
  (let (document (parse-document (str "next") command text))
    (match document
      ((err failure) (err failure))
      ((ok value) (check-next-document command value)))))

(defn check-next-document (command document)
  (match (parse-next-response document)
    ((ok lines) (ok lines))
    ((err reason)
     (err (output-failed (str "next") command reason)))))

(defn poll-ready (repo config)
  (let (command (ready-command (:roadmap config)))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (check-ready-output command (:stdout outcome))
        (err (command-failed (str "ready") (str "-") command outcome))))))

(defn check-ready-output (command text)
  (let (document (parse-document (str "ready") command text))
    (match document
      ((err failure) (err failure))
      ((ok value) (check-ready-document command value)))))

(defn check-ready-document (command document)
  (match (parse-ready-response document)
    ((ok items) (ok items))
    ((err reason)
     (err (output-failed (str "ready") command reason)))))

(defn parse-document (action command text)
  (match (parse-json (as-str text))
    ((ok document) (ok document))
    ((err failure)
     (err (output-failed action command (json-error->message failure))))))

(type output-failed
  (fn (string (ref command) string) controller-error))

(defn output-failed (action command reason)
  (controller-error/command-failed (->action-failure
                                     :action action
                                     :item (str "-")
                                     :command (clone (:label command))
                                     :code 0
                                     :detail (str "invalid JSON: " reason))))

(defn command-failed (action item command outcome)
  (controller-error/command-failed (->action-failure
                                     :action action
                                     :item item
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))

(defn ready-command (roadmap)
  (->command :program (str "rmap")
             :args (vec (str "ready")
                        (str "--roadmap")
                        (clone roadmap)
                        (str "--json"))
             :label (str "rmap ready --roadmap " roadmap " --json")))

(defn out-of-scope-error (config action)
  (let (command (next-command (:roadmap config)))
    (controller-error/out-of-scope (->action-failure
                                     :action (action-kind->text (:kind action))
                                     :item (clone (:item action))
                                     :command (clone (:label command))
                                     :code 0
                                     :detail (str)))))

(defn next-command (roadmap)
  (->command :program (str "rmap")
             :args (vec (str "next")
                        (str "--roadmap")
                        (clone roadmap)
                        (str "--json"))
             :label (str "rmap next --roadmap " roadmap " --json")))

(defn fail-stop (repo report merged rerun settings)
  (let (message (error->message (:error report))
        manager (messaged-manager report))
    (if (manager-message? (:error report))
      (send-to-manager repo (:manager report) message)
      (do))
    (print-failure repo
                   (:remote settings)
                   manager
                   (:error report))
    (print-stop (:remote settings) merged 1 rerun)
    (exit 1)))

(defn messaged-manager (report)
  (if (manager-message? (:error report))
    (clone (:manager report))
    none))

(defn send-to-manager (repo manager message)
  (match manager
    ((some name)
     (let (_outcome (execute repo (send-command name message)))
       (do)))
    (none (do))))
