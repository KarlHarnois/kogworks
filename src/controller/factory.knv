(module
  "Reads the factory JSON that names the roadmap, manager, worker and reviewer roles.")

(use controller/failure factory-error)

(use controller/fields field-error required-object
                       required-text)

(use controller/json json-error->message json-field
                     json-text parse-json)

(use controller/process join-path read-text-file text-file?)

(export ->factory-config ->role factory-config factory-path
        merge-method read-factory read-factory-document
        read-manager role runner)

(defstruct factory-config
  :manager string
  :roadmap string
  :merge merge-method
  :runner runner
  :worker role
  :reviewer role)

(defenum merge-method gh-auto)

(defenum runner ringleader)

(defstruct role
  :agent string
  :skill string
  :brief string)

(defn read-factory (repo)
  (let-try (document (read-factory-document repo))
    (config-from-json document)))

(defn read-manager (repo)
  (match (read-factory-document repo)
    ((ok document) (manager-from-document document))
    ((err _) none)))

(defn read-factory-document (repo)
  (let (path (factory-path repo))
    (if (text-file? (as-str path))
      (document-from-file path)
      (err (factory-error/missing-factory path)))))

(defn factory-path (repo)
  (let (dir (join-path repo ".kogworks"))
    (join-path (as-str dir) "factory.json")))

(defn document-from-file (path)
  (match (read-text-file (as-str path))
    ((ok text) (document-from-text path text))
    ((err reason)
     (err (factory-error/unreadable-factory (clone path) reason)))))

(defn document-from-text (path text)
  (map-err (parse-json (as-str text))
    (fn (failure)
      (factory-error/malformed-factory (clone path)
                                       (json-error->message failure)))))

(defn manager-from-document (document)
  (match (json-field document "manager")
    ((some value) (json-text value))
    (none none)))

(defn config-from-json (document)
  (let-try (manager (factory-text document "manager" "manager")
            roadmap (factory-text document "roadmap" "roadmap")
            merge-text (factory-text document "merge" "merge")
            merge (merge-method-of merge-text)
            roles (factory-object document "roles" "roles")
            worker (required-role roles "worker" "roles.worker")
            reviewer (required-role roles "reviewer" "roles.reviewer")
            runner-text (runner-field document)
            runner (runner-of runner-text))
    (ok (->factory-config :manager manager
                          :roadmap roadmap
                          :merge merge
                          :runner runner
                          :worker worker
                          :reviewer reviewer))))

(defn runner-field (document)
  (match (json-field document "runner")
    (none (err factory-error/missing-runner))
    ((some value) (factory-runner-text value))))

(defn factory-runner-text (value)
  (match (json-text value)
    ((some text) (ok (clone text)))
    (none (err (factory-error/field (field-error/non-text-field (str "runner")))))))

(defn runner-of (text)
  (cond
    ((= text (str "ringleader")) (ok runner/ringleader))
    (else (err (factory-error/unsupported-runner (clone text))))))

(defn merge-method-of (text)
  (cond
    ((= text (str "gh-auto")) (ok merge-method/gh-auto))
    (else (err (factory-error/unsupported-merge-method (clone text))))))

(defn required-role (roles name path)
  (let-try (value (factory-object roles name path)
            agent (factory-text value "agent" (as-str (str path ".agent")))
            skill (factory-text value "skill" (as-str (str path ".skill")))
            brief (factory-text value "brief" (as-str (str path ".brief"))))
    (ok (->role :agent agent :skill skill :brief brief))))

(defn factory-text (value key path)
  (map-err (required-text value key path) factory-field-error))

(defn factory-object (value key path)
  (map-err (required-object value key path)
           factory-field-error))

(defn factory-field-error (failure)
  (factory-error/field failure))
