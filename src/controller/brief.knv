(module
  "Builds and fills the briefs that the factory points at.")

(use controller/failure controller-error)
(use controller/process read-text-file)

(export ->brief ->reviewer-values ->worker-values brief
        fill-brief reviewer-brief reviewer-values
        worker-brief worker-values)

(defstruct worker-values
  :item string
  :roadmap string
  :session string
  :branch string
  :base string
  :skill string)

(defstruct reviewer-values
  :item string
  :roadmap string
  :session string
  :pr string
  :head string
  :criteria string
  :base string
  :skill string
  :manager string)

(defstruct brief
  :item string
  :placeholders (vec placeholder))

(defstruct placeholder
  :token string
  :value string)

(type worker-brief
  (fn ((ref worker-values)) brief))

(defn worker-brief (values)
  (->brief :item (clone (:item values))
           :placeholders (worker-placeholders values)))

(type reviewer-brief
  (fn ((ref reviewer-values)) brief))

(defn reviewer-brief (values)
  (->brief :item (clone (:item values))
           :placeholders (reviewer-placeholders values)))

(defn fill-brief (path values)
  (match (read-text-file path)
    ((err reason)
     (err (controller-error/unreadable-brief (str path) reason)))
    ((ok text)
     (filled-brief (fill (as-str text) (:placeholders values))
                   (:item values)))))

(type worker-placeholders
  (fn ((ref worker-values))
    (vec placeholder)))

(defn worker-placeholders (values)
  (vec (->placeholder :token (str "{{item}}")
                      :value (clone (:item values)))
       (->placeholder :token (str "{{roadmap}}")
                      :value (clone (:roadmap values)))
       (->placeholder :token (str "{{session}}")
                      :value (clone (:session values)))
       (->placeholder :token (str "{{branch}}")
                      :value (clone (:branch values)))
       (->placeholder :token (str "{{base}}")
                      :value (clone (:base values)))
       (->placeholder :token (str "{{skill}}")
                      :value (clone (:skill values)))))

(type reviewer-placeholders
  (fn ((ref reviewer-values))
    (vec placeholder)))

(defn reviewer-placeholders (values)
  (vec (->placeholder :token (str "{{item}}")
                      :value (clone (:item values)))
       (->placeholder :token (str "{{roadmap}}")
                      :value (clone (:roadmap values)))
       (->placeholder :token (str "{{session}}")
                      :value (clone (:session values)))
       (->placeholder :token (str "{{pr}}")
                      :value (clone (:pr values)))
       (->placeholder :token (str "{{head}}")
                      :value (clone (:head values)))
       (->placeholder :token (str "{{criteria}}")
                      :value (clone (:criteria values)))
       (->placeholder :token (str "{{base}}")
                      :value (clone (:base values)))
       (->placeholder :token (str "{{skill}}")
                      :value (clone (:skill values)))
       (->placeholder :token (str "{{manager}}")
                      :value (clone (:manager values)))))

(defn fill (text placeholders)
  (let (characters (collect (chars text)))
    (fill-from placeholders characters 0 (str))))

(defn fill-from (placeholders characters index result)
  (if (>= index (len characters))
    (ok result)
    (fill-step placeholders characters index result)))

(defn fill-step (placeholders characters index result)
  (match (placeholder-at placeholders characters index)
    ((some placeholder)
     (fill-from placeholders characters
                (+ index (token-length placeholder))
                (str result (:value placeholder))))
    (none (fill-unmatched placeholders characters index result))))

(type fill-unmatched
  (fn ((ref (vec placeholder))
       (ref (vec char))
       int string)
    (result string string)))

(defn fill-unmatched (placeholders characters index result)
  (match (opening-braces-at? characters index)
    (true (err (str "{{")))
    (false (fill-from placeholders characters
                      (inc index)
                      (str result (deref (at characters index)))))))

(type placeholder-at
  (fn ((ref (vec placeholder))
       (ref (vec char))
       int)
    (option (ref placeholder))))

(defn placeholder-at (placeholders characters index)
  (find placeholders
    (fn (placeholder)
      (token-at? characters index (:token placeholder)))))

(type token-at?
  (fn ((ref (vec char)) int (ref str))
    bool))

(defn token-at? (characters index token)
  (let (expected (collect (chars token)))
    (and (<= (+ index (len expected))
             (len characters))
         (every? (range 0 (len expected))
           (fn (offset)
             (= (deref (at characters (+ index offset)))
                (deref (at expected offset))))))))

(defn token-length (placeholder)
  (count (chars (:token placeholder))))

(defn opening-braces-at? (characters index)
  (and (< (inc index) (len characters))
       (= (deref (at characters index))
          (char "{"))
       (= (deref (at characters (inc index)))
          (char "{"))))

(defn filled-brief (filled item)
  (match filled
    ((ok text) (ok text))
    ((err token)
     (err (controller-error/placeholder-left (clone item) token)))))
