(module
  "Claims a ready build item and starts its worker session.")

(use controller/brief ->worker-values fill-brief
                      worker-brief)

(use controller/failure ->action-failure controller-error)

(use controller/process ->command command-detail execute
                        join-path successful?)

(use controller/repo default-branch)
(use controller/session abandon-command failed-start-detail)

(export dispatch)

(defn dispatch (repo config item)
  (let (session (str "build-" (:id item)))
    (let (branch (clone session))
      (dispatch-with-base repo config item session branch))))

(defn dispatch-with-base (repo config item session branch)
  (match (default-branch repo)
    ((err failure) (err failure))
    ((ok base)
     (dispatch-with-brief repo config item session branch base))))

(defn dispatch-with-brief (repo config item session branch base)
  (match (fill-worker-brief repo config item session branch base)
    ((err failure) (err failure))
    ((ok prompt)
     (claim-and-start repo config item session branch prompt))))

(defn fill-worker-brief (repo config item session branch base)
  (let (path (join-path repo
                        (as-str (:brief (:worker config)))))
    (let (values (->worker-values :item (clone (:id item))
                                  :roadmap (clone (:roadmap config))
                                  :session (clone session)
                                  :branch (clone branch)
                                  :base (clone base)
                                  :skill (clone (:skill (:worker config)))))
      (fill-brief (as-str path) (worker-brief values)))))

(defn claim-and-start (repo config item session branch prompt)
  (let (claim (claim-command item session branch))
    (let (outcome (execute repo claim))
      (if (successful? outcome)
        (start-session repo config item session prompt)
        (err (command-failed (str "dispatch")
                             (clone (:id item))
                             claim outcome))))))

(defn claim-command (item session branch)
  (->command :program (str "rmap")
             :args (vec (str "item")
                        (str "claim")
                        (clone (:id item))
                        (str "--session")
                        (clone session)
                        (str "--branch")
                        (clone branch))
             :label (str "rmap item claim "
                         (:id item)
                         " --session " session " --branch "
                         branch)))

(defn start-session (repo config item session prompt)
  (let (start (start-command repo config session prompt))
    (let (outcome (execute repo start))
      (if (successful? outcome)
        (ok (clone session))
        (abandon-and-fail repo
                          (clone (:id item))
                          session start outcome)))))

(defn abandon-and-fail (repo item session start outcome)
  (let (abandon (abandon-command session))
    (let (end-outcome (execute repo abandon))
      (err (controller-error/command-failed
             (->action-failure :action (str "dispatch")
                               :item (clone item)
                               :command (clone (:label start))
                               :code (:code outcome)
                               :detail (failed-start-detail outcome
                                                            end-outcome)))))))

(defn start-command (repo config session prompt)
  (let (agent (:agent (:worker config)))
    (->command :program (str "ringleader")
               :args (vec (str "new")
                          (str "--name")
                          (clone session)
                          (str "--repo")
                          (str repo)
                          (str "--agent")
                          (clone agent)
                          (str "--prompt")
                          (clone prompt))
               :label (str "ringleader new --name " session
                           " --repo " repo " --agent " agent
                           " --prompt <filled brief>"))))

(defn command-failed (action item command outcome)
  (controller-error/command-failed (->action-failure
                                     :action action
                                     :item item
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))
