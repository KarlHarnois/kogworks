(module
  "Claims a ready build item and starts its worker session.")

(use controller/brief ->brief-values fill-brief)
(use controller/failure ->action-failure controller-error)
(use controller/factory factory-config)

(use controller/process ->command command command-detail
                        execute join-path outcome
                        successful?)

(use controller/repository default-branch)
(use controller/rules ready-item)

(export dispatch)

(type dispatch
  (fn ((ref str)
       (ref factory-config)
       (ref ready-item))
    (result string controller-error)))

(defn dispatch (repo config item)
  (let (session (str "build-" (:id item)))
    (let (branch (clone session))
      (match (default-branch repo)
        ((err failure) (err failure))
        ((ok base)
         (match (fill-worker-brief repo config item session branch base)
           ((err failure) (err failure))
           ((ok prompt)
            (claim-and-start repo config item session branch prompt))))))))

(type fill-worker-brief
  (fn ((ref str)
       (ref factory-config)
       (ref ready-item)
       (ref string)
       (ref string)
       (ref string))
    (result string controller-error)))

(defn fill-worker-brief (repo config item session branch base)
  (let (path (join-path repo
                        (as-str (:brief (:worker config)))))
    (fill-brief (as-str path)
                (->brief-values :item (clone (:id item))
                                :roadmap (clone (:roadmap config))
                                :session (clone session)
                                :branch (clone branch)
                                :base (clone base)
                                :skill (clone (:skill (:worker config)))))))

(type claim-and-start
  (fn ((ref str)
       (ref factory-config)
       (ref ready-item)
       (ref string)
       (ref string)
       (ref string))
    (result string controller-error)))

(defn claim-and-start (repo config item session branch prompt)
  (let (claim (claim-command item session branch))
    (let (outcome (execute repo claim))
      (if (successful? outcome)
        (start-session repo config item session prompt)
        (err (command-failed (str "dispatch")
                             (clone (:id item))
                             claim outcome))))))

(type claim-command
  (fn ((ref ready-item)
       (ref string)
       (ref string))
    command))

(defn claim-command (item session branch)
  (->command :program (str "rmap")
             :arguments (vec (str "item")
                             (str "claim")
                             (clone (:id item))
                             (str "--session")
                             (clone session)
                             (str "--branch")
                             (clone branch))
             :label (str "rmap item claim "
                         (:id item)
                         " --session " session " --branch "
                         branch)))

(type start-session
  (fn ((ref str)
       (ref factory-config)
       (ref ready-item)
       (ref string)
       (ref string))
    (result string controller-error)))

(defn start-session (repo config item session prompt)
  (let (start (start-command repo config session prompt))
    (let (outcome (execute repo start))
      (if (successful? outcome)
        (do
          (println session)
          (ok (clone session)))
        (abandon-and-fail repo
                          (clone (:id item))
                          session start outcome)))))

(type abandon-and-fail
  (fn ((ref str)
       (ref string)
       (ref string)
       (ref command)
       (ref outcome))
    (result string controller-error)))

(defn abandon-and-fail (repo item session start outcome)
  (let (abandon (abandon-command session))
    (let (end-outcome (execute repo abandon))
      (err (controller-error/command-failed
             (->action-failure :action (str "dispatch")
                               :item (clone item)
                               :command (clone (:label start))
                               :code (:code outcome)
                               :detail (start-failure-detail outcome
                                                             end-outcome)))))))

(defn start-failure-detail (outcome end-outcome)
  (let (detail (command-detail outcome))
    (if (successful? end-outcome)
      detail
      (str detail "; session end exited "
           (:code end-outcome)
           ": "
           (command-detail end-outcome)))))

(type start-command
  (fn ((ref str)
       (ref factory-config)
       (ref string)
       (ref string))
    command))

(defn start-command (repo config session prompt)
  (let (agent (:agent (:worker config)))
    (->command :program (str "ringleader")
               :arguments (vec (str "new")
                               (str "--name")
                               (clone session)
                               (str "--repo")
                               (str repo)
                               (str "--agent")
                               (clone agent)
                               (str "--prompt")
                               (clone prompt))
               :label (str "ringleader new --name " session
                           " --repo " repo " --agent " agent
                           " --prompt <filled brief>"))))

(type abandon-command
  (fn ((ref string)) command))

(defn abandon-command (session)
  (->command :program (str "rmap")
             :arguments (vec (str "session")
                             (str "end")
                             (clone session)
                             (str "--reason")
                             (str "abandoned"))
             :label (str "rmap session end " session " --reason abandoned")))

(type command-failed
  (fn (string string (ref command) (ref outcome))
    controller-error))

(defn command-failed (action item command outcome)
  (controller-error/command-failed (->action-failure
                                     :action action
                                     :item item
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))
