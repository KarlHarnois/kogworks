(module
  "Names and reads the pull request, approved head, item state and settings that a merge acts on.")

(use controller/failure ->action-failure controller-error)

(use controller/fields field-error->message required-bool
                       required-number required-object
                       required-text)

(use controller/json json-array json-error->message
                     json-field json-text parse-json)

(use controller/merge-commands list-command show-command)
(use controller/process command-detail execute successful?)

(export ->merge-report ->merge-settings ->merge-target
        ignore-report invalid-item-output invalid-output
        merge-approval merge-command-failure merge-event
        merge-item-status merge-outcome merge-report
        merge-settings merge-target read-item-status
        read-merge-target read-merging-items
        read-watched-items report-event)

(defenum merge-event
  merging
  closed)

(defenum merge-outcome
  merged
  armed
  waiting
  handed-back)

(defstruct merge-report
  :remote (option string)
  :item string)

(defstruct merge-settings
  :retry-delay-seconds int
  :timeout-seconds int
  :remote (option string)
  :report (fn (merge-event (ref merge-target) (ref merge-report))
            unit))

(defstruct merge-target
  :id string
  :pull-request string
  :head string
  :item-status merge-item-status
  :approval merge-approval
  :title string
  :kind string
  :branch (option string))

(defenum merge-approval
  approved
  not-approved)

(defenum merge-item-status
  fixing
  in-review
  merging
  other)

(defn read-merge-target (repo item)
  (read-item-document repo item target-fields))

(defn read-item-status (repo item)
  (read-item-document repo item item-status-field))

(defn read-merging-items (repo roadmap)
  (read-item-ids repo roadmap (vec (str "merging"))))

(defn read-watched-items (repo roadmap)
  (read-item-ids repo roadmap
                 (vec (str "merging")
                      (str "fixing")
                      (str "in_review"))))

(defn invalid-item-output (item command reason)
  (invalid-output item command
                  (str "invalid item JSON")
                  reason))

(defn invalid-output (item command description reason)
  (controller-error/command-failed (->action-failure
                                     :action (str "merge")
                                     :item (clone item)
                                     :command (clone (:label command))
                                     :code 0
                                     :detail (str description ": " reason))))

(defn merge-command-failure (item command outcome)
  (controller-error/command-failed (->action-failure
                                     :action (str "merge")
                                     :item (clone item)
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))

(defn report-event (settings event target)
  (let (report (:report settings))
    (report event target
            (->merge-report :remote (clone (:remote settings))
                            :item (clone (:id target))))))

(defn ignore-report (_event _target _data) (do))

(defn read-item-document (repo item parse)
  (let (command (show-command item)
        outcome (execute repo command))
    (if (successful? outcome)
      (parse-item-document item command (:stdout outcome) parse)
      (err (merge-command-failure item command outcome)))))

(defn parse-item-document (item command text parse)
  (match (parse-json (as-str text))
    ((ok document)
     (map-err (parse document)
       (fn (failure)
         (invalid-item-output item command
                              (field-error->message failure)))))
    ((err failure)
     (err (invalid-item-output item command
                               (json-error->message failure))))))

(defn target-fields (document)
  (let-try (status (item-status-field document)
            record (required-object document "item" "item")
            id (required-text record "id" "item.id")
            title (required-text record "title" "item.title")
            kind (required-text record "kind" "item.kind")
            pull (required-object document "pull_request" "pull_request")
            pr (required-number pull "number" "pull_request.number")
            approved (required-bool pull "approved" "pull_request.approved")
            approval (required-object pull "approval" "pull_request.approval")
            head (required-text approval "head" "pull_request.approval.head"))
    (ok (->merge-target :id id
                        :pull-request pr
                        :head head
                        :item-status status
                        :approval (bool->approval approved)
                        :title title
                        :kind kind
                        :branch (session-branch record)))))

(defn session-branch (item)
  (match (json-field item "session")
    (none none)
    ((some session) (optional-field-text session "branch"))))

(defn optional-field-text (value key)
  (match (json-field value key)
    (none none)
    ((some found) (json-text found))))

(defn item-status-field (document)
  (let-try (record (required-object document "item" "item")
            status (required-text record "status" "item.status"))
    (ok (text->item-status status))))

(defn text->item-status (text)
  (cond
    ((= text (str "fixing")) merge-item-status/fixing)
    ((= text (str "in_review")) merge-item-status/in-review)
    ((= text (str "merging")) merge-item-status/merging)
    (else merge-item-status/other)))

(defn bool->approval (approved)
  (if approved
    merge-approval/approved merge-approval/not-approved))

(defn read-item-ids (repo roadmap statuses)
  (let (command (list-command roadmap))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (map-err (item-ids (str (trim (:stdout outcome)))
                           statuses)
                 (fn (reason)
                   (invalid-output (str "-")
                                   command
                                   (str "invalid item list JSON")
                                   reason)))
        (err (merge-command-failure (str "-") command outcome))))))

(defn item-ids (text statuses)
  (match (parse-json (as-str text))
    ((ok document) (document-item-ids document statuses))
    ((err failure) (err (json-error->message failure)))))

(defn document-item-ids (document statuses)
  (match (json-field document "items")
    (none (err (str "`items` is missing")))
    ((some value) (items-of value statuses))))

(defn items-of (value statuses)
  (match (json-array value)
    (none (err (str "`items` is not an array")))
    ((some items) (collect-item-ids items statuses))))

(defn collect-item-ids (items statuses)
  (loop (index 0
         ids (vec))
    (if (>= index (len items))
      (ok ids)
      (match (item-id (at items index) statuses)
        ((ok none) (recur (inc index) ids))
        ((ok (some id)) (recur (inc index) (push-id! ids id)))
        ((err reason) (err reason))))))

(defn push-id! (ids id)
  (do (push! ids id) ids))

(defn item-id (item statuses)
  (map-err (item-id-fields item statuses)
           field-error->message))

(defn item-id-fields (item statuses)
  (let-try (id (required-text item "id" "items[].id")
            status (required-text item "status" "items[].status"))
    (ok (watched-option id status statuses))))

(defn watched-option (id status statuses)
  (if (contains? statuses status) (some id) none))
