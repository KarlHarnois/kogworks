(module
  "Prints the controller log lines to standard error.")

(use controller/events event-entry event-error->message
                       event-log fixing-baselines latest-id
                       parse-event-log roadmap-id-of)

(use controller/failure ->action-failure controller-error)
(use controller/json json json-field json-text parse-json)

(use controller/lifecycle ->log-progress advance-progress
                          event-item-id event-line
                          fixing-round-for last-review-of
                          log-progress)

(use controller/log ->log-settings ->pr-summary
                    output-target render-controller-failure
                    render-item render-start render-stop)

(use controller/log-lines ->log-item controller-failure-of
                          failure-item-id failure-line
                          log-item short-head start-of
                          stop-of)

(use controller/merge-target merge-approval merge-target)

(use controller/process ->command command command-detail
                        execute successful?)

(use controller/rules item-kind item-kind-of)

(use controller/surroundings local-time local-time->text
                             read-color-mode
                             stderr-terminal? stderr-width)

(export merge-log-item print-events print-failure
        print-start print-stop read-log-item
        review-log-item start-progress)

(defn print-start (remote roadmap manager running)
  (let (settings (settings-for remote)
        line (start-of (time-text) roadmap manager running))
    (print-lines (render-start settings line))))

(defn print-failure (repo remote manager failure)
  (match (failure-item-id failure)
    ((some item)
     (let (log (read-log-item repo item)
           line (failure-line (time-text) log manager failure))
       (print-lines (render-item (settings-for remote) line))))
    (none (let (line (controller-failure-of (time-text) manager failure))
            (print-lines (render-controller-failure (settings-for remote)
                                                    line))))))

(defn print-stop (remote progress failed rerun)
  (let (line (stop-of (time-text)
                      (:merged progress)
                      (:accepted progress)
                      failed
                      (:running progress)
                      rerun))
    (print-lines (render-stop (settings-for remote) line))))

(defn start-progress (repo roadmap)
  (let (command (log-command none))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (start-progress-from roadmap (:stdout outcome) command)
        (err (log-failure command outcome))))))

(type print-events
  (fn ((ref str)
       (option string)
       log-progress
       (ref (vec log-item)))
    (result log-progress controller-error)))

(defn print-events (repo remote progress items)
  (let (command (log-command (some (:event-id progress))))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (print-log-text repo
                        (clone remote)
                        (clone progress)
                        items
                        (clone (:stdout outcome))
                        (clone command))
        (err (log-failure command outcome))))))

(defn review-log-item (id title kind branch pull-request head approved)
  (->log-item :id (str id)
              :kind (item-kind-of kind)
              :title (str title)
              :branch (some (str branch))
              :approved approved
              :pull-request (review-pr (str pull-request)
                                       (str branch)
                                       (str head))))

(type read-log-item
  (fn ((ref str) (ref string)) log-item))

(defn read-log-item (repo item)
  (match (show-log-item repo item)
    ((ok log-item) log-item)
    ((err _) (fallback-log-item (str item)))))

(type merge-log-item
  (fn (string (ref merge-target)) log-item))

(defn merge-log-item (item target)
  (->log-item :id (str item)
              :kind (item-kind-of (clone (:kind target)))
              :title (str (:title target))
              :branch (clone (:branch target))
              :approved (= (:approval target) merge-approval/approved)
              :pull-request (target-pr target)))

(type log-command
  (fn ((option int)) command))

(defn log-command (since)
  (match since
    (none (log-command-with (vec (str "log") (str "--json"))))
    ((some event-id)
     (log-command-with (vec (str "log")
                            (str "--since")
                            (str event-id)
                            (str "--json"))))))

(defn log-command-with (arguments)
  (->command :program (str "rmap")
             :args (clone arguments)
             :label (str "rmap "
                         (join (collect (map arguments
                                          (fn (argument) (str argument))))
                               " "))))

(defn start-progress-from (roadmap text command)
  (match (parse-event-log text)
    ((err failure) (err (invalid-log command failure)))
    ((ok log) (ok (initial-progress log roadmap)))))

(defn initial-progress (log roadmap)
  (->log-progress :event-id (latest-id log)
                  :roadmap-id (unwrap-or (roadmap-id-of log roadmap) (str))
                  :fixing-counts (fixing-baselines log)
                  :merged 0
                  :accepted 0
                  :running (vec)
                  :reviews (vec)))

(type print-log-text
  (fn ((ref str)
       (option string)
       log-progress
       (ref (vec log-item))
       string command)
    (result log-progress controller-error)))

(defn print-log-text (repo remote progress items text command)
  (match (parse-event-log text)
    ((err failure) (err (invalid-log command failure)))
    ((ok log)
     (print-log-entries repo remote progress items log))))

(type print-log-entries
  (fn ((ref str)
       (option string)
       log-progress
       (ref (vec log-item))
       (ref event-log))
    (result log-progress controller-error)))

(defn print-log-entries (repo remote progress items log)
  (let (entries (:entries log))
    (loop (index 0
           current progress)
      (if (>= index (len entries))
        (ok (assoc current
                   :event-id (max (:event-id current) (latest-id log))))
        (recur (inc index)
               (print-entry repo
                            (clone remote)
                            current items
                            (at entries index)))))))

(defn print-entry (repo remote progress items entry)
  (if (entry-wanted? progress entry)
    (print-wanted-entry repo remote progress items entry)
    progress))

(defn entry-wanted? (progress entry)
  (and (> (:id entry) (:event-id progress))
       (= (:roadmap-id entry) (:roadmap-id progress))))

(type print-wanted-entry
  (fn ((ref str)
       (option string)
       log-progress
       (ref (vec log-item))
       (ref event-entry))
    log-progress))

(defn print-wanted-entry (repo remote progress items entry)
  (let (item (event-item-id (:change entry))
        log-item (log-item-for repo items item)
        last-review (last-review-of progress item)
        fixing-round (fixing-round-for progress (:change entry))
        line (event-line (time-text)
                         last-review fixing-round
                         (:change entry)
                         log-item))
    (do
      (print-event-line remote line)
      (advance-progress progress (:change entry) line))))

(defn print-event-line (remote line)
  (match line
    (none (do))
    ((some item-line)
     (print-lines (render-item (settings-for remote) item-line)))))

(defn log-item-for (repo items item)
  (match (find-item items item)
    ((some found) (clone found))
    (none (read-log-item repo item))))

(type find-item
  (fn ((ref (vec log-item)) (ref string))
    (option (ref log-item))))

(defn find-item (items item)
  (find items
    (fn (found)
      (= (:id (clone found)) item))))

(defn invalid-log (command failure)
  (controller-error/command-failed
    (->action-failure :action (str "log")
                      :item (str "-")
                      :command (clone (:label command))
                      :code 0
                      :detail (str "invalid JSON: "
                                   (event-error->message failure)))))

(defn log-failure (command outcome)
  (controller-error/command-failed (->action-failure
                                     :action (str "log")
                                     :item (str "-")
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))

(defn target-pr (target)
  (match (parse-int-text (clone (:pull-request target)))
    ((ok number)
     (some (->pr-summary :number number
                         :branch (unwrap-or (clone (:branch target))
                                            (str))
                         :head (some (short-head (:head target))))))
    ((err _) none)))

(defn review-pr (pull-request branch head)
  (match (parse-int-text pull-request)
    ((ok number)
     (some (->pr-summary :number number
                         :branch (str branch)
                         :head (some (short-head head)))))
    ((err _) none)))

(defn show-log-item (repo item)
  (let (outcome (execute repo (show-command item)))
    (if (successful? outcome)
      (parse-log-item item (:stdout outcome))
      (err (str)))))

(defn parse-log-item (item text)
  (match (parse-json (as-str text))
    ((ok document)
     (ok (log-item-of-document (str item) document)))
    ((err _) (err (str)))))

(defn log-item-of-document (item document)
  (match (json-field document "item")
    (none (fallback-log-item item))
    ((some record) (log-item-of-record item record document))))

(defn log-item-of-record (item record document)
  (->log-item :id (str item)
              :kind (item-kind-of (optional-text record "kind" "build"))
              :title (optional-text record "title" item)
              :branch (session-branch record)
              :approved (pull-approved document)
              :pull-request (pull-summary record document)))

(defn fallback-log-item (item)
  (->log-item :id (str item)
              :kind item-kind/build
              :title (str item)
              :branch none
              :approved false
              :pull-request none))

(defn pull-approved (document)
  (match (json-field document "pull_request")
    (none false)
    ((some pull) (optional-approved pull))))

(defn optional-approved (pull)
  (match (json-field pull "approved")
    (none false)
    ((some found) (approved-value found))))

(defn approved-value (found)
  (match found
    ((boolean flag) flag)
    (_ false)))

(defn session-branch (item)
  (match (json-field item "session")
    (none none)
    ((some session) (optional-text-option session "branch"))))

(defn pull-summary (item document)
  (match (json-field document "pull_request")
    (none none)
    ((some pull) (pull-summary-of item pull))))

(defn pull-summary-of (item pull)
  (match (optional-number-text pull "number")
    (none none)
    ((some number-text)
     (pull-summary-from-text item pull number-text))))

(defn pull-summary-from-text (item pull number-text)
  (match (parse-int-text (str number-text))
    ((ok number)
     (some (->pr-summary :number number
                         :branch (unwrap-or (session-branch item) (str))
                         :head (head-option pull))))
    ((err _) none)))

(defn head-option (pull)
  (match (optional-text-option pull "head")
    (none none)
    ((some head) (some (short-head head)))))

(defn optional-text (value key default)
  (match (json-field value key)
    (none (str default))
    ((some found) (unwrap-or (json-text found) (str default)))))

(defn optional-text-option (value key)
  (match (json-field value key)
    (none none)
    ((some found) (json-text found))))

(defn optional-number-text (value key)
  (match (json-field value key)
    (none none)
    ((some found) (number-text-found found))))

(defn number-text-found (found)
  (match found
    ((number text) (some (clone text)))
    (_ none)))

(defn parse-int-text (text)
  (the (result int parse-int-error)
       (parse (as-str text))))

(defn show-command (item)
  (->command :program (str "rmap")
             :args (vec (str "item")
                        (str "show")
                        (str item)
                        (str "--json"))
             :label (str "rmap item show " item " --json")))

(defn settings-for (remote)
  (->log-settings :colors (read-color-mode)
                  :width (stderr-width)
                  :target (target-of (stderr-terminal?))
                  :remote (clone remote)))

(defn target-of (terminal)
  (if terminal output-target/terminal output-target/stream))

(defn time-text ()
  (local-time->text (local-time)))

(defn print-lines (lines)
  (loop (index 0)
    (if (>= index (len lines))
      (do)
      (do
        (eprintln (at lines index))
        (recur (inc index))))))
