(module
  "Plans the notices for the actions that wait on the manager or the user.")

(use controller/rules action-kind action-kind->text actor
                      next-line subject)

(export ->notice ->notice-clock ->waiting-action delivery
        notice notice-clock notice-message notice-step owner
        plan-notices stall-message waiting-action
        waiting-actions)

(def seconds-per-minute 60)

(defenum notice-step
  (announce waiting-action)
  (repeat notice)
  (resend notice)
  (keep notice))

(defstruct notice
  :action waiting-action
  :delivery delivery
  :seen-at int
  :told-at int)

(defenum delivery
  delivered
  undelivered)

(defstruct notice-clock
  :now int
  :stall int)

(defstruct waiting-action
  :subject subject
  :kind action-kind
  :owner owner)

(defenum owner
  manager
  user)

(type waiting-actions
  (fn ((ref (vec next-line)))
    (vec waiting-action)))

(defn waiting-actions (lines)
  (reduce lines (vec) with-line-actions))

(type plan-notices
  (fn ((ref (vec notice))
       (ref (vec waiting-action))
       (ref notice-clock))
    (vec notice-step)))

(defn plan-notices (previous waiting clock)
  (collect (map waiting
             (fn (action) (step-for previous action clock)))))

(defn notice-message (action)
  (str (subject-prefix action)
       "waiting for "
       (owner->text (:owner action))
       (read-hint action)))

(type stall-message
  (fn ((ref notice) (ref notice-clock))
    string))

(defn stall-message (sent clock)
  (str (subject-prefix (:action sent))
       "still waiting for "
       (owner->text (:owner (:action sent)))
       " after "
       (waited-minutes sent clock)
       " minutes"
       (read-hint (:action sent))))

(defn with-line-actions (waiting line)
  (reduce (:actions line) waiting
    (fn (found action)
      (with-owned-action found (:subject line) action))))

(defn with-owned-action (waiting subject action)
  (match (owner-of (:actor action))
    ((some owner)
     (with-action! waiting
                   (->waiting-action :subject (clone subject)
                                     :kind (clone (:kind action))
                                     :owner owner)))
    (none waiting)))

(defn with-action! (waiting action)
  (do (push! waiting action) waiting))

(defn owner-of (actor-value)
  (match actor-value
    ((some actor/manager) (some owner/manager))
    ((some actor/user) (some owner/user))
    (_ none)))

(type step-for
  (fn ((ref (vec notice))
       (ref waiting-action)
       (ref notice-clock))
    notice-step))

(defn step-for (previous action clock)
  (match (find previous
           (fn (sent) (notice-of? sent action)))
    ((some sent) (known-step sent clock))
    (none (notice-step/announce (clone action)))))

(defn notice-of? (sent action)
  (= (:action sent) action))

(defn known-step (sent clock)
  (cond
    ((stalled? sent clock) (notice-step/repeat (clone sent)))
    ((undelivered? sent) (notice-step/resend (clone sent)))
    (else (notice-step/keep (clone sent)))))

(defn stalled? (sent clock)
  (>= (- (:now clock) (:told-at sent))
      (:stall clock)))

(defn undelivered? (sent)
  (= (:delivery sent) delivery/undelivered))

(defn waited-minutes (sent clock)
  (/ (- (:now clock) (:seen-at sent))
     seconds-per-minute))

(defn subject-prefix (action)
  (str (action-kind->text (:kind action))
       ": "
       (subject-id (:subject action))
       ": "))

(defn read-hint (action)
  (str ". Read `" (show-text (:subject action)) "`."))

(defn subject-id (subject)
  (match subject
    ((item id) (clone id))
    ((decision id) (clone id))))

(defn owner->text (owner)
  (match owner
    (owner/manager (str "the manager"))
    (owner/user (str "the user"))))

(defn show-text (subject)
  (match subject
    ((item id) (str "rmap item show " id))
    ((decision id) (str "rmap decision show " id))))
