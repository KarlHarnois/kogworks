(module
  "Reads rmap's next, ready and item list JSON into the controller's decisions and counts.")

(use controller/fields field-error->message required-field)
(use controller/json json json-array json-field json-text)

(export action-kind action-kind->text actor
        first-controller-action first-dispatch item-action
        item-kind item-kind-of next-action next-line
        parse-next-response parse-ready-response ready-item
        running-count subject)

(defstruct next-line
  :subject subject
  :actions (vec next-action))

(defenum subject
  (item string)
  (decision string))

(defstruct next-action
  :kind action-kind
  :actor (option actor))

(defenum actor
  controller
  manager
  worker
  user
  (other string))

(defstruct item-action
  :item string
  :kind action-kind)

(defenum action-kind
  work
  dispatch
  review
  verify
  merge
  send-fixes
  wait
  (other string))

(defstruct ready-item
  :id string
  :kind item-kind)

(defenum item-kind
  build
  research
  design
  (other string))

(defenum next-line-step
  (line next-line)
  (failure string)
  done)

(defenum next-action-step
  (action next-action)
  (failure string)
  done)

(defenum line-step
  (found item-action)
  absent
  done)

(defenum controller-action-step
  (found action-kind)
  absent
  done)

(defenum ready-item-step
  (item ready-item)
  (failure string)
  done)

(defn action-kind->text (kind)
  (match kind
    (work (str "work"))
    (dispatch (str "dispatch"))
    (review (str "review"))
    (verify (str "verify"))
    (merge (str "merge"))
    (send-fixes (str "send-fixes"))
    (wait (str "wait"))
    ((other text) (clone text))))

(defn parse-next-response (document)
  (let-try (items (required-array document "next"))
    (parse-next-lines items)))

(defn first-controller-action (lines)
  (loop (index 0)
    (match (line-step-at lines index)
      ((found action) (some action))
      (absent (recur (inc index)))
      (done none))))

(defn parse-ready-response (document)
  (let-try (items (required-array document "ready"))
    (parse-ready-items items)))

(defn running-count (document)
  (match (json-field document "items")
    (none 0)
    ((some found) (count-running found))))

(defn first-dispatch (items)
  (match (first items)
    (none none)
    ((some item) (some (clone item)))))

(defn item-kind-of (text)
  (cond
    ((= text (str "build")) item-kind/build)
    ((= text (str "research")) item-kind/research)
    ((= text (str "design")) item-kind/design)
    (else (item-kind/other text))))

(defn parse-next-lines (items)
  (loop (index 0
         lines (vec))
    (match (next-line-step-at items index)
      ((line line) (recur (inc index) (with-line! lines line)))
      ((failure reason) (err reason))
      (done (ok lines)))))

(defn with-line! (lines line)
  (do (push! lines line) lines))

(defn next-line-step-at (items index)
  (if (>= index (len items))
    next-line-step/done
    (parsed-next-line (parse-next-line (at items index)))))

(defn parsed-next-line (parsed)
  (match parsed
    ((ok line) (next-line-step/line line))
    ((err failure) (next-line-step/failure failure))))

(defn parse-next-line (value)
  (let-try (subject (required-subject value)
            action-values (required-array value "actions")
            actions (parse-next-actions action-values))
    (ok (->next-line :subject subject :actions actions))))

(defn required-subject (value)
  (match (json-field value "decision")
    ((some found) (decision-subject found))
    (none (item-subject value))))

(defn decision-subject (found)
  (let-try (id (field-text found "decision"))
    (ok (subject/decision id))))

(defn item-subject (value)
  (let-try (id (required-text value "item"))
    (ok (subject/item id))))

(defn required-array (value key)
  (let-try (found (required-field-value value key))
    (field-array found key)))

(type required-field-value
  (fn ((ref json) (ref str))
    (result json string)))

(defn required-field-value (value key)
  (map-err (required-field value key key)
           field-error->message))

(defn field-array (found key)
  (match (json-array found)
    ((some items) (ok items))
    (none (err (str "`" (str key) "` is not an array")))))

(defn parse-next-actions (values)
  (loop (index 0
         actions (vec))
    (match (next-action-step-at values index)
      ((action action)
       (recur (inc index) (with-action! actions action)))
      ((failure reason) (err reason))
      (done (ok actions)))))

(defn with-action! (actions action)
  (do (push! actions action) actions))

(defn next-action-step-at (values index)
  (if (>= index (len values))
    next-action-step/done
    (parsed-next-action (parse-next-action (at values index)))))

(defn parsed-next-action (parsed)
  (match parsed
    ((ok action) (next-action-step/action action))
    ((err failure) (next-action-step/failure failure))))

(defn parse-next-action (value)
  (let-try (text (required-text value "action")
            actor-value (optional-actor value))
    (ok (->next-action :kind (action-kind-of text)
                       :actor actor-value))))

(defn action-kind-of (text)
  (cond
    ((= text (str "work")) action-kind/work)
    ((= text (str "dispatch")) action-kind/dispatch)
    ((= text (str "review")) action-kind/review)
    ((= text (str "verify")) action-kind/verify)
    ((= text (str "merge")) action-kind/merge)
    ((= text (str "send-fixes")) action-kind/send-fixes)
    ((= text (str "wait")) action-kind/wait)
    (else (action-kind/other text))))

(defn optional-actor (value)
  (match (json-field value "actor")
    (none (ok none))
    ((some found) (actor-field found))))

(defn actor-field (found)
  (match (json-text found)
    ((some text) (ok (some (actor-of text))))
    (none (err (str "`actor` is not text")))))

(defn actor-of (text)
  (cond
    ((= text (str "controller")) actor/controller)
    ((= text (str "manager")) actor/manager)
    ((= text (str "worker")) actor/worker)
    ((= text (str "user")) actor/user)
    (else (actor/other text))))

(defn line-step-at (lines index)
  (if (>= index (len lines))
    line-step/done
    (line-step-of (at lines index))))

(type line-step-of
  (fn ((ref next-line)) line-step))

(defn line-step-of (line)
  (match (:subject line)
    ((item id) (item-step id (controller-action-in line)))
    ((decision _) line-step/absent)))

(defn item-step (id found)
  (match found
    ((some kind)
     (line-step/found (->item-action :item (clone id) :kind kind)))
    (none line-step/absent)))

(defn controller-action-in (line)
  (loop (index 0)
    (match (action-step-at line index)
      ((found kind) (some kind))
      (absent (recur (inc index)))
      (done none))))

(defn action-step-at (line index)
  (if (>= index (len (:actions line)))
    controller-action-step/done
    (action-step-of (at (:actions line) index))))

(defn action-step-of (action)
  (if (controller-action? action)
    (controller-action-step/found (clone (:kind action)))
    controller-action-step/absent))

(type controller-action?
  (fn ((ref next-action)) bool))

(defn controller-action? (action)
  (and (controller-scope? (:kind action))
       (controller-actor? (:actor action))))

(defn controller-scope? (kind)
  (match kind
    (review true)
    (verify true)
    (merge true)
    (_ false)))

(defn controller-actor? (actor-value)
  (match actor-value
    ((some controller) true)
    (_ false)))

(defn parse-ready-items (values)
  (loop (index 0
         items (vec))
    (match (ready-item-step-at values index)
      ((item item) (recur (inc index) (with-item! items item)))
      ((failure reason) (err reason))
      (done (ok items)))))

(defn with-item! (items item)
  (do (push! items item) items))

(defn ready-item-step-at (values index)
  (if (>= index (len values))
    ready-item-step/done
    (parsed-ready-item (parse-ready-item (at values index)))))

(defn parsed-ready-item (parsed)
  (match parsed
    ((ok item) (ready-item-step/item item))
    ((err failure) (ready-item-step/failure failure))))

(defn parse-ready-item (value)
  (let-try (id (required-text value "id")
            kind-text (required-text value "kind"))
    (ok (->ready-item :id id :kind (item-kind-of kind-text)))))

(defn required-text (value key)
  (let-try (found (required-field-value value key))
    (field-text found key)))

(defn field-text (found key)
  (match (json-text found)
    ((some text) (ok text))
    (none (err (str "`" (str key) "` is not text")))))

(defn count-running (found)
  (match (json-array found)
    (none 0)
    ((some items) (sum (map items running-number)))))

(defn running-number (item)
  (if (running-item? item) 1 0))

(defn running-item? (item)
  (match (json-field item "status")
    (none false)
    ((some found)
     (running-status? (unwrap-or (json-text found) (str))))))

(defn running-status? (text)
  (cond
    ((= text (str "dispatched")) true)
    ((= text (str "reported")) true)
    ((= text (str "in_review")) true)
    ((= text (str "fixing")) true)
    ((= text (str "merging")) true)
    (else false)))
