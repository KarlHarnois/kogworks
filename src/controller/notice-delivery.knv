(module
  "Prints each new notice and each stall line, and sends them to the manager session.")

(use controller/runner-adapter send-command)
(use controller/runner ->send-request)

(use controller/notice ->notice delivery notice notice-clock
                       notice-message notice-step
                       plan-notices stall-message)

(use controller/process execute successful?)

(export ->notice-route notice-route send-notices)

(defstruct notice-route
  :repo string
  :manager string
  :clock notice-clock)

(defn send-notices (route previous waiting)
  (let (steps (plan-notices previous waiting (:clock route)))
    (loop (index 0
           sent (vec))
      (if (>= index (len steps))
        sent
        (recur (inc index)
               (with-step! route sent (at steps index)))))))

(defn with-step! (route sent step)
  (let (taken (take-step route sent step))
    (push! sent taken)
    sent))

(defn take-step (route sent step)
  (match step
    ((keep known) (clone known))
    ((resend known) (resent route sent known))
    ((repeat known) (repeated route sent known))
    ((announce action) (announced route sent action))))

(defn announced (route sent action)
  (let (message (notice-message action))
    (eprintln message)
    (->notice :action (clone action)
              :delivery (delivery-of route sent message)
              :seen-at (:now (:clock route))
              :told-at (:now (:clock route)))))

(defn repeated (route sent known)
  (let (message (stall-message known (:clock route)))
    (eprintln message)
    (->notice :action (clone (:action known))
              :delivery (delivery-of route sent message)
              :seen-at (:seen-at known)
              :told-at (:now (:clock route)))))

(defn resent (route sent known)
  (let (message (latest-message known (:clock route)))
    (->notice :action (clone (:action known))
              :delivery (delivery-of route sent message)
              :seen-at (:seen-at known)
              :told-at (:told-at known))))

(defn latest-message (known clock)
  (if (= (:told-at known) (:seen-at known))
    (notice-message (:action known))
    (stall-message known clock)))

(defn delivery-of (route sent message)
  (if (earlier-send-failed? sent)
    delivery/undelivered
    (send-message route message)))

(type earlier-send-failed?
  (fn ((ref (vec notice))) bool))

(defn earlier-send-failed? (sent)
  (any? sent
    (fn (notice)
      (= (:delivery notice) delivery/undelivered))))

(defn send-message (route message)
  (let (request (->send-request :session (clone (:manager route))
                                :message (clone message))
        command (send-command request)
        outcome (execute (as-str (:repo route)) command))
    (if (successful? outcome)
      delivery/delivered delivery/undelivered)))
