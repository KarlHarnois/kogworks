(module
  "Starts a fresh reviewer for a build that rmap marks for review or verify.")

(use controller/brief ->reviewer-values fill-brief
                      reviewer-brief)

(use controller/failure ->action-failure controller-error)
(use controller/factory factory-config role)

(use controller/item criteria->text design-approval
                     item-detail item-error->message
                     parse-item-detail)

(use controller/json json-error->message parse-json)

(use controller/process ->command command-detail execute
                        join-path successful?)

(use controller/repo default-branch)
(use controller/session abandon-command failed-start-detail)

(export design-review-gate review-mode review-mode->text
        start-review started-review)

(defenum review-mode
  review
  verify
  design)

(defstruct started-review
  :session string
  :detail item-detail)

(defn review-mode->text (mode)
  (match mode
    (verify (str "verify"))
    (_ (str "review"))))

(defn start-review (repo config item mode)
  (match (show-item repo mode item)
    ((err failure) (err failure))
    ((ok detail)
     (start-review-with-role repo config item mode
                             (:reviewer config)
                             detail))))

(defn design-review-gate (repo config item role)
  (match (show-item repo review-mode/design item)
    ((err failure) (err failure))
    ((ok detail)
     (approved-or-started repo config item role detail))))

(defn approved-or-started (repo config item role detail)
  (match (:design-approval detail)
    (design-approval/design-approved (ok none))
    (design-approval/design-missing
      (match (start-review-with-role repo config item
                                     review-mode/design role
                                     detail)
        ((ok started) (ok (some started)))
        ((err failure) (err failure))))))

(defn show-item (repo mode item)
  (let (command (show-command item))
    (let (outcome (execute repo command))
      (if (successful? outcome)
        (parse-item-output mode item command (:stdout outcome))
        (err (command-failure mode item command outcome))))))

(defn parse-item-output (mode item command text)
  (match (parse-json (as-str text))
    ((ok document)
     (item-detail-result mode item command document))
    ((err failure)
     (err (invalid-item-output mode item command
                               (json-error->message failure))))))

(defn item-detail-result (mode item command document)
  (match (parse-item-detail document)
    ((ok detail) (ok detail))
    ((err failure)
     (err (invalid-item-output mode item command
                               (item-error->message failure))))))

(defn start-review-with-role (repo config item mode role detail)
  (match (default-branch repo)
    ((err failure) (err failure))
    ((ok base)
     (begin-review repo config item mode role detail base))))

(type begin-review
  (fn ((ref str)
       (ref factory-config)
       (ref string)
       review-mode
       (ref role)
       (ref item-detail)
       (ref string))
    (result started-review controller-error)))

(defn begin-review (repo config item mode role detail base)
  (let (session (reviewer-session item mode (clone (:head detail))))
    (match (reviewer-prompt repo config item mode role
                            (clone detail)
                            session base)
      ((err failure) (err failure))
      ((ok prompt)
       (start-review-session repo item mode role
                             (clone detail)
                             session prompt)))))

(type reviewer-session
  (fn ((ref string) review-mode (ref string))
    string))

(defn reviewer-session (item mode head)
  (match mode
    (design (str "design-" item "-" (head-prefix head)))
    (_ (str "review-" item "-" (head-prefix head)))))

(type head-prefix
  (fn ((ref str)) string))

(defn head-prefix (head)
  (join (collect (map (take (chars head) 7)
                   (fn (character) (str character))))
        ""))

(type reviewer-prompt
  (fn ((ref str)
       (ref factory-config)
       (ref string)
       review-mode
       (ref role)
       item-detail
       (ref string)
       (ref string))
    (result string controller-error)))

(defn reviewer-prompt (repo config item mode role detail session base)
  (let (path (join-path repo (as-str (:brief role))))
    (let (values (->reviewer-values :item (clone item)
                                    :roadmap (clone (:roadmap config))
                                    :session (clone session)
                                    :pr (clone (:pr detail))
                                    :head (clone (:head detail))
                                    :criteria (criteria->text (:criteria
                                                                detail))
                                    :base (clone base)
                                    :skill (clone (:skill role))
                                    :manager (clone (:manager config))))
      (match (fill-brief (as-str path) (reviewer-brief values))
        ((err failure) (err failure))
        ((ok prompt) (ok (stressed-prompt mode prompt)))))))

(defn stressed-prompt (mode prompt)
  (match mode
    (verify (verify-stress prompt))
    (_ (clone prompt))))

(defn verify-stress (prompt)
  (str "Verify action: the head is approved, but at least one acceptance "
       "criterion has no verdict on it. Record every missing "
       "`rmap item verify` verdict before `rmap pr review`.\n\n"
       prompt))

(type start-review-session
  (fn ((ref str)
       (ref string)
       review-mode
       (ref role)
       item-detail
       (ref string)
       (ref string))
    (result started-review controller-error)))

(defn start-review-session (repo item mode role detail session prompt)
  (let (start (review-start-command item session))
    (let (outcome (execute repo start))
      (if (successful? outcome)
        (start-reviewer repo item mode role
                        (clone detail)
                        session prompt)
        (err (command-failure mode item start outcome))))))

(type start-reviewer
  (fn ((ref str)
       (ref string)
       review-mode
       (ref role)
       item-detail
       (ref string)
       (ref string))
    (result started-review controller-error)))

(defn start-reviewer (repo item mode role detail session prompt)
  (let (start (reviewer-start-command repo role session
                                      (clone (:branch detail))
                                      prompt))
    (let (outcome (execute repo start))
      (if (successful? outcome)
        (reviewer-started session detail)
        (abandon-and-fail repo item mode session start outcome)))))

(defn reviewer-started (session detail)
  (ok (->started-review :session (clone session)
                        :detail (clone detail))))

(defn abandon-and-fail (repo item mode session start outcome)
  (let (abandon (abandon-command session))
    (let (end-outcome (execute repo abandon))
      (err (start-failure mode item start outcome end-outcome)))))

(defn start-failure (mode item start outcome end-outcome)
  (controller-error/command-failed
    (->action-failure :action (review-mode->text mode)
                      :item (clone item)
                      :command (clone (:label start))
                      :code (:code outcome)
                      :detail (failed-start-detail outcome end-outcome))))

(defn command-failure (mode item command outcome)
  (controller-error/command-failed (->action-failure
                                     :action (review-mode->text mode)
                                     :item (clone item)
                                     :command (clone (:label command))
                                     :code (:code outcome)
                                     :detail (command-detail outcome))))

(defn invalid-item-output (mode item command reason)
  (controller-error/command-failed
    (->action-failure :action (review-mode->text mode)
                      :item (clone item)
                      :command (clone (:label command))
                      :code 0
                      :detail (str "invalid item JSON: " reason))))

(defn show-command (item)
  (->command :program (str "rmap")
             :args (vec (str "item")
                        (str "show")
                        (clone item)
                        (str "--json"))
             :label (str "rmap item show " item " --json")))

(defn review-start-command (item session)
  (->command :program (str "rmap")
             :args (vec (str "review")
                        (str "start")
                        (clone item)
                        (str "--session")
                        (clone session))
             :label (str "rmap review start " item " --session " session)))

(defn reviewer-start-command (repo role session branch prompt)
  (let (agent (:agent role))
    (->command :program (str "ringleader")
               :args (vec (str "new")
                          (str "--name")
                          (clone session)
                          (str "--repo")
                          (str repo)
                          (str "--agent")
                          (clone agent)
                          (str "--base-branch")
                          (clone branch)
                          (str "--prompt")
                          (clone prompt))
               :label (str "ringleader new --name " session
                           " --repo " repo " --agent " agent
                           " --base-branch " branch
                           " --prompt <filled brief>"))))
