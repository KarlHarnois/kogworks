(module
  "Names the failures the controller reports to its manager.")

(use controller/fields field-error field-error->message)
(use controller/signal stop-signal stop-signal->text)

(export ->action-failure ->failure-report
        ->signal-stop-report action-failure controller-error
        disarm-status error->message factory-error
        factory-error->message failure-report
        manager-message? merge-error merge-error->message
        signal-stop->log-text signal-stop-report)

(defstruct failure-report
  :manager (option string)
  :error controller-error)

(defenum controller-error
  (command-failed action-failure)
  (out-of-scope action-failure)
  (factory-failed factory-error)
  (merge-failed merge-error)
  (signal-stop signal-stop-report)
  (unreadable-brief string string)
  (unreadable-repo string string)
  (placeholder-left string string))

(defstruct signal-stop-report
  :item string
  :pull-request-number string
  :signal stop-signal
  :disarm disarm-status)

(defenum disarm-status
  disarmed
  (not-disarmed int string))

(defenum factory-error
  (missing-factory string)
  (unreadable-factory string string)
  (malformed-factory string string)
  (field field-error)
  (unsupported-merge-method string))

(defenum merge-error
  (settings-refused string string)
  (head-changed string string string string)
  (item-fixing string string)
  (not-approved string string string)
  (timed-out string string int))

(defstruct action-failure
  :action string
  :item string
  :command string
  :code int
  :detail string)

(defn manager-message? (failure)
  (match failure
    ((signal-stop _) false)
    (_ true)))

(defn error->message (failure)
  (match failure
    ((command-failed report) (command-failure->message report))
    ((out-of-scope report)
     (str "controller: "
          (:action report)
          " action for "
          (:item report)
          " is out of scope in this build; `"
          (:command report)
          "` exited "
          (:code report)
          " and no session started"))
    ((factory-failed cause)
     (str "controller: " (factory-error->message cause)))
    ((merge-failed cause) (merge-error->message cause))
    ((signal-stop report) (signal-stop->message report))
    ((unreadable-brief path reason)
     (str "controller: cannot read the brief " path ": " reason))
    ((unreadable-repo path reason)
     (str "controller: cannot resolve the repository " path
          ": " reason))
    ((placeholder-left item token)
     (str "controller: " item ": the brief still holds `"
          token "` after filling"))))

(defn factory-error->message (failure)
  (match failure
    ((missing-factory path) (str "no factory at " path))
    ((unreadable-factory path reason)
     (str "cannot read " path ": " reason))
    ((malformed-factory path reason)
     (str "cannot parse " path ": " reason))
    ((field cause)
     (str "the factory field " (field-error->message cause)))
    ((unsupported-merge-method method)
     (str "the factory merge method `" method
          "` is not supported"))))

(defn merge-error->message (failure)
  (match failure
    ((settings-refused item detail)
     (str "merge: " item ": " detail))
    ((head-changed item pull-request approved observed)
     (str "merge: " item ": PR " pull-request " head is "
          observed ", not the approved " approved))
    ((item-fixing item pull-request)
     (str "merge: " item
          ": the item is fixing, so auto-merge on PR "
          pull-request " is disarmed"))
    ((not-approved item pull-request head)
     (str "merge: " item ": PR " pull-request
          " is not approved at head " head))
    ((timed-out item pull-request seconds)
     (str "merge: " item ": PR " pull-request
          " did not merge within " seconds " seconds"))))

(defn signal-stop->log-text (report)
  (str "PR "
       (:pull-request-number report)
       " stopped on "
       (stop-signal->text (:signal report))
       "; auto-merge "
       (disarm-status->text (:pull-request-number report)
                            (:disarm report))))

(defn signal-stop->message (report)
  (str "merge: "
       (:item report)
       ": PR "
       (:pull-request-number report)
       " stopped on "
       (stop-signal->text (:signal report))
       "; auto-merge "
       (disarm-status->text (:pull-request-number report)
                            (:disarm report))))

(defn disarm-status->text (pull-request status)
  (match status
    (disarmed (str "is disarmed"))
    ((not-disarmed code detail)
     (str "is not disarmed: `gh pr merge " pull-request
          " --disable-auto` exited " code
          (detail-suffix detail)))))

(defn detail-suffix (detail)
  (if (empty? detail)
    (str)
    (str ": " detail)))

(defn command-failure->message (failure)
  (let (detail (:detail failure))
    (if (empty? detail)
      (str (:action failure)
           ": "
           (:item failure)
           ": `"
           (:command failure)
           "` exited "
           (:code failure))
      (str (:action failure)
           ": "
           (:item failure)
           ": `"
           (:command failure)
           "` exited "
           (:code failure)
           ": " detail))))
