(module
  "Reads the item detail that rmap prints for a review.")

(use controller/json json json-array json-field json-object?
                     json-text)

(export ->item-detail criteria->text item-detail
        parse-item-detail)

(defstruct item-detail
  :pr string
  :head string
  :branch string
  :criteria (vec string))

(type required-field
  (fn ((ref json) (ref str) (ref str))
    (result json string)))

(defn required-field (value key path)
  (match (json-field value key)
    (none (err (str "missing `" (str path) "`")))
    ((some found) (ok found))))

(type required-object
  (fn ((ref json) (ref str) (ref str))
    (result json string)))

(defn required-object (value key path)
  (let-try (found (required-field value key path))
    (if (json-object? found)
      (ok found)
      (err (str "`" (str path) "` is not an object")))))

(type required-text
  (fn ((ref json) (ref str) (ref str))
    (result string string)))

(defn required-text (value key path)
  (let-try (found (required-field value key path))
    (match (json-text found)
      ((some text) (ok text))
      (none (err (str "`" (str path) "` is not text"))))))

(type required-number
  (fn ((ref json) (ref str) (ref str))
    (result string string)))

(defn required-number (value key path)
  (let-try (found (required-field value key path))
    (match found
      ((number text) (ok (clone text)))
      (_ (err (str "`" (str path) "` is not a number"))))))

(type required-criteria
  (fn ((ref json))
    (result (vec string) string)))

(defn required-criteria (item)
  (let-try (found (required-field item "criteria" "item.criteria"))
    (match (json-array found)
      ((some items) (criterion-texts items 0 (vec)))
      (none (err (str "`item.criteria` is not an array"))))))

(type criterion-texts
  (fn ((ref (vec json)) int (vec string))
    (result (vec string) string)))

(defn criterion-texts (items index texts)
  (if (>= index (len items))
    (checked-criteria texts)
    (let-try (text (criterion-text (at items index) index))
      (criterion-texts items (inc index) (with-text! texts text)))))

(type checked-criteria
  (fn ((vec string))
    (result (vec string) string)))

(defn checked-criteria (texts)
  (if (empty? texts)
    (err (str "`item.criteria` is empty"))
    (ok texts)))

(type criterion-text
  (fn ((ref json) int)
    (result string string)))

(defn criterion-text (value index)
  (match (json-text value)
    ((some text) (ok text))
    (none (err (str "`item.criteria[" index "]` is not text")))))

(type with-text!
  (fn ((vec string) string) (vec string)))

(defn with-text! (texts text)
  (do (push! texts text) texts))

(type parse-item-detail
  (fn ((ref json))
    (result item-detail string)))

(defn parse-item-detail (document)
  (let-try (item (required-object document "item" "item"))
    (let-try (pull (required-object document "pull_request" "pull_request"))
      (let-try (pr (required-number pull "number" "pull_request.number"))
        (let-try (head (required-text pull "head" "pull_request.head"))
          (let-try (session (required-object item "session" "item.session"))
            (let-try (branch (required-text session "branch"
                                            "item.session.branch"))
              (let-try (criteria (required-criteria item))
                (ok (->item-detail :pr pr
                                   :head head
                                   :branch branch
                                   :criteria criteria))))))))))

(type criteria->text
  (fn ((ref (vec string))) string))

(defn criteria->text (criteria)
  (join (collect (map (range 0 (len criteria))
                   (fn (index)
                     (str "("
                          (inc index)
                          ") "
                          (clone (at criteria index))))))
        "; "))
