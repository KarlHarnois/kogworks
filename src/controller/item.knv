(module
  "Reads the item detail that rmap prints for a review.")

(use controller/fields field-error field-error->message
                       required-field required-number
                       required-object required-text)

(use controller/json json json-array json-field json-text)

(export ->item-detail criteria->text design-approval
        item-detail item-error item-error->message
        parse-item-detail)

(defstruct item-detail
  :pr string
  :head string
  :branch string
  :criteria (vec string)
  :title string
  :kind string
  :design-approval design-approval)

(defenum design-approval
  design-approved
  design-missing)

(defenum item-error
  (field field-error)
  (non-array-criteria string)
  (empty-criteria string)
  (non-text-criterion int))

(defn item-error->message (failure)
  (match failure
    ((field cause) (field-error->message cause))
    ((non-array-criteria path)
     (str "`" path "` is not an array"))
    ((empty-criteria path) (str "`" path "` is empty"))
    ((non-text-criterion index)
     (str "`item.criteria[" index "]` is not text"))))

(type parse-item-detail
  (fn ((ref json))
    (result item-detail item-error)))

(defn parse-item-detail (document)
  (let-try (item (required-object document "item" "item")
            pull (required-object document "pull_request" "pull_request")
            pr (required-number pull "number" "pull_request.number")
            head (required-text pull "head" "pull_request.head")
            session (required-object item "session" "item.session")
            branch (required-text session "branch" "item.session.branch")
            criteria (required-criteria item))
    (ok (->item-detail :pr pr
                       :head (clone head)
                       :branch branch
                       :criteria criteria
                       :title (optional-text item "title" "")
                       :kind (optional-text item "kind" "build")
                       :design-approval (design-approval-of pull head)))))

(type criteria->text
  (fn ((ref (vec string))) string))

(defn criteria->text (criteria)
  (join (collect (map (range 0 (len criteria))
                   (fn (index)
                     (str "("
                          (inc index)
                          ") "
                          (clone (at criteria index))))))
        "; "))

(type required-criteria
  (fn ((ref json))
    (result (vec string) item-error)))

(defn required-criteria (item)
  (let-try (found (required-field item "criteria" "item.criteria"))
    (match (json-array found)
      ((some items) (criterion-texts items 0 (vec)))
      (none (err (item-error/non-array-criteria (str "item.criteria")))))))

(defn optional-text (value key default)
  (match (json-field value key)
    (none (str default))
    ((some found) (unwrap-or (json-text found) (str default)))))

(defn criterion-texts (items index texts)
  (if (>= index (len items))
    (checked-criteria texts)
    (let-try (text (criterion-text (at items index) index))
      (criterion-texts items (inc index) (with-text! texts text)))))

(defn checked-criteria (texts)
  (if (empty? texts)
    (err (item-error/empty-criteria (str "item.criteria")))
    (ok texts)))

(defn criterion-text (value index)
  (match (json-text value)
    ((some text) (ok text))
    (none (err (item-error/non-text-criterion index)))))

(defn with-text! (texts text)
  (do (push! texts text) texts))

(defn design-approval-of (pull head)
  (match (json-field pull "reviews")
    (none design-approval/design-missing)
    ((some value) (reviews-design-approval value head))))

(defn reviews-design-approval (value head)
  (match (json-array value)
    (none design-approval/design-missing)
    ((some reviews) (design-approval-among reviews head 0))))

(defn design-approval-among (reviews head index)
  (cond
    ((>= index (len reviews)) design-approval/design-missing)
    ((approving-design-review? (at reviews index) head)
     design-approval/design-approved)
    (else (design-approval-among reviews head (inc index)))))

(defn approving-design-review? (review head)
  (and (review-field-is? review "kind" (str "design"))
       (review-field-is? review "verdict" (str "approve"))
       (review-field-is? review "head" head)))

(defn review-field-is? (review key expected)
  (match (json-field review key)
    (none false)
    ((some value) (text-is? value expected))))

(defn text-is? (value expected)
  (match (json-text value)
    ((some text) (= text (as-str expected)))
    (none false)))
