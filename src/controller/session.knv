(module
  "Ends a session that started but could not run.")

(use controller/process ->command command-detail
                        successful?)

(export abandon-command failed-start-detail)

(defn abandon-command (session)
  (->command :program (str "rmap")
             :args (vec (str "session")
                        (str "end")
                        (clone session)
                        (str "--reason")
                        (str "abandoned"))
             :label (str "rmap session end " session " --reason abandoned")))

(defn failed-start-detail (outcome end-outcome)
  (let (detail (command-detail outcome))
    (if (successful? end-outcome)
      detail
      (str detail "; session end exited "
           (:code end-outcome)
           ": "
           (command-detail end-outcome)))))
