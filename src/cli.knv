(use knave-commandant defcli defcommand)

(export kogworks-command kogworks-spec matches->kogworks)

(defcommand synth "Writes <dir>/factory.json." (dir string))

(defcommand check "Checks <dir>/factory.knv without writing <dir>/factory.json."
  (dir string))

(defcommand module "Writes the module." (dir string))

(defcommand format "Writes the shape module." (dir string))

(defcommand controller "Runs the controller loop against a governed repository. It polls rmap and starts the worker for the first startable build, and starts one behavior reviewer when rmap marks a build for review or verify. It exits 1 on the first failure. A person reads the manager message and restarts it. The controller can merge pull requests that change the controller itself; the running binary stays at the version it was built from, and a person rebuilds and restarts it after such a merge. It has no automatic restart, supervisor or backoff loop. The pilot pins rmap to a build before rm-9dff, so a behavior approve alone merges and the controller starts no design reviewer."
  (:repo string
         :required true
         :value-name path
         :about "The governed repository")
  (:poll u32
         :default 30
         :about "Seconds to wait between passes")
  (:merge-poll u32
               :default 30
               :about "Seconds to wait between merge polls")
  (:merge-timeout u32
                  :default 3600
                  :about "Seconds to wait for a merge")
  (:merge-retry-delay u32
                      :default 2
                      :about "Seconds to wait between merge retries")
  (:once switch :about "Runs one pass and exits"))

(defcommand apply "Sets a governed repository's roadmap max active from its factory."
  (:repo string
         :required true
         :value-name path
         :about "The governed repository"))

(defcli kogworks "Factory."
  (commands synth check module format controller apply))
