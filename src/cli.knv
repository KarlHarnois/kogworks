(use knave-commandant defcli defcommand)

(export kogworks-command kogworks-spec matches->kogworks)

(defcommand synth "Writes <dir>/factory.json." (dir string))

(defcommand check "Checks <dir>/factory.knv without writing <dir>/factory.json."
  (dir string))

(defcommand controller "Runs the controller loop against a governed repository. At start it sets the roadmap's max active to the factory's max_active, once. It polls rmap and starts the worker for the first startable item, whatever its kind, and starts one behavior reviewer when rmap marks a build for review or verify. It sends the manager one notice for each action that waits on the manager or the user, and sends it again after each --stall seconds while the action still waits. It exits 1 on the first failure. A person reads the manager message and restarts it. The controller can merge pull requests that change the controller itself; the running binary stays at the version it was built from, and a person rebuilds and restarts it after such a merge. It has no automatic restart, supervisor or backoff loop. The pilot pins rmap to a build that predates the design approval requirement, so a behavior approve alone merges and the controller starts no design reviewer. A factory that names a `design-reviewer` role starts a design reviewer once rmap lists merge and no design approve stands on the current head, and merges only once that approve is on the head. A factory without that role merges on the behavior review alone."
  (:repo string
         :required true
         :value-name path
         :about "The governed repository")
  (:poll u32
         :default 30
         :about "Seconds to wait between passes")
  (:stall u32
          :default 900
          :about "Seconds an action waits before its notice is sent again")
  (:merge-poll u32
               :default 30
               :about "Seconds to wait between merge polls")
  (:merge-timeout u32
                  :default 3600
                  :about "Seconds to wait for a merge")
  (:merge-retry-delay u32
                      :default 2
                      :about "Seconds to wait between merge retries")
  (:once switch :about "Runs one pass and exits"))

(defcommand apply "Sets a governed repository's roadmap max active from its factory."
  (:repo string
         :required true
         :value-name path
         :about "The governed repository"))

(defcli kogworks "Factory."
  (commands synth check controller apply))
