(use factory/types merge-method role role-name->text
                   runner->text)

(export factory->json)

(def character-escapes
  (vec (->character-escape :character (char "\"")
                           :text (str "\\\""))
       (->character-escape :character (char "\\")
                           :text (str "\\\\"))
       (->character-escape :character (char "\n")
                           :text (str "\\n"))
       (->character-escape :character (char "\r")
                           :text (str "\\r"))
       (->character-escape :character (char "\t")
                           :text (str "\\t"))
       (->character-escape :character (char "\u{8}")
                           :text (str "\\b"))
       (->character-escape :character (char "\u{c}")
                           :text (str "\\f"))))

(def hex-digits
  (vec (char "0")
       (char "1")
       (char "2")
       (char "3")
       (char "4")
       (char "5")
       (char "6")
       (char "7")
       (char "8")
       (char "9")
       (char "a")
       (char "b")
       (char "c")
       (char "d")
       (char "e")
       (char "f")))

(def character->code
  (rust "{0} as i64" (fn (char) int)))

(defstruct character-escape
  :character char
  :text string)

(defn factory->json (factory)
  (str "{\n  \"schema\": "
       (:schema factory)
       ",\n  \"name\": "
       (text->json (:name factory))
       ",\n  \"manager\": "
       (text->json (:manager factory))
       ",\n  \"roadmap\": "
       (text->json (:roadmap factory))
       ",\n  \"max_active\": "
       (:max-active factory)
       ",\n  \"merge\": "
       (text->json (merge-method->text (:merge factory)))
       ",\n  \"runner\": "
       (text->json (runner->text (:runner factory)))
       ",\n  \"roles\": "
       (roles->json (:roles factory))
       "\n}\n"))

(type roles->json
  (fn ((ref (vec role))) string))

(defn roles->json (roles)
  (if (empty? roles)
    (str "{}")
    (str "{\n"
         (-> roles (map role-entry->json) collect (join ",\n"))
         "\n  }")))

(defn role-entry->json (role)
  (str "    "
       (text->json (role-name->text (:name role)))
       ": "
       (role->json (clone role))))

(type role->json (fn (role) string))

(defn role->json (role)
  (str "{\n      \"agent\": "
       (text->json (:agent role))
       ",\n      \"skill\": "
       (text->json (:skill role))
       ",\n      \"brief\": "
       (text->json (:brief role))
       "\n    }"))

(defn merge-method->text (method)
  (match method (gh-auto (str "gh-auto"))))

(defn text->json (text)
  (str "\""
       (-> text as-str chars
           (map character->json)
           collect
           (join ""))
       "\""))

(defn character->json (character)
  (match (find character-escapes
           (fn (escape)
             (= (:character escape) character)))
    ((some escape) (clone (:text escape)))
    (none (unnamed-character->json character))))

(defn unnamed-character->json (character)
  (if (control-character? character)
    (control-character->json character)
    (str character)))

(defn control-character? (character)
  (< (character->code character) 32))

(defn control-character->json (character)
  (let (code (character->code character))
    (str "\\u00"
         (hex-digit->text (/ code 16))
         (hex-digit->text (rem code 16)))))

(defn hex-digit->text (digit)
  (str (deref (at hex-digits digit))))
