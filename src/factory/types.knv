(export ->factory ->role factory merge-method role role-name
        role-name->text runner runner->text)

(defstruct factory
  :schema int
  :name string
  :manager string
  :roadmap string
  :max-active int
  :merge merge-method
  :runner runner
  :roles (vec role))

(defenum merge-method gh-auto)

(defenum runner ringleader)

(defstruct role
  :name role-name
  :agent string
  :skill string
  :brief string)

(defenum role-name
  worker
  reviewer)

(defn role-name->text (name)
  (match name
    (worker (str "worker"))
    (reviewer (str "reviewer"))))

(defn runner->text (runner)
  (match runner (ringleader (str "ringleader"))))
