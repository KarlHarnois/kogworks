(export ->factory ->role factory merge-method role
        role-name)

(defenum merge-method gh-auto)

(defenum role-name
  worker
  reviewer)

(defstruct role
  :name role-name
  :agent string
  :skill string
  :brief string)

(defstruct factory
  :schema int
  :name string
  :manager string
  :roadmap string
  :max-active int
  :merge merge-method
  :roles (vec role))
