(export error->message factory-format-module
        factory-format-module-text factory-module
        factory-module-text synth-error synth-factory)

(def deffactory-import
  (str "(use kogworks/factory/deffactory deffactory) "))

(def deffactory-format-import
  (str "(use kogworks/factory/deffactory deffactory)\n\n"))

(def join-path
  (rust "std::path::Path::new({0}).join({1}).to_string_lossy().into_owned()"
    (fn ((ref str) (ref str)) string)))

(def holds-file?
  (rust "std::path::Path::new({0}).is_file()"
    (fn ((ref str)) bool)))

(def read-text
  (rust "std::fs::read_to_string({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result string string))))

(def write-text
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(def run-knave-eval
  (rust "{{
    use std::io::Write;
    std::process::Command::new(\"knave\")
      .args([\"eval\", \"--stdin\", {0}, \"(do (print (factory-json)) (exit 0))\"])
      .stdin(std::process::Stdio::piped())
      .stdout(std::process::Stdio::piped())
      .stderr(std::process::Stdio::piped())
      .spawn()
      .map_err(|error| error.to_string())
      .and_then(|mut child| {{
        let mut input = child
          .stdin
          .take()
          .ok_or_else(|| \"knave did not open standard input\".to_string())?;
        input
          .write_all({1}.as_bytes())
          .map_err(|error| error.to_string())?;
        drop(input);
        child.wait_with_output().map_err(|error| error.to_string())
      }})
  }}"
    (fn ((ref str) (ref str))
      (result process-output string))))

(def succeeded?
  (rust "{0}.status.success()"
    (fn ((ref process-output)) bool)))

(def output-text
  (rust "String::from_utf8_lossy({0}.stdout.as_slice()).into_owned()"
    (fn ((ref process-output)) string)))

(def output-failure
  (rust "String::from_utf8_lossy({0}.stderr.as_slice()).trim().to_owned()"
    (fn ((ref process-output)) string)))

(defenum synth-error
  (missing-factory string)
  (unreadable-factory string string)
  (factory-eval-failed string string)
  (unwritable-factory-json string string))

(defenum factory-module-layout
  inline
  separated)

(deftype process-output (rust "std::process::Output"))

(defn error->message (failure)
  (match failure
    ((missing-factory path) (str "no factory at " path))
    ((unreadable-factory path reason)
     (str "cannot read " path ": " reason))
    ((factory-eval-failed path reason)
     (str "cannot evaluate " path ": " reason))
    ((unwritable-factory-json path reason)
     (str "cannot write " path ": " reason))))

(defn factory-module-text (factory-text)
  (str deffactory-import factory-text))

(defn factory-format-module-text (factory-text)
  (str deffactory-format-import factory-text))

(defn factory-format-module (directory)
  (factory-module-in directory
                     factory-module-layout/separated))

(defn synth-factory (directory)
  (let (factory-file (join-path directory "factory.knv"))
    (let-try (module-text (factory-module directory))
      (let-try (json (eval-factory-json (as-str factory-file)
                                        (as-str module-text)))
        (write-factory-json (as-str (join-path directory "factory.json"))
                            (as-str json))))))

(defn factory-module (directory)
  (factory-module-in directory factory-module-layout/inline))

(defn eval-factory-json (factory-file module-text)
  (match (run-knave-eval factory-file module-text)
    ((ok output) (checked-factory-json factory-file output))
    ((err reason)
     (err (synth-error/factory-eval-failed (str factory-file) reason)))))

(defn checked-factory-json (factory-file output)
  (match (succeeded? output)
    (true (ok (output-text output)))
    (false (err (synth-error/factory-eval-failed (str factory-file)
                                                 (output-failure output))))))

(defn write-factory-json (json-file json)
  (match (write-text json-file json)
    ((ok _) (ok (str json-file)))
    ((err reason)
     (err (synth-error/unwritable-factory-json (str json-file) reason)))))

(defn factory-module-in (directory layout)
  (let (factory-file (join-path directory "factory.knv"))
    (if (holds-file? (as-str factory-file))
      (factory-file->module (as-str factory-file) layout)
      (err (synth-error/missing-factory (str factory-file))))))

(defn factory-file->module (factory-file layout)
  (match (read-text factory-file)
    ((ok factory-text) (ok (module-text layout factory-text)))
    ((err reason)
     (err (synth-error/unreadable-factory (str factory-file) reason)))))

(defn module-text (layout factory-text)
  (match layout
    (inline (factory-module-text factory-text))
    (separated (factory-format-module-text factory-text))))
