(export error->message factory-format-module-text
        factory-module factory-module-text synth-error
        synth-factory)

(def deffactory-import
  (str "(use kogworks/factory/deffactory deffactory) "))

(def deffactory-format-import
  (str "(use kogworks/factory/deffactory deffactory)\n\n"))

(def join-path
  (rust "std::path::Path::new({0}).join({1}).to_string_lossy().into_owned()"
    (fn ((ref str) (ref str)) string)))

(def parent-path
  (rust "std::path::Path::new({0}).parent().map(|path| path.to_string_lossy().into_owned()).unwrap_or_default()"
    (fn ((ref str)) string)))

(def holds-file?
  (rust "std::path::Path::new({0}).is_file()"
    (fn ((ref str)) bool)))

(def read-text
  (rust "std::fs::read_to_string({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result string string))))

(def write-text
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(def run-knave-run
  (rust "{{
  (|| -> Result<std::process::Output, String> {{
    let factory_dir = {0};
    let factory_path = {1};
    let module_text = {2};
    let start = std::path::Path::new(factory_path)
      .canonicalize()
      .map_err(|error| error.to_string())?;
    let mut root = start.parent();
    while let Some(dir) = root {{
      if dir.join(\"project.knv\").is_file() {{
        break;
      }}
      root = dir.parent();
    }}
    let root = root.ok_or_else(|| \"cannot find the project root\".to_string())?;
    let temp_root = root
      .join(\"target\")
      .join(\"knave\")
      .join(\"synth\")
      .join(std::process::id().to_string());
    std::fs::create_dir_all(&temp_root).map_err(|error| error.to_string())?;
    let temp_file = temp_root.join(\"factory.knv\");
    let mut program = String::from(module_text);
    program.push_str(\"\\n\\n(defn main () (print (factory-json)))\\n\");
    std::fs::write(&temp_file, program).map_err(|error| error.to_string())?;
    let output = std::process::Command::new(\"knave\")
      .args([\"run\", temp_file.to_str().unwrap_or_default()])
      .current_dir(factory_dir)
      .output()
      .map_err(|error| error.to_string());
    let _ = std::fs::remove_dir_all(&temp_root);
    let mut output = output?;
    let temp_text = temp_file.to_string_lossy().into_owned();
    let stderr = String::from_utf8_lossy(&output.stderr).into_owned();
    if stderr.contains(&temp_text) {{
      output.stderr = stderr.replace(&temp_text, factory_path).into_bytes();
    }}
    Ok(output)
  }})()
}}"
    (fn ((ref str) (ref str) (ref str))
      (result process-output string))))

(def succeeded?
  (rust "{0}.status.success()"
    (fn ((ref process-output)) bool)))

(def output-text
  (rust "String::from_utf8_lossy({0}.stdout.as_slice()).into_owned()"
    (fn ((ref process-output)) string)))

(def output-failure
  (rust "String::from_utf8_lossy({0}.stderr.as_slice()).trim().to_owned()"
    (fn ((ref process-output)) string)))

(defenum synth-error
  (missing-factory string)
  (unreadable-factory string string)
  (factory-eval-failed string string)
  (unwritable-factory-json string string))

(deftype process-output (rust "std::process::Output"))

(defn error->message (failure)
  (match failure
    ((missing-factory path) (str "no factory at " path))
    ((unreadable-factory path reason)
     (str "cannot read " path ": " reason))
    ((factory-eval-failed path reason)
     (str "cannot evaluate " path ": " reason))
    ((unwritable-factory-json path reason)
     (str "cannot write " path ": " reason))))

(defn factory-module-text (factory-text)
  (str deffactory-import factory-text))

(defn factory-format-module-text (factory-text)
  (str deffactory-format-import factory-text))

(defn synth-factory (dir)
  (let (factory-file (join-path dir "factory.knv")
        module-text (try (factory-module dir))
        json (try (eval-factory-json (as-str factory-file)
                                     (as-str module-text)))
        json-path (join-path dir "factory.json"))
    (write-factory-json (as-str json-path) (as-str json))))

(defn factory-module (dir)
  (let (factory-file (join-path dir "factory.knv"))
    (if (holds-file? (as-str factory-file))
      (factory-file->module (as-str factory-file))
      (err (synth-error/missing-factory (str factory-file))))))

(defn eval-factory-json (factory-file module-text)
  (match (run-knave-run (as-str (parent-path factory-file))
                        factory-file module-text)
    ((ok output) (checked-factory-json factory-file output))
    ((err reason)
     (err (synth-error/factory-eval-failed (str factory-file) reason)))))

(defn checked-factory-json (factory-file output)
  (match (succeeded? output)
    (true (ok (output-text output)))
    (false (err (synth-error/factory-eval-failed (str factory-file)
                                                 (output-failure output))))))

(defn write-factory-json (json-file json)
  (match (write-text json-file json)
    ((ok _) (ok (str json-file)))
    ((err reason)
     (err (synth-error/unwritable-factory-json (str json-file) reason)))))

(defn factory-file->module (factory-file)
  (match (read-text factory-file)
    ((ok factory-text) (ok (factory-module-text factory-text)))
    ((err reason)
     (err (synth-error/unreadable-factory (str factory-file) reason)))))
