(use controller/json json-field json-text parse-json)
(use factory/json factory->json)
(use fixtures/fake-factory fake-factory)

(def control-characters
  (-> (range 0 32)
      (map (fn (code) (str (char-from-code code))))
      collect
      (join "")))

(def char-from-code
  (rust "char::from_u32({0} as u32).unwrap_or('?')"
    (fn (int) char)))

(def control-characters-json
  (str "\\u0000\\u0001\\u0002\\u0003\\u0004\\u0005\\u0006\\u0007"
       "\\b\\t\\n\\u000b\\f\\r"
       "\\u000e\\u000f\\u0010\\u0011\\u0012\\u0013\\u0014\\u0015"
       "\\u0016\\u0017\\u0018\\u0019\\u001a\\u001b\\u001c\\u001d"
       "\\u001e\\u001f"))

(defn assert-text-field (document key expected)
  (match (json-field document key)
    ((some value) (assert-text-value value expected))
    (none (assert false))))

(defn assert-text-value (value expected)
  (match (json-text value)
    ((some text) (assert (= (as-str text) (as-str expected))))
    (none (assert false))))

(deftest fake-factory-becomes-json
  (assert (= (factory->json fake-factory)
             (str "{\n" "  \"schema\": 0,\n"
                  "  \"name\": \"fake\",\n"
                  "  \"manager\": \"fake-manager\",\n"
                  "  \"roadmap\": \"fake-roadmap\",\n"
                  "  \"max_active\": 1,\n"
                  "  \"merge\": \"gh-auto\",\n"
                  "  \"runner\": \"ringleader\",\n"
                  "  \"roles\": {\n" "    \"worker\": {\n"
                  "      \"agent\": \"fake-worker-agent\",\n"
                  "      \"skill\": \"fake:worker-skill\",\n"
                  "      \"brief\": \"fake/briefs/worker.md\"\n"
                  "    },\n" "    \"reviewer\": {\n"
                  "      \"agent\": \"fake-reviewer-agent\",\n"
                  "      \"skill\": \"fake:reviewer-skill\",\n"
                  "      \"brief\": \"fake/briefs/reviewer.md\"\n"
                  "    }\n" "  }\n" "}\n"))))

(deftest text-with-json-escapes-is-escaped
  (assert (= (factory->json (assoc (clone fake-factory)
                                   :name (str "a\"b\\c\nd")))
             (str "{\n" "  \"schema\": 0,\n"
                  "  \"name\": \"a\\\"b\\\\c\\nd\",\n"
                  "  \"manager\": \"fake-manager\",\n"
                  "  \"roadmap\": \"fake-roadmap\",\n"
                  "  \"max_active\": 1,\n"
                  "  \"merge\": \"gh-auto\",\n"
                  "  \"runner\": \"ringleader\",\n"
                  "  \"roles\": {\n" "    \"worker\": {\n"
                  "      \"agent\": \"fake-worker-agent\",\n"
                  "      \"skill\": \"fake:worker-skill\",\n"
                  "      \"brief\": \"fake/briefs/worker.md\"\n"
                  "    },\n" "    \"reviewer\": {\n"
                  "      \"agent\": \"fake-reviewer-agent\",\n"
                  "      \"skill\": \"fake:reviewer-skill\",\n"
                  "      \"brief\": \"fake/briefs/reviewer.md\"\n"
                  "    }\n" "  }\n" "}\n"))))

(deftest control-characters-are-escaped
  (assert (= (factory->json (assoc (clone fake-factory)
                                   :name (clone control-characters)))
             (str "{\n" "  \"schema\": 0,\n"
                  "  \"name\": \"" control-characters-json
                  "\",\n"
                  "  \"manager\": \"fake-manager\",\n"
                  "  \"roadmap\": \"fake-roadmap\",\n"
                  "  \"max_active\": 1,\n"
                  "  \"merge\": \"gh-auto\",\n"
                  "  \"runner\": \"ringleader\",\n"
                  "  \"roles\": {\n" "    \"worker\": {\n"
                  "      \"agent\": \"fake-worker-agent\",\n"
                  "      \"skill\": \"fake:worker-skill\",\n"
                  "      \"brief\": \"fake/briefs/worker.md\"\n"
                  "    },\n" "    \"reviewer\": {\n"
                  "      \"agent\": \"fake-reviewer-agent\",\n"
                  "      \"skill\": \"fake:reviewer-skill\",\n"
                  "      \"brief\": \"fake/briefs/reviewer.md\"\n"
                  "    }\n" "  }\n" "}\n"))))

(deftest control-characters-round-trip
  (let (document (unwrap-ok (parse-json (as-str (factory->json (assoc (clone fake-factory)
                                                                      :name (clone
                                                                              control-characters)))))))
    (assert-text-field document "name" control-characters)))
