                                                    (str root "/" base)))))))))

(deftest check-reports-a-missing-factory
  (let (root (unwrap-ok (current-directory))
        dir (str "target/knave/test-factories/check/missing")
        base (unwrap-ok (prepare-temp-base (as-str root) (str "missing"))))
    (unwrap-ok (create-directory (as-str (str root "/" dir))))
    (let (output (unwrap-ok (check-output (as-str root)
                                          (as-str dir)
                                          (as-str base))))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output) "no factory at"))
      (assert (empty? (unwrap-ok (directory-names (as-str
                                                    (str root "/" base)))))))))

(deftest check-reports-a-stale-factory-json
  (let (root (unwrap-ok (current-directory))
        dir (str "target/knave/test-factories/check/stale/.kogworks")
        base (unwrap-ok (prepare-temp-base (as-str root) (str "stale")))
        json (str root "/" dir "/factory.json"))
    (unwrap-ok (prepare-factory dir sample-factory))
    (unwrap-ok (synth-factory (as-str dir)))
    (unwrap-ok (write-text (as-str json)
                           (as-str (str "{}\n"))))
    (let (json-before (unwrap-ok (slurp (as-str json)))
          output (unwrap-ok (check-output (as-str root)
                                          (as-str dir)
                                          (as-str base))))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output) "stale"))
      (assert (= (unwrap-ok (slurp (as-str json)))
                 json-before))
      (assert (empty? (unwrap-ok (directory-names (as-str
                                                    (str root "/" base)))))))))

(deftest check-leaves-the-repository-untouched
  (let (root (unwrap-ok (current-directory))
        dir (str ".kogworks")
        base (unwrap-ok (prepare-temp-base (as-str root) (str "repository")))
        json (str root "/" dir "/factory.json"))
    (let (names-before (unwrap-ok (directory-names (as-str (str root "/" dir))))
          json-before (unwrap-ok (slurp (as-str json)))
          status-before (unwrap-ok (run-git-status (as-str root) (as-str dir)))
          output (unwrap-ok (check-output (as-str root)
                                          (as-str dir)
                                          (as-str base))))
      (assert (= (exit-code output) 0))
      (assert (= (unwrap-ok (directory-names (as-str (str root "/" dir))))
                 names-before))
      (assert (= (unwrap-ok (slurp (as-str json)))
                 json-before))
      (assert (= (unwrap-ok (run-git-status (as-str root) (as-str dir)))
                 status-before))
      (assert (empty? (unwrap-ok (directory-names (as-str
                                                    (str root "/" base)))))))))
