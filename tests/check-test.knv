  (let (root (unwrap-ok (current-directory))
        dir (str "target/knave/test-factories/check/check/.kogworks")
        base (unwrap-ok (prepare-temp-base (as-str root) (str "check"))))
    (unwrap-ok (prepare-factory dir check-failure-factory))
    (let (output (unwrap-ok (check-output (as-str root)
                                          (as-str dir)
                                          (as-str base))))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output) "knave check"))
      (assert (contains? (stderr-text output) "mismatched types"))
      (assert (empty? (unwrap-ok (directory-names (as-str
                                                    (str root "/" base)))))))))

(deftest check-reports-a-format-failure
  (let (root (unwrap-ok (current-directory))
        dir (str "target/knave/test-factories/check/format/.kogworks")
        base (unwrap-ok (prepare-temp-base (as-str root) (str "format"))))
