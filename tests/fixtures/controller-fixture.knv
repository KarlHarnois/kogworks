(module
  "Builds the fake rmap, ringleader, git and gh programs, the JSON value files, and the repository with its factory and briefs that the controller tests use.")

(use factory/json factory->json)
(use factory/types ->role role-name)
(use fixtures/fake-factory fake-factory)

(export ->fake-settings absolute-path default-settings
        design-controller-factory exit-code fake-settings
        make-dir max-active-call-count max-active-command
        prepare-design-repo prepare-repo read-text reset-dir
        run-controller run-controller-colored stderr-text
        stdout-text stored-max-active write-fakes
        write-text)

(def controller-factory
  (assoc (clone fake-factory)
         :roles (vec (->role :name role-name/worker
                             :agent (str "fake-agent")
                             :skill (str "fake-skill")
                             :brief (str ".kogworks/briefs/worker.md"))
                     (->role :name role-name/reviewer
                             :agent (str "fake-reviewer-agent")
                             :skill (str "fake-reviewer-skill")
                             :brief (str ".kogworks/briefs/reviewer.md")))))

(def design-controller-factory
  (assoc (clone fake-factory)
         :roles (vec (->role :name role-name/worker
                             :agent (str "fake-agent")
                             :skill (str "fake-skill")
                             :brief (str ".kogworks/briefs/worker.md"))
                     (->role :name role-name/reviewer
                             :agent (str "fake-reviewer-agent")
                             :skill (str "fake-reviewer-skill")
                             :brief (str ".kogworks/briefs/reviewer.md"))
                     (->role :name role-name/design-reviewer
                             :agent (str "fake-design-agent")
                             :skill (str "fake-design-skill")
                             :brief (str
                                      ".kogworks/briefs/design-reviewer.md")))))

(def worker-brief
  (str "item={{item}} roadmap={{roadmap}} session={{session}} "
       "branch={{branch}} base={{base}} skill={{skill}}\n"))

(def reviewer-brief
  (str "item={{item}} roadmap={{roadmap}} session={{session}} "
       "pr={{pr}} head={{head}} criteria={{criteria}} base={{base}} "
       "skill={{skill}} manager={{manager}}\n"))

(def design-brief
  (str "design item={{item}} roadmap={{roadmap}} session={{session}} "
       "pr={{pr}} head={{head}} criteria={{criteria}} base={{base}} "
       "skill={{skill}} manager={{manager}}\n"))

(def write-text
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(def read-text
  (rust "std::fs::read_to_string({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result string string))))

(def make-dir
  (rust "std::fs::create_dir_all({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result unit string))))

(def reset-dir
  (rust "{{
    match std::fs::remove_dir_all({0}) {{
      Ok(_) => Ok(()),
      Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
      Err(error) => Err(error.to_string()),
    }}
  }}"
    (fn ((ref str)) (result unit string))))

(def make-executable
  (rust "{{
    use std::os::unix::fs::PermissionsExt;
    let mut permissions = std::fs::metadata({0})
      .map_err(|error| error.to_string())?
      .permissions();
    permissions.set_mode(0o755);
    std::fs::set_permissions({0}, permissions)
      .map_err(|error| error.to_string())
  }}"
    (fn ((ref str)) (result unit string))))

(def rmap-script
  (str
    "#!/bin/sh\n"
    "root=$(cd \"$(dirname \"$0\")/..\" && pwd)\n"
    "if [ \"$1 $2\" != \"roadmap set\" ]; then\n"
    "  printf 'rmap %s\\n' \"$*\" >> \"$root/sequence\"\n"
    "fi\n" "case \"$1\" in\n" "  roadmap)\n"
    "    printf 'rmap %s\\n' \"$*\" >> \"$root/max-active-commands\"\n"
    "    if [ [MAX_ACTIVE_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[MAX_ACTIVE_ERROR]' >&2\n"
    "      exit [MAX_ACTIVE_EXIT]\n" "    fi\n"
    "    printf '%s' \"$5\" > \"$root/stored-max-active\"\n"
    "    ;;\n" "  next)\n"
    "    if [ -n \"[NEXT_SIGNAL]\" ]; then\n"
    "      kill -s [NEXT_SIGNAL] \"$PPID\"\n" "    fi\n"
    "    count=0\n"
    "    if [ -f \"$root/counter\" ]; then count=$(cat \"$root/counter\"); fi\n"
    "    count=$((count + 1))\n"
    "    printf '%s' \"$count\" > \"$root/counter\"\n"
    "    if [ [STOP_AFTER] -gt 0 ] && [ \"$count\" -ge [STOP_AFTER] ]; then\n"
    "      printf 'poll limit\\n' >&2\n" "      exit 7\n"
    "    fi\n" "    cat \"$root/next.json\"\n" "    ;;\n"
    "  ready) cat \"$root/ready.json\" ;;\n" "  item)\n"
    "    case \"$2\" in\n" "      show)\n"
    "        shows=0\n"
    "        if [ -f \"$root/show-count\" ]; then\n"
    "          shows=$(cat \"$root/show-count\")\n"
    "        fi\n" "        shows=$((shows + 1))\n"
    "        printf '%s' \"$shows\" > \"$root/show-count\"\n"
    "        if [ \"$shows\" -ge 2 ] && [ [LATER_SHOW_EXIT] -ne 0 ]; then\n"
    "          printf '%s\\n' '[LATER_SHOW_ERROR]' >&2\n"
    "          exit [LATER_SHOW_EXIT]\n" "        fi\n"
    "        if [ \"$shows\" -ge 2 ] && [ -f \"$root/item-later.json\" ]; then\n"
    "          cat \"$root/item-later.json\"\n"
    "        else\n" "          cat \"$root/item.json\"\n"
    "        fi\n" "        ;;\n" "      advance)\n"
    "        if [ [ADVANCE_EXIT] -ne 0 ]; then\n"
    "          printf '%s\\n' '[ADVANCE_ERROR]' >&2\n"
    "          exit [ADVANCE_EXIT]\n" "        fi\n"
    "        ;;\n" "      close)\n"
    "        if [ [CLOSE_EXIT] -ne 0 ]; then\n"
    "          printf '%s\\n' '[CLOSE_ERROR]' >&2\n"
    "          exit [CLOSE_EXIT]\n" "        fi\n"
    "        ;;\n" "      claim)\n"
    "        if [ [CLAIM_EXIT] -ne 0 ]; then\n"
    "          printf '%s\\n' '[CLAIM_ERROR]' >&2\n"
    "          exit [CLAIM_EXIT]\n" "        fi\n"
    "        ;;\n" "    esac\n" "    ;;\n" "  review)\n"
    "    if [ [REVIEW_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[REVIEW_ERROR]' >&2\n"
    "      exit [REVIEW_EXIT]\n" "    fi\n" "    ;;\n"
    "  session) ;;\n" "esac\n" "exit 0\n"))

(def ringleader-script
  (str
    "#!/bin/sh\n"
    "root=$(cd \"$(dirname \"$0\")/..\" && pwd)\n"
    "if [ \"$1\" = \"new\" ]; then\n" "  shift\n"
    "  name=\n" "  repo=\n" "  agent=\n" "  base=\n"
    "  prompt=\n" "  while [ $# -gt 0 ]; do\n"
    "    case \"$1\" in\n"
    "      --name) name=$2; shift 2 ;;\n"
    "      --repo) repo=$2; shift 2 ;;\n"
    "      --agent) agent=$2; shift 2 ;;\n"
    "      --base-branch) base=$2; shift 2 ;;\n"
    "      --prompt) prompt=$2; shift 2 ;;\n"
    "      *) shift ;;\n" "    esac\n" "  done\n"
    "  case \"$repo\" in\n" "    /*) ;;\n"
    "    *) printf 'repo is not absolute: %s\\n' \"$repo\" >&2; exit 9 ;;\n"
    "  esac\n"
    "  printf 'ringleader new --name %s --repo %s --agent %s' "
    "\"$name\" \"$repo\" \"$agent\" >> \"$root/sequence\"\n"
    "  if [ -n \"$base\" ]; then\n"
    "    printf ' --base-branch %s' \"$base\" >> \"$root/sequence\"\n"
    "  fi\n"
    "  printf ' --prompt <filled>\\n' >> \"$root/sequence\"\n"
    "  printf '%s' \"$prompt\" > \"$root/prompt\"\n"
    "  if [ [NEW_EXIT] -ne 0 ]; then\n"
    "    printf '%s\\n' '[NEW_ERROR]' >&2\n"
    "    exit [NEW_EXIT]\n" "  fi\n"
    "elif [ \"$1\" = \"send\" ]; then\n"
    "  printf 'ringleader send %s %s\\n' \"$2\" \"$3\" >> \"$root/sequence\"\n"
    "  sends=0\n"
    "  if [ -f \"$root/send-count\" ]; then sends=$(cat \"$root/send-count\"); fi\n"
    "  sends=$((sends + 1))\n"
    "  printf '%s' \"$sends\" > \"$root/send-count\"\n"
    "  if [ \"$sends\" -le [SEND_FAILURES] ]; then\n"
    "    printf 'the agent is not at its prompt\\n' >&2\n"
    "    exit 3\n" "  fi\n" "fi\n" "exit 0\n"))

(def git-script
  (str "#!/bin/sh\n"
       "root=$(cd \"$(dirname \"$0\")/..\" && pwd)\n"
       "printf 'git %s\\n' \"$*\" >> \"$root/git.log\"\n"
       "case \"$1 $2\" in\n"
       "  \"remote get-url\") printf 'git@github.com:fake-owner/fake-repo.git\\n' ;;\n"
       "  *) printf 'origin/main\\n' ;;\n" "esac\n"))

(def gh-script
  (str
    "#!/bin/sh\n"
    "root=$(cd \"$(dirname \"$0\")/..\" && pwd)\n"
    "printf 'gh %s\\n' \"$*\" >> \"$root/sequence\"\n"
    "check_network() {\n" "  name=$1\n" "  limit=$2\n"
    "  file=\"$root/$name-attempts\"\n" "  count=0\n"
    "  if [ -f \"$file\" ]; then count=$(cat \"$file\"); fi\n"
    "  count=$((count + 1))\n"
    "  printf '%s' \"$count\" > \"$file\"\n"
    "  if [ \"$limit\" -gt 0 ] && [ \"$count\" -le \"$limit\" ]; then\n"
    "    printf '%s\\n' '[NETWORK_ERROR]' >&2\n"
    "    exit 1\n" "  fi\n" "}\n" "case \"$1 $2\" in\n"
    "  \"repo view\")\n"
    "    check_network repo-view [REPO_VIEW_NETWORK_FAILURES]\n"
    "    if [ [REPO_VIEW_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[REPO_VIEW_ERROR]' >&2\n"
    "      exit [REPO_VIEW_EXIT]\n" "    fi\n"
    "    printf '%s\\n' '[SLUG]'\n" "    ;;\n"
    "  \"api repos/[SLUG]\")\n"
    "    check_network allow-auto-merge [ALLOW_AUTO_MERGE_NETWORK_FAILURES]\n"
    "    if [ [API_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[API_ERROR]' >&2\n"
    "      exit [API_EXIT]\n" "    fi\n"
    "    printf '%s\\n' '[ALLOW_AUTO_MERGE]'\n" "    ;;\n"
    "  \"api repos/[SLUG]/branches/main/protection\")\n"
    "    check_network required-checks [REQUIRED_CHECKS_NETWORK_FAILURES]\n"
    "    if [ [REQUIRED_CHECKS_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[REQUIRED_CHECKS_ERROR]' >&2\n"
    "      exit [REQUIRED_CHECKS_EXIT]\n" "    fi\n"
    "    if [ [API_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[API_ERROR]' >&2\n"
    "      exit [API_EXIT]\n" "    fi\n"
    "    printf '%s\\n' '[REQUIRED_CHECKS]'\n" "    ;;\n"
    "  \"pr update-branch\")\n"
    "    if [ [UPDATE_BRANCH_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[UPDATE_BRANCH_ERROR]' >&2\n"
    "      exit [UPDATE_BRANCH_EXIT]\n" "    fi\n"
    "    ;;\n" "  \"pr merge\")\n" "    case \" $* \" in\n"
    "      *\" --disable-auto \"*)\n"
    "        check_network disarm [DISARM_NETWORK_FAILURES]\n"
    "        if [ [DISARM_EXIT] -ne 0 ]; then\n"
    "          printf '%s\\n' '[DISARM_ERROR]' >&2\n"
    "          exit [DISARM_EXIT]\n" "        fi\n"
    "        ;;\n" "      *\" --auto \"*)\n"
    "        check_network merge [MERGE_NETWORK_FAILURES]\n"
    "        merges=0\n"
    "        if [ -f \"$root/merge-count\" ]; then merges=$(cat \"$root/merge-count\"); fi\n"
    "        merges=$((merges + 1))\n"
    "        printf '%s' \"$merges\" > \"$root/merge-count\"\n"
    "        if [ \"$merges\" -ge 2 ]; then\n"
    "          if [ -n \"[LATER_MERGE_SIGNAL]\" ]; then\n"
    "            kill -s [LATER_MERGE_SIGNAL] \"$PPID\"\n"
    "          fi\n"
    "          if [ [LATER_MERGE_EXIT] -ne 0 ]; then\n"
    "            printf '%s\\n' '[LATER_MERGE_ERROR]' >&2\n"
    "            exit [LATER_MERGE_EXIT]\n" "          fi\n"
    "        else\n"
    "          if [ -n \"[MERGE_SIGNAL]\" ]; then\n"
    "            kill -s [MERGE_SIGNAL] \"$PPID\"\n"
    "          fi\n"
    "          if [ [MERGE_EXIT] -ne 0 ]; then\n"
    "            printf '%s\\n' '[MERGE_ERROR]' >&2\n"
    "            exit [MERGE_EXIT]\n" "          fi\n"
    "        fi\n" "        ;;\n" "      *)\n"
    "        check_network direct-merge [DIRECT_MERGE_NETWORK_FAILURES]\n"
    "        if [ [DIRECT_MERGE_EXIT] -ne 0 ]; then\n"
    "          printf '%s\\n' '[DIRECT_MERGE_ERROR]' >&2\n"
    "          exit [DIRECT_MERGE_EXIT]\n" "        fi\n"
    "        ;;\n" "    esac\n" "    ;;\n"
    "  \"pr view\")\n"
    "    if [ -n \"[VIEW_SIGNAL]\" ]; then\n"
    "      kill -s [VIEW_SIGNAL] \"$PPID\"\n" "    fi\n"
    "    if [ [VIEW_EXIT] -ne 0 ]; then\n"
    "      printf '%s\\n' '[VIEW_ERROR]' >&2\n"
    "      exit [VIEW_EXIT]\n" "    fi\n"
    "    check_network view [VIEW_NETWORK_FAILURES]\n"
    "    views=0\n"
    "    if [ -f \"$root/view-count\" ]; then views=$(cat \"$root/view-count\"); fi\n"
    "    views=$((views + 1))\n"
    "    printf '%s' \"$views\" > \"$root/view-count\"\n"
    "    if [ \"$views\" -ge 2 ]; then\n"
    "      cat \"$root/later-view.json\"\n" "    else\n"
    "      cat \"$root/view.json\"\n" "    fi\n" "    ;;\n"
    "esac\n" "exit 0\n"))

(def absolute-path
  (rust "std::fs::canonicalize({0}).map(|path| path.to_string_lossy().into_owned()).map_err(|error| error.to_string())"
    (fn ((ref str)) (result string string))))

(def run-controller
  (rust "{{
    let bin = std::fs::canonicalize({0}).map_err(|error| error.to_string())?;
    let path = format!(\"{{}}:{{}}\",
                       bin.display(),
                       std::env::var(\"PATH\").unwrap_or_default());
    std::process::Command::new(\"./target/knave/kogworks/kogworks\")
      .arg(\"controller\")
      .arg(\"--repo\")
      .arg({1})
      .args({2}.iter().map(|argument| argument.as_str()))
      .env(\"PATH\", path)
      .output()
      .map_err(|error| error.to_string())
  }}"
    (fn ((ref str) (ref str) (ref (vec string)))
      (result process-output string))))

(def run-controller-colored
  (rust "{{
    let bin = std::fs::canonicalize({0}).map_err(|error| error.to_string())?;
    let path = format!(\"{{}}:{{}}\",
                       bin.display(),
                       std::env::var(\"PATH\").unwrap_or_default());
    std::process::Command::new(\"./target/knave/kogworks/kogworks\")
      .arg(\"controller\")
      .arg(\"--repo\")
      .arg({1})
      .args({2}.iter().map(|argument| argument.as_str()))
      .env(\"PATH\", path)
      .env(\"FORCE_COLOR\", \"1\")
      .env(\"COLORTERM\", \"truecolor\")
      .output()
      .map_err(|error| error.to_string())
  }}"
    (fn ((ref str) (ref str) (ref (vec string)))
      (result process-output string))))

(def exit-code
  (rust "{0}.status.code().map(i64::from).unwrap_or(-1)"
    (fn ((ref process-output)) int)))

(def stdout-text
  (rust "String::from_utf8_lossy({0}.stdout.as_slice()).into_owned()"
    (fn ((ref process-output)) string)))

(def stderr-text
  (rust "String::from_utf8_lossy({0}.stderr.as_slice()).into_owned()"
    (fn ((ref process-output)) string)))

(def dispatch-item-json
  (str "{\"item\":{\"id\":\"rm-0001\","
       "\"title\":\"Build the first ready item\","
       "\"kind\":\"build\"}}"))

(defstruct fake-settings
  :next-json string
  :next-signal string
  :ready-json string
  :item-json string
  :item-later-json string
  :stop-after int
  :claim-exit int
  :claim-error string
  :advance-exit int
  :advance-error string
  :review-exit int
  :review-error string
  :new-exit int
  :new-error string
  :send-failures int
  :merge-exit int
  :merge-error string
  :merge-signal string
  :later-merge-exit int
  :later-merge-error string
  :later-merge-signal string
  :direct-merge-exit int
  :direct-merge-error string
  :disarm-exit int
  :disarm-error string
  :later-show-exit int
  :later-show-error string
  :network-error string
  :merge-network-failures int
  :repo-view-network-failures int
  :allow-auto-merge-network-failures int
  :required-checks-network-failures int
  :direct-merge-network-failures int
  :disarm-network-failures int
  :view-network-failures int
  :update-branch-exit int
  :update-branch-error string
  :close-exit int
  :close-error string
  :repo-view-exit int
  :repo-view-error string
  :api-exit int
  :api-error string
  :required-checks-exit int
  :required-checks-error string
  :slug string
  :allow-auto-merge string
  :required-checks string
  :view-exit int
  :view-error string
  :view-signal string
  :view-json string
  :later-view-json string
  :max-active-exit int
  :max-active-error string)

(deftype process-output (rust "std::process::Output"))

(defn default-settings (next-json ready-json)
  (->fake-settings :next-json next-json
                   :next-signal (str)
                   :ready-json ready-json
                   :item-json (clone dispatch-item-json)
                   :item-later-json (str)
                   :stop-after 0
                   :claim-exit 0
                   :claim-error (str)
                   :advance-exit 0
                   :advance-error (str)
                   :review-exit 0
                   :review-error (str)
                   :new-exit 0
                   :new-error (str)
                   :send-failures 0
                   :merge-exit 0
                   :merge-error (str)
                   :merge-signal (str)
                   :later-merge-exit 0
                   :later-merge-error (str)
                   :later-merge-signal (str)
                   :direct-merge-exit 0
                   :direct-merge-error (str)
                   :disarm-exit 0
                   :disarm-error (str)
                   :later-show-exit 0
                   :later-show-error (str)
                   :network-error (str)
                   :merge-network-failures 0
                   :repo-view-network-failures 0
                   :allow-auto-merge-network-failures 0
                   :required-checks-network-failures 0
                   :direct-merge-network-failures 0
                   :disarm-network-failures 0
                   :view-network-failures 0
                   :update-branch-exit 0
                   :update-branch-error (str)
                   :close-exit 0
                   :close-error (str)
                   :repo-view-exit 0
                   :repo-view-error (str)
                   :api-exit 0
                   :api-error (str)
                   :required-checks-exit 0
                   :required-checks-error (str)
                   :slug (str "fake-owner/fake-repo")
                   :allow-auto-merge (str "true")
                   :required-checks (str "1")
                   :view-exit 0
                   :view-error (str)
                   :view-signal (str)
                   :view-json (str "{}")
                   :later-view-json (str "{}")
                   :max-active-exit 0
                   :max-active-error (str)))

(defn prepare-repo (root)
  (let-try (_ (reset-dir root)
            _ (make-dir (as-str (str root "/repo/.kogworks/briefs")))
            _ (write-text (as-str (str root "/repo/.kogworks/factory.json"))
                          (as-str (factory->json controller-factory)))
            _ (write-text (as-str (str root "/repo/.kogworks/briefs/worker.md"))
                          (as-str worker-brief)))
    (write-text (as-str (str root "/repo/.kogworks/briefs/reviewer.md"))
                (as-str reviewer-brief))))

(defn prepare-design-repo (root)
  (let-try (_ (reset-dir root)
            _ (make-dir (as-str (str root "/repo/.kogworks/briefs")))
            _ (write-text (as-str (str root "/repo/.kogworks/factory.json"))
                          (as-str (factory->json design-controller-factory)))
            _ (write-text (as-str (str root "/repo/.kogworks/briefs/worker.md"))
                          (as-str worker-brief))
            _ (write-text (as-str (str root
                                       "/repo/.kogworks/briefs/reviewer.md"))
                          (as-str reviewer-brief)))
    (write-text (as-str (str root "/repo/.kogworks/briefs/design-reviewer.md"))
                (as-str design-brief))))

(defn write-fakes (root settings)
  (let-try (_ (make-dir (as-str (str root "/bin")))
            _ (write-value-files root settings)
            _ (write-script (str root "/bin/rmap")
                            (replaced-script rmap-script settings))
            _ (write-script (str root "/bin/ringleader")
                            (replaced-script ringleader-script settings))
            _ (write-script (str root "/bin/git")
                            (replaced-script git-script settings)))
    (write-script (str root "/bin/gh")
                  (replaced-script gh-script settings))))

(defn max-active-command (root)
  (match (read-option (as-str (str root "/max-active-commands")))
    ((some text) (some (str (trim (as-str text)))))
    (none none)))

(defn max-active-call-count (root)
  (match (read-option (as-str (str root "/max-active-commands")))
    ((some text) (len (collect (lines (as-str text)))))
    (none 0)))

(defn stored-max-active (root)
  (read-option (as-str (str root "/stored-max-active"))))

(defn read-option (path)
  (match (read-text path)
    ((ok text) (some text))
    ((err _) none)))

(defn replaced-script (script settings)
  (-> script
      (replace-token (str "[NEXT_SIGNAL]")
                     (clone (:next-signal settings)))
      (replace-token (str "[STOP_AFTER]")
                     (str (:stop-after settings)))
      (replace-token (str "[CLAIM_EXIT]")
                     (str (:claim-exit settings)))
      (replace-token (str "[CLAIM_ERROR]")
                     (clone (:claim-error settings)))
      (replace-token (str "[ADVANCE_EXIT]")
                     (str (:advance-exit settings)))
      (replace-token (str "[ADVANCE_ERROR]")
                     (clone (:advance-error settings)))
      (replace-token (str "[REVIEW_EXIT]")
                     (str (:review-exit settings)))
      (replace-token (str "[REVIEW_ERROR]")
                     (clone (:review-error settings)))
      (replace-token (str "[NEW_EXIT]")
                     (str (:new-exit settings)))
      (replace-token (str "[NEW_ERROR]") (:new-error settings))
      (replace-token (str "[SEND_FAILURES]")
                     (str (:send-failures settings)))
      (replace-token (str "[MERGE_EXIT]")
                     (str (:merge-exit settings)))
      (replace-token (str "[MERGE_ERROR]")
                     (clone (:merge-error settings)))
      (replace-token (str "[MERGE_SIGNAL]")
                     (clone (:merge-signal settings)))
      (replace-token (str "[LATER_MERGE_EXIT]")
                     (str (:later-merge-exit settings)))
      (replace-token (str "[LATER_MERGE_ERROR]")
                     (clone (:later-merge-error settings)))
      (replace-token (str "[LATER_MERGE_SIGNAL]")
                     (clone (:later-merge-signal settings)))
      (replace-token (str "[DIRECT_MERGE_EXIT]")
                     (str (:direct-merge-exit settings)))
      (replace-token (str "[DIRECT_MERGE_ERROR]")
                     (clone (:direct-merge-error settings)))
      (replace-token (str "[DISARM_EXIT]")
                     (str (:disarm-exit settings)))
      (replace-token (str "[DISARM_ERROR]")
                     (clone (:disarm-error settings)))
      (replace-token (str "[LATER_SHOW_EXIT]")
                     (str (:later-show-exit settings)))
      (replace-token (str "[LATER_SHOW_ERROR]")
                     (clone (:later-show-error settings)))
      (replace-token (str "[NETWORK_ERROR]")
                     (clone (:network-error settings)))
      (replace-token (str "[MERGE_NETWORK_FAILURES]")
                     (str (:merge-network-failures settings)))
      (replace-token (str "[REPO_VIEW_NETWORK_FAILURES]")
                     (str (:repo-view-network-failures settings)))
      (replace-token (str "[ALLOW_AUTO_MERGE_NETWORK_FAILURES]")
                     (str (:allow-auto-merge-network-failures settings)))
      (replace-token (str "[REQUIRED_CHECKS_NETWORK_FAILURES]")
                     (str (:required-checks-network-failures settings)))
      (replace-token (str "[DIRECT_MERGE_NETWORK_FAILURES]")
                     (str (:direct-merge-network-failures settings)))
      (replace-token (str "[DISARM_NETWORK_FAILURES]")
                     (str (:disarm-network-failures settings)))
      (replace-token (str "[VIEW_EXIT]")
                     (str (:view-exit settings)))
      (replace-token (str "[VIEW_ERROR]")
                     (clone (:view-error settings)))
      (replace-token (str "[VIEW_SIGNAL]")
                     (clone (:view-signal settings)))
      (replace-token (str "[VIEW_NETWORK_FAILURES]")
                     (str (:view-network-failures settings)))
      (replace-token (str "[UPDATE_BRANCH_EXIT]")
                     (str (:update-branch-exit settings)))
      (replace-token (str "[UPDATE_BRANCH_ERROR]")
                     (clone (:update-branch-error settings)))
      (replace-token (str "[CLOSE_EXIT]")
                     (str (:close-exit settings)))
      (replace-token (str "[CLOSE_ERROR]")
                     (clone (:close-error settings)))
      (replace-token (str "[REPO_VIEW_EXIT]")
                     (str (:repo-view-exit settings)))
      (replace-token (str "[REPO_VIEW_ERROR]")
                     (clone (:repo-view-error settings)))
      (replace-token (str "[API_EXIT]")
                     (str (:api-exit settings)))
      (replace-token (str "[API_ERROR]")
                     (clone (:api-error settings)))
      (replace-token (str "[REQUIRED_CHECKS_EXIT]")
                     (str (:required-checks-exit settings)))
      (replace-token (str "[REQUIRED_CHECKS_ERROR]")
                     (clone (:required-checks-error settings)))
      (replace-token (str "[SLUG]") (:slug settings))
      (replace-token (str "[ALLOW_AUTO_MERGE]")
                     (:allow-auto-merge settings))
      (replace-token (str "[REQUIRED_CHECKS]")
                     (:required-checks settings))
      (replace-token (str "[MAX_ACTIVE_EXIT]")
                     (str (:max-active-exit settings)))
      (replace-token (str "[MAX_ACTIVE_ERROR]")
                     (clone (:max-active-error settings)))))

(defn replace-token (text token value)
  (-> text as-str
      (split (as-str token))
      collect
      (join (as-str value))))

(defn write-script (path text)
  (let-try (_ (write-text (as-str path) (as-str text)))
    (make-executable (as-str path))))

(defn write-value-files (root settings)
  (let-try (_ (write-text (as-str (str root "/next.json"))
                          (as-str (:next-json settings)))
            _ (write-text (as-str (str root "/ready.json"))
                          (as-str (:ready-json settings)))
            _ (write-text (as-str (str root "/item.json"))
                          (as-str (:item-json settings)))
            _ (write-text (as-str (str root "/view.json"))
                          (as-str (:view-json settings)))
            _ (write-text (as-str (str root "/later-view.json"))
                          (as-str (:later-view-json settings))))
    (write-later-item root settings)))

(defn write-later-item (root settings)
  (if (empty? (:item-later-json settings))
    (ok (do))
    (write-text (as-str (str root "/item-later.json"))
                (as-str (:item-later-json settings)))))
