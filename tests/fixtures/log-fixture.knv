  (vec
    "14:02:12  rm-8bdc  ▸○○  building     Disarm auto-merge when the approved head c…"
    "14:02:13  rm-35cb  ▸○○  building     Add kogworks check and remove the module a…"
    "14:02:40  rm-c41e  ▸○   researching  Compare OSC 8 hyperlink support across ter…"
    "14:05:40  rm-8bdc  ✓▸○  reviewing    Disarm auto-merge when the approved head c…"
    "14:09:12  rm-8bdc  ✓↺○  changes      Disarm auto-merge when the approved head c…"
    "          ├─ criterion 2  no test shows the disarm when the approved head"
    "          │               changes"))

(def stream-sub-lines-expected
  (vec "          rm-35cb  ├─ pr           #34  build-rm-35cb"
       "          rm-35cb  ├─ disarmed     gh pr merge 34 --disable-auto"
       "          rm-35cb  ├─ manager      message sent to kw-manager"
       "          rm-35cb  ╰─ next         rerun, the new head needs a review"))

(def stream-stop-expected
  (vec "14:23:02  ■ controller stopped  1 merged · 1 accepted · 1 failed · 2 running"
       "          controller  ├─ running      rm-9a01 building 4m · its session keeps running"
       "          controller  ├─ running      rm-d210 designing 3m · its session keeps running"))

(def stream-title-expected
  (vec "16:00:00  rm-0001  build ▸ review ○ merge ○  building     abcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmnopqrstuvwxyzabcdefghijklmno…"))

(defn banner-actual ()
  (render-banner (settings-118) (banner-of)))

(defn changes-118-item () (bdc-changes))

(defn controller-actual ()
  (render-controller-failure (settings-118)
                             (controller-failure-of)))

(defn failed-command-actual ()
  (render-item (settings-80) (print-failed-start)))

(defn failure-actual ()
  (concat-lines (vec (render-item (settings-118) (heartbeat-timed-out))
                     (render-item (settings-118) (print-refused))
                     (render-item (settings-118) (print-failed-start))
                     (render-item (settings-118) (heartbeat-failed-start)))))

(defn main-actual ()
  (concat-lines (vec (render-item (settings-118) (bdc-building))
                     (render-item (settings-118) (cb-building))
                     (render-item (settings-118) (c41e-researching))
                     (render-item (settings-118) (bdc-reviewing))
                     (render-item (settings-118) (bdc-changes))
                     (render-item (settings-118) (bdc-fixing))
                     (render-alive (settings-118) (main-alive))
                     (render-item (settings-118) (bdc-reviewing-later))
                     (render-item (settings-118) (bdc-merging))
                     (render-item (settings-118) (bdc-merged))
                     (render-item (settings-118) (heartbeat-building))
                     (render-item (settings-118) (c41e-reported))
                     (render-item (settings-118) (c41e-accepted))
                     (render-item (settings-118) (d210-designing))
                     (render-item (settings-118) (cb-reviewing))
                     (render-item (settings-118) (cb-merging))
                     (render-item (settings-118) (cb-head-moved))
                     (render-stop (settings-118) (main-stop)))))

(defn narrow-actual ()
  (concat-lines (vec (render-item (settings-80) (bdc-building))
                     (render-item (settings-80) (cb-building))
                     (render-item (settings-80) (c41e-researching))
                     (render-item (settings-80) (bdc-reviewing))
                     (render-item (settings-80) (bdc-changes)))))

(defn review-actual ()
  (concat-lines (vec (render-item (settings-118) (print-reviewing))
                     (render-item (settings-118) (print-new-head))
                     (render-item (settings-118) (print-reviewing-again))
                     (render-item (settings-118) (print-verifying))
                     (render-item (settings-118) (print-merging))
                     (render-item (settings-118) (heartbeat-changes))
                     (render-item (settings-118) (cb-abandoned))
                     (render-item (settings-118) (cb-reviewing-after-abandoned))
                     (render-item (settings-118) (print-fixing-moved)))))

(defn settings-256 ()
  (->log-settings :colors color-mode/colors-256
                  :width (some 118)
                  :target output-target/terminal
                  :remote none))

(defn settings-truecolor ()
  (->log-settings :colors color-mode/truecolor
                  :width (some 118)
                  :target output-target/terminal
                  :remote none))

(defn stream-error-actual ()
  (render-sub-lines (settings-stream)
                    "rm-35cb"
                    (head-moved-sub-lines)))

(defn stream-stop-actual ()
  (render-stop (settings-stream) (main-stop)))

(defn stream-sub-lines-actual ()
  (cb-head-moved-stream-sub-lines-actual))

(defn stream-title-actual ()
  (render-item (settings-stream)
               (item-line-of "16:00:00" "rm-0001"
                             (build-stages stage-state/active
                                           stage-state/waiting
                                           stage-state/waiting)
                             log-status/building
                             (clone stream-title-text)
                             (vec))))

(defn bdc-building ()
  (item-line-of "14:02:12" "rm-8bdc"
                (build-stages stage-state/active
                              stage-state/waiting
                              stage-state/waiting)
                log-status/building
                (clone disarm-title)
                (vec)))

(defn settings-118 ()
  (->log-settings :colors color-mode/no-color
                  :width (some 118)
                  :target output-target/terminal
                  :remote none))

(defn settings-80 ()
  (->log-settings :colors color-mode/no-color
                  :width (some 80)
                  :target output-target/terminal
                  :remote none))

(defn settings-stream ()
  (->log-settings :colors color-mode/no-color
                  :width none
                  :target output-target/stream
                  :remote none))

(defn banner-of ()
  (->banner-line :time (str "14:02:11")
                 :roadmap (str "factory-mvp")
                 :manager (some (str "kw-manager"))
                 :poll-seconds 30))

(defn bdc-changes ()
  (item-line-of "14:09:12" "rm-8bdc"
                (build-stages stage-state/done
                              stage-state/sent-back
                              stage-state/waiting)
                log-status/changes
                (clone disarm-title)
                (vec (sub-line/criterion 2
                                         (str "no test shows the disarm when the approved head changes"))
                     (sub-line/criterion 4
                                         (str "the return to fixing leaves auto-merge armed"))
                     (sub-line/reviewer (str "review-rm-8bdc-7da1703, behavior review")))))

