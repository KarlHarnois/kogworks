                    (head-moved-tail-sub-lines)))

(defn cb-merging ()
  (item-line-of "14:22:30" "rm-35cb"
                (build-stages stage-state/done
                              stage-state/done
                              stage-state/active)
                log-status/merging
                (clone add-title)
