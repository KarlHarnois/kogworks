                              stage-state/waiting
                              stage-state/waiting)
                log-status/new-head
                (clone print-title)
                (vec)))

(defn print-refused ()
  (item-line-of "14:31:10" "rm-77c0"
                (build-stages stage-state/done
                              stage-state/done
                              stage-state/failed)
                log-status/refused
                (clone print-title)
                (vec (sub-line/error (str
                                       "`gh api repos/KarlHarnois/kogworks --jq"
                                       " .allow_auto_merge` printed `false`, not `true`"))
                     (sub-line/pr (->pr-summary :number 37
                                                :branch (str "build-rm-77c0")
                                                :head (some (str "a81f0c2"))))
                     (sub-line/manager (str "kw-manager"))
                     (sub-line/next (str "enable \"Allow auto-merge\" in the repository"
                                         " settings, then rerun")))))

(defn print-reviewing ()
  (item-line-of "15:01:10" "rm-77c0"
                (build-stages stage-state/done
                              stage-state/active
                              stage-state/waiting)
                log-status/reviewing
                (clone print-title)
                (vec)))

(defn print-reviewing-again ()
  (item-line-of "15:03:52" "rm-77c0"
                (build-stages stage-state/done
                              stage-state/active
                              stage-state/waiting)
                log-status/reviewing
                (clone print-title)
                (vec)))

(defn print-verifying ()
  (item-line-of "15:07:30" "rm-77c0"
                (build-stages stage-state/done
                              stage-state/active
                              stage-state/waiting)
                log-status/verifying
                (clone print-title)
                (vec (sub-line/criterion 3 (str "no verdict on this head"))
                     (sub-line/criterion 5 (str "no verdict on this head"))
                     (sub-line/reviewer (str "review-rm-77c0-5d6e7f8 approved, verify starts")))))

(defn append-lines! (left right)
  (loop (index 0
         lines left)
    (if (>= index (len right))
      lines
      (recur (inc index)
             (push-line! lines (clone (at right index)))))))

(defn build-stages (build review merge)
  (track/build-track build review merge))

(defn head-moved-sub-lines ()
  (vec (sub-line/error (str "PR 34 head is 4f5a6b7, not the approved 9f1c2ab"))
       (sub-line/pr (->pr-summary :number 34
                                  :branch (str "build-rm-35cb")
                                  :head none))
       (sub-line/disarmed (str "gh pr merge 34 --disable-auto"))
       (sub-line/manager (str "kw-manager"))
       (sub-line/next (str "rerun, the new head needs a review"))))

(defn head-moved-tail-sub-lines ()
  (vec (sub-line/pr (->pr-summary :number 34
                                  :branch (str "build-rm-35cb")
                                  :head none))
       (sub-line/disarmed (str "gh pr merge 34 --disable-auto"))
       (sub-line/manager (str "kw-manager"))
       (sub-line/next (str "rerun, the new head needs a review"))))

(defn item-line-of (time id track status title sub-lines)
  (->item-line :time (str time)
               :id (str id)
               :track track
               :status status
               :title title
               :sub-lines sub-lines))

(defn running-item-of (id status minutes)
  (->running-item :id (str id)
                  :status status
                  :minutes minutes))

(defn write-stages (write accept)
  (track/write-track write accept))

(defn push-line! (lines line)
  (do (push! lines line) lines))
