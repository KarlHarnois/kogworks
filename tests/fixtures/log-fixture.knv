(defn cb-reviewing ()
  (item-line-of "14:21:47" "rm-35cb"
                (build-stages stage-state/done
                              stage-state/active
                              stage-state/waiting)
                log-status/reviewing
                (clone add-title)
                (vec)))

(defn concat-lines (groups)
  (loop (index 0
         lines (vec))
    (if (>= index (len groups))
      lines
      (recur (inc index)
             (append-lines! lines (at groups index))))))

(defn controller-failure-of ()
  (->controller-failure :time (str "14:02:12")
                        :status (str "rmap next failed")
                        :sub-lines (vec (sub-line/error (str "roadmap \"factory-mvp\" not found"))
                                        (sub-line/exit 1
                                                       (str "rmap next --roadmap factory-mvp --taken-by controller"
                                                            " --json"))
                                        (sub-line/manager (str "kw-manager"))
                                        (sub-line/next (str "check the roadmap name in .kogworks/factory.knv,"
                                                            " then rerun")))))

(defn d210-designing ()
  (item-line-of "14:20:30" "rm-d210"
                (write-stages stage-state/active stage-state/waiting)
                log-status/designing
                (clone layout-title)
                (vec)))

(defn heartbeat-building ()
  (item-line-of "14:18:41" "rm-9a01"
                (build-stages stage-state/active
                              stage-state/waiting
                              stage-state/waiting)
                log-status/building
                (clone heartbeat-title)
                (vec)))

(defn heartbeat-changes ()
  (item-line-of "15:20:04" "rm-9a01"
                (build-stages stage-state/done
                              stage-state/sent-back
                              stage-state/waiting)
                log-status/changes
                (clone heartbeat-title)
                (vec (sub-line/criteria (str "all 6 met on this head"))
                     (sub-line/reviewer (str "review-rm-9a01-4be21c0, behavior review")))))

(defn heartbeat-failed-start ()
  (item-line-of "14:40:22" "rm-9a01"
                (build-stages stage-state/failed
                              stage-state/waiting
                              stage-state/waiting)
                log-status/failed
                (clone heartbeat-title)
                (vec (sub-line/error (str
                                       "agent \"opencode\" is not installed"))
                     (sub-line/exit 127
                                    (str "ringleader new --name build-rm-9a01"
                                         " --repo . --agent opencode --prompt <filled brief>"))
                     (sub-line/cleanup (str "rmap session end build-rm-9a01"
                                            " --reason abandoned"))
                     (sub-line/manager (str "kw-manager"))
                     (sub-line/next (str "fix the error above, then rerun")))))

(defn heartbeat-timed-out ()
  (item-line-of "14:52:57" "rm-9a01"
                (build-stages stage-state/done
                              stage-state/done
                              stage-state/failed)
                log-status/timed-out
                (clone heartbeat-title)
                (vec (sub-line/error (str "PR 35 did not merge within 3600 seconds"))
                     (sub-line/pr (->pr-summary :number 35
                                                :branch (str "build-rm-9a01")
                                                :head (some (str "4be21c0"))))
                     (sub-line/disarmed (str "gh pr merge 35 --disable-auto"))
                     (sub-line/manager (str "kw-manager"))
                     (sub-line/next (str "find what holds #35 open, then rerun")))))

(defn main-alive ()
  (->alive-line
    :time (str "14:14:40")
    :running (vec (running-item-of "rm-8bdc" running-status/fixing 5)
                  (running-item-of "rm-35cb" running-status/building 12)
                  (running-item-of "rm-c41e" running-status/researching 12))
    :merged 0
    :accepted 0))

(defn main-stop ()
  (->stop-line
    :time (str "14:23:02")
    :merged 1
    :accepted 1
    :failed 1
    :running (vec (running-item-of "rm-9a01" running-status/building 4)
                  (running-item-of "rm-d210" running-status/designing 3))
    :rerun (str "kogworks controller --repo . --poll 30")))

(defn print-failed-start ()
  (item-line-of "14:35:48" "rm-77c0"
                (build-stages stage-state/done
                              stage-state/failed
                              stage-state/waiting)
                log-status/failed
                (clone print-title)
                (vec (sub-line/error (str
                                       "a session named review-rm-77c0-a81f0c2"
                                       " already exists"))
                     (sub-line/exit 1
                                    (str "ringleader new --name review-rm-77c0-a81f0c2"
                                         " --repo . --agent claude --prompt <filled brief>"))
                     (sub-line/cleanup (str "rmap session end review-rm-77c0-a81f0c2"
                                            " --reason abandoned"))
                     (sub-line/manager (str "kw-manager"))
                     (sub-line/next (str "fix the error above, then rerun")))))

