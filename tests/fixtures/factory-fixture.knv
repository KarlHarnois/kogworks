(export prepare-factory)

(def create-directory
  (rust "std::fs::create_dir_all({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result unit string))))

(def write-text
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(defn prepare-factory (directory factory-text)
  (match (create-directory (as-str directory))
    ((ok _)
     (write-text (as-str (str directory "/factory.knv"))
                 (as-str factory-text)))
    ((err reason) (err reason))))
