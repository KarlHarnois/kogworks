(export prepare-factory)

(def create-dir
  (rust "std::fs::create_dir_all({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result unit string))))

(def write-text
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(defn prepare-factory (dir factory-text)
  (match (create-dir (as-str dir))
    ((ok _)
     (write-text (as-str (str dir "/factory.knv"))
                 (as-str factory-text)))
    ((err reason) (err reason))))
