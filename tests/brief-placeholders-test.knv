(def worker-brief-path (str ".kogworks/briefs/worker.md"))

(def reviewer-brief-path
  (str ".kogworks/briefs/reviewer.md"))

(def all-placeholders
  (vec (->placeholder :token (str "{{item}}")
                      :sample (str "rm-0000")
                      :briefs (vec brief-kind/worker brief-kind/reviewer))
       (->placeholder :token (str "{{roadmap}}")
                      :sample (str "factory-mvp")
                      :briefs (vec brief-kind/worker brief-kind/reviewer))
       (->placeholder :token (str "{{session}}")
                      :sample (str "sample-session")
                      :briefs (vec brief-kind/worker brief-kind/reviewer))
       (->placeholder :token (str "{{branch}}")
                      :sample (str "sample-branch")
                      :briefs (vec brief-kind/worker))
       (->placeholder :token (str "{{base}}")
                      :sample (str "main")
                      :briefs (vec brief-kind/worker brief-kind/reviewer))
       (->placeholder :token (str "{{skill}}")
                      :sample (str "features:building-features")
                      :briefs (vec brief-kind/worker brief-kind/reviewer))
       (->placeholder :token (str "{{pr}}")
                      :sample (str "1")
                      :briefs (vec brief-kind/reviewer))
       (->placeholder :token (str "{{head}}")
                      :sample (str "0000000000000000000000000000000000000000")
                      :briefs (vec brief-kind/reviewer))
       (->placeholder :token (str "{{criteria}}")
                      :sample (str "the item works")
                      :briefs (vec brief-kind/reviewer))
       (->placeholder :token (str "{{manager}}")
                      :sample (str "sample-manager")
                      :briefs (vec brief-kind/reviewer))
       (->placeholder :token (str "{{message-manager}}")
                      :sample (str "ringleader send sample-manager")
                      :briefs (vec brief-kind/reviewer))))

(defstruct placeholder
  :token string
  :sample string
  :briefs (vec brief-kind))

(defenum brief-kind
  worker
  reviewer)

(defn in-worker-brief? (placeholder)
  (contains? (:briefs placeholder) brief-kind/worker))

(defn in-reviewer-brief? (placeholder)
  (contains? (:briefs placeholder) brief-kind/reviewer))

(defn filled-brief? (brief in-brief?)
  (let (relevant (-> all-placeholders (filter in-brief?) collect))
    (and (every? relevant
           (fn (placeholder) (placeholder-present? brief placeholder)))
         (not (leftover-braces? (reduce relevant brief substitute))))))

(type substitute
  (fn (string (ref (ref placeholder)))
    string))

(defn substitute (text placeholder)
  (-> text as-str
      (split (as-str (:token placeholder)))
      collect
      (join (as-str (:sample placeholder)))))

(defn placeholder-present? (brief placeholder)
  (contains? brief (as-str (:token placeholder))))

(defn leftover-braces? (text)
  (or (contains? text "{{") (contains? text "}}")))

(deftest worker-brief-fills-every-placeholder
  (assert (filled-brief? (unwrap-ok (slurp worker-brief-path))
                         in-worker-brief?)))

(deftest reviewer-brief-fills-every-placeholder
  (assert (filled-brief? (unwrap-ok (slurp reviewer-brief-path))
                         in-reviewer-brief?)))

(deftest reviewer-brief-states-the-owner-review-protocol
  (let (brief (unwrap-ok (slurp reviewer-brief-path)))
    (assert (contains? brief "1. Invoke the `{{skill}}` skill first."))
    (assert (not (contains? brief "gh pr checkout")))
    (assert (contains? brief "git fetch origin"))
    (assert (contains? brief "git diff origin/{{base}}...HEAD"))
    (assert (contains? brief "{{message-manager}}"))
    (assert (contains? brief "writing-clean-code"))))

(deftest reviewer-brief-sends-no-report-to-rmap
  (let (brief (unwrap-ok (slurp reviewer-brief-path)))
    (assert (not (contains? brief "rmap report")))))

(deftest worker-brief-keeps-the-question-report
  (let (brief (unwrap-ok (slurp worker-brief-path)))
    (assert (contains? brief "--kind question"))))

(deftest reviewer-brief-records-changes-for-a-real-problem
  (let (brief (unwrap-ok (slurp reviewer-brief-path)))
    (assert (contains? brief "A real problem is any of these:"))
    (assert (contains? brief "- a bug"))
    (assert (contains? brief "- a regression"))
    (assert (contains? brief "- a security issue"))
    (assert (contains? brief
                       "- the pull request not delivering its claim"))
    (assert (contains? brief "- a broken repository rule"))
    (assert (contains? brief
                       "- a wrong test or no test for a criterion"))
    (assert (contains? brief
                       (as-str (str "If any criterion fails, or a real problem or blocking finding "
                                    "stands, use `--verdict changes`."))))))

(deftest reviewer-brief-approves-and-lists-nitpicks-when-only-nitpicks-remain
  (let (brief (unwrap-ok (slurp reviewer-brief-path)))
    (assert (contains? brief
                       "A nitpick is a style, wording or naming issue that does not break the work."))
    (assert (contains? brief
                       "A nitpick does not force the verdict `changes`."))
    (assert (contains? brief
                       (as-str (str "When only nitpicks remain, record the verdict `approve` and list "
                                    "the nitpicks in one `{{message-manager}}` message."))))))

(deftest reviewer-brief-keeps-no-changed-line-minor-rule
  (let (brief (unwrap-ok (slurp reviewer-brief-path)))
    (assert (not (contains? brief "minor finding")))
    (assert (not (contains?
                   brief
                   "The same pull request fixes the finding before merge.")))))

(deftest reviewer-brief-sends-an-untouched-finding-as-a-follow-up
  (let (brief (unwrap-ok (slurp reviewer-brief-path)))
    (assert (contains? brief
                       "A finding about code the pull request did not touch is a follow-up suggestion."))
    (assert (contains? brief
                       (as-str (str "Send the follow-up suggestion to the manager with one "
                                    "`{{message-manager}}` before the review verdict."))))
    (assert (contains? brief
                       "A follow-up suggestion does not change the verdict."))))

(deftest reviewer-brief-blocks-a-defect-that-breaks-the-work
  (let (brief (unwrap-ok (slurp reviewer-brief-path)))
    (assert (contains? brief
                       "Anything that makes the code or the brief under review not work as intended is blocking."))
    (assert (contains? brief
                       "A blocking finding stands even when no acceptance criterion names it."))
    (assert (contains? brief
                       "NEVER notice a defect and approve anyway."))))
