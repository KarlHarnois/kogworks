(use factory/roles roles)
(use factory/types ->role role-name)

(deftest roles-builds-the-role-vector
  (assert (= (roles
               (worker :agent "opencode"
                       :skill "writing-knave"
                       :brief ".kogworks/briefs/worker.md")
               (reviewer :agent "opencode"
                         :skill "reviewing-prs"
                         :brief ".kogworks/briefs/reviewer.md"))
             (vec (->role :name role-name/worker
                          :agent (str "opencode")
                          :skill (str "writing-knave")
                          :brief (str ".kogworks/briefs/worker.md"))
                  (->role :name role-name/reviewer
                          :agent (str "opencode")
                          :skill (str "reviewing-prs")
                          :brief (str ".kogworks/briefs/reviewer.md"))))))
