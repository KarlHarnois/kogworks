(use controller/log ->banner-line ->item-line ->log-settings
                    ->pr-summary ->running-item ->stop-line
                    color-mode display-width log-status
                    output-target render-banner render-item
                    render-stop render-sub-lines
                    running-status stage-state sub-line
                    track)

(use fixtures/log-fixture banner-actual banner-expected
                          bdc-building changes-118-item
                          controller-actual
                          controller-expected
                          failed-command-actual
                          failure-actual failure-expected
                          main-actual main-expected
                          narrow-actual narrow-expected
                          review-actual review-expected
                          settings-118 settings-256
                          settings-80 settings-truecolor
                          stream-error-actual
                          stream-stop-actual
                          stream-stop-expected
                          stream-sub-lines-actual
                          stream-sub-lines-expected
                          stream-title-actual
                          stream-title-expected)

(def unicode-width
  (rust "unicode_width::UnicodeWidthStr::width({0})"
    (fn ((ref str)) usize)))

(defenum span-step
  invalid
  (opened int))

(defn balanced-spans? (text)
  (let (parts (collect (split (as-str text) "\u{1b}[")))
    (loop (index 1
           depth 0)
      (if (>= index (len parts))
        (= depth 0)
        (match (span-step (at parts index) depth)
          (invalid false)
          ((opened next-depth) (recur (inc index) next-depth)))))))

(defn first-seven-lines (lines)
  (vec (clone (at lines 0))
       (clone (at lines 1))
       (clone (at lines 2))
       (clone (at lines 3))
       (clone (at lines 4))
       (clone (at lines 5))
       (clone (at lines 6))))

(defn first-three-lines (lines)
  (vec (clone (at lines 0))
       (clone (at lines 1))
       (clone (at lines 2))))

(defn same-lines? (actual expected)
  (= (join actual "\n") (join expected "\n")))

(defn span-step (part depth)
  (if (starts-with? part "0m")
    (reset-step depth)
    (open-step depth)))

(defn open-step (depth)
  (if (= depth 0)
    (span-step/opened (inc depth))
    span-step/invalid))

(defn reset-step (depth)
  (if (= depth 0)
    span-step/invalid
    (span-step/opened (dec depth))))

(defn link-settings ()
  (->log-settings :colors color-mode/truecolor
                  :width (some 118)
                  :target output-target/terminal
                  :remote (some (str
                                  "https://github.com/KarlHarnois/kogworks"))))

(deftest renders-the-banner-example
  (assert (same-lines? (banner-actual) banner-expected)))

(deftest renders-the-main-example-at-118-columns
  (assert (same-lines? (main-actual) main-expected)))

(deftest renders-the-review-outcome-examples-at-118-columns
  (assert (same-lines? (review-actual) review-expected)))

(deftest renders-the-failure-examples-at-118-columns
  (assert (same-lines? (failure-actual) failure-expected)))

(deftest renders-the-controller-failure-example
  (assert (same-lines? (controller-actual) controller-expected)))

(deftest renders-the-narrow-example-at-80-columns
  (assert (same-lines? (first-seven-lines (narrow-actual))
                       narrow-expected)))

(deftest renders-the-non-terminal-sub-lines-with-the-id
  (assert (same-lines? (stream-sub-lines-actual)
                       stream-sub-lines-expected)))

(deftest renders-the-non-terminal-stop-block
  (assert (same-lines? (first-three-lines (stream-stop-actual))
                       stream-stop-expected))
  (assert (= (clone (at (stream-stop-actual) 3))
             (str "          controller  ╰─ rerun        "
                  "kogworks controller --repo . --poll 30"))))

(deftest cuts-a-non-terminal-title-at-120-columns
  (assert (same-lines? (stream-title-actual) stream-title-expected)))

(deftest leaves-no-escape-sequence-with-no-color
  (assert (not (contains? (join (main-actual) "\n") "\u{1b}"))))

(deftest resets-every-truecolor-span
  (let (text (join (render-item (settings-truecolor) (changes-118-item))
                   "\n"))
    (assert (contains? text "\u{1b}[38;2;224;176;92m"))
    (assert (contains? text "\u{1b}[38;2;91;208;138m"))
    (assert (contains? text "\u{1b}[0m"))
    (assert (balanced-spans? text))))

(deftest resets-every-256-color-span
  (let (text (join (render-item (settings-256) (changes-118-item))
                   "\n"))
    (assert (contains? text "\u{1b}[38;5;"))
    (assert (contains? text "\u{1b}[0m"))
    (assert (balanced-spans? text))))

(deftest cleans-a-title
  (let (item (->item-line :time (str "14:02:12")
                          :id (str "rm-8bdc")
                          :track (track/build-track stage-state/active
                                                    stage-state/waiting
                                                    stage-state/waiting)
                          :status log-status/building
                          :title (str "a\nb\tc\u{7}d")
                          :sub-lines (vec)))
    (assert (same-lines? (render-item (settings-118) item)
                         (vec (str "14:02:12  rm-8bdc  build ▸ review ○ merge ○"
                                   "  building     a b cd"))))))

(deftest measures-a-title-in-display-columns
  (let (title (join (collect (map (range 0 40) (fn (_) (str "界"))))
                    "")
        cut (join (collect (map (range 0 29) (fn (_) (str "界"))))
                  "")
        item (->item-line :time (str "14:02:12")
                          :id (str "rm-8bdc")
                          :track (track/build-track stage-state/active
                                                    stage-state/waiting
                                                    stage-state/waiting)
                          :status log-status/building
                          :title title
                          :sub-lines (vec)))
    (assert (same-lines? (render-item (settings-118) item)
                         (vec (str "14:02:12  rm-8bdc  build ▸ review ○ merge ○"
                                   "  building     " cut
                                   "…"))))))

(deftest links-a-merged-pull-request-when-color-is-on
  (let (item (->item-line :time (str "14:18:40")
                          :id (str "rm-8bdc")
                          :track (track/build-track stage-state/done
                                                    stage-state/done
                                                    stage-state/done)
                          :status (log-status/merged 33)
                          :title (str "A title")
                          :sub-lines (vec))
        text (join (render-item (link-settings) item) "\n"))
    (assert (contains? (as-str text)
                       (as-str (str "\u{1b}]8;;https://github.com/KarlHarnois/kogworks/pull/33"
                                    "\u{1b}\\"))))
    (assert (contains? (as-str text)
                       (as-str (str "\u{1b}]8;;\u{1b}\\"))))))

(deftest leaves-a-merged-pull-request-plain-without-color
  (let (item (->item-line :time (str "14:18:40")
                          :id (str "rm-8bdc")
                          :track (track/build-track stage-state/done
                                                    stage-state/done
                                                    stage-state/done)
                          :status (log-status/merged 33)
                          :title (str "A title")
                          :sub-lines (vec))
        text (join (render-item (settings-118) item) "\n"))
    (assert (not (contains? (as-str text)
                            (as-str (str "\u{1b}]8;;")))))
    (assert (contains? (as-str text)
                       (as-str (str "merged #33"))))))

(deftest links-a-pull-request-sub-line-when-color-is-on
  (let (sub-lines (vec (sub-line/pr (->pr-summary :number 35
                                                  :branch (str "build-rm-0001")
                                                  :head none)))
        text (join (render-sub-lines (link-settings) "rm-0001" sub-lines)
                   "\n"))
    (assert (contains? (as-str text)
                       (as-str (str "\u{1b}]8;;https://github.com/KarlHarnois/kogworks/pull/35"
                                    "\u{1b}\\"))))
    (assert (contains? (as-str text)
                       (as-str (str "build-rm-0001"))))))

(deftest links-a-wrapped-pull-request-sub-line-when-color-is-on
  (let (settings (->log-settings :colors color-mode/truecolor
                                 :width (some 50)
                                 :target output-target/terminal
                                 :remote (some (str "https://github.com/KarlHarnois/kogworks")))
        sub-lines (vec (sub-line/pr (->pr-summary :number 12
                                                  :branch (str "build-rm-0009")
                                                  :head (some (str
                                                                "abcdef0")))))
        lines (render-sub-lines settings "rm-0009" sub-lines)
        text (join lines "\n"))
    (assert (> (len lines) 1))
    (assert (contains? (as-str text)
                       (as-str (str "\u{1b}]8;;https://github.com/KarlHarnois/kogworks/pull/12"
                                    "\u{1b}\\"))))
    (assert (contains? (as-str text)
                       (as-str (str "#12"))))))

(deftest shows-no-manager-when-none-is-configured
  (let (banner (->banner-line :time (str "14:02:11")
                              :roadmap (str "factory-mvp")
                              :manager none
                              :poll-seconds 30))
    (assert (same-lines? (render-banner (settings-118) banner)
                         (vec (str "14:02:11  ● kogworks  roadmap factory-mvp"
                                   " · no manager · poll 30s"))))
    (assert (contains? (join (render-banner (settings-truecolor) banner) "\n")
                       (as-str (str "\u{1b}[38;2;224;176;92mno manager\u{1b}[0m"))))))

(deftest measures-display-columns
  (for-each (vec (str "abc")
                 (str "héllo")
                 (str "界")
                 (str "🙂")
                 (str "a\u{300}b")
                 (str "コン")
                 (str "✅")
                 (str "🚀")
                 (str "⌚")
                 (str "✅✅✅")
                 (str "❤️")
                 (str "👍🏽")
                 (str "\u{17D8}")
                 (str "👨‍👩‍👧")
                 (str "🇺🇸")
                 (str "⌚\u{FE0E}")
                 (str "😀\u{FE0E}")
                 (str "a\u{FE0F}")
                 (str "1\u{FE0F}\u{20E3}"))
            (fn (text)
              (assert (= (display-width (as-str text))
                         (the int
                              (convert (unicode-width (as-str text)))))))))

(deftest renders-the-non-terminal-error-sub-line
  (assert (= (clone (at (stream-error-actual) 0))
             (str "          rm-35cb  ├─ error        PR 34 head is 4f5a6b7,"
                  " not the approved 9f1c2ab"))))

(deftest never-cuts-a-command
  (let (lines (failed-command-actual)
        command-lines (vec (clone (at lines 2))
                           (clone (at lines 3)))
        command (join command-lines "\n"))
    (assert (contains? (as-str command)
                       (as-str (str
                                 "ringleader new --name review-rm-77c0-a81f0c2"
                                 " --repo ."))))
    (assert (contains? (as-str command)
                       (as-str (str "--agent claude --prompt <filled brief>"))))
    (assert (not (contains? (as-str command)
                            (as-str (str "…")))))))

(deftest switches-to-glyph-track-below-110-columns
  (let (item (bdc-building)
        narrow (->log-settings :colors color-mode/no-color
                               :width (some 109)
                               :target output-target/terminal
                               :remote none)
        wide (->log-settings :colors color-mode/no-color
                             :width (some 110)
                             :target output-target/terminal
                             :remote none))
    (assert (contains? (as-str (join (render-item narrow item) "\n"))
                       (as-str (str "▸○○"))))
    (assert (not (contains? (as-str (join (render-item narrow item) "\n"))
                            (as-str (str "build ▸")))))
    (assert (contains? (as-str (join (render-item wide (bdc-building)) "\n"))
                       (as-str (str "build ▸"))))))

(deftest cuts-an-emoji-presentation-title-at-80-columns
  (let (marks (join (collect (map (range 0 30) (fn (_) (str "❤️"))))
                    "")
        cut (join (collect (map (range 0 21) (fn (_) (str "❤️"))))
                  "")
        item (->item-line :time (str "14:02:12")
                          :id (str "rm-8bdc")
                          :track (track/build-track stage-state/active
                                                    stage-state/waiting
                                                    stage-state/waiting)
                          :status log-status/building
                          :title marks
                          :sub-lines (vec)))
    (assert (same-lines? (render-item (settings-80) item)
                         (vec (str "14:02:12  rm-8bdc  ▸○○  building     "
                                   cut "…"))))))

(deftest keeps-an-emoji-modifier-sequence-title
  (let (title (join (collect (map (range 0 20) (fn (_) (str "👍🏽"))))
                    "")
        item (->item-line :time (str "14:02:12")
                          :id (str "rm-8bdc")
                          :track (track/build-track stage-state/active
                                                    stage-state/waiting
                                                    stage-state/waiting)
                          :status log-status/building
                          :title (clone title)
                          :sub-lines (vec)))
    (assert (same-lines? (render-item (settings-80) item)
                         (vec (str "14:02:12  rm-8bdc  ▸○○  building     "
                                   title))))))

(deftest renders-an-empty-sub-line-value
  (let (item (->item-line :time (str "14:02:12")
                          :id (str "rm-8bdc")
                          :track (track/build-track stage-state/done
                                                    stage-state/sent-back
                                                    stage-state/waiting)
                          :status log-status/changes
                          :title (str "Empty note")
                          :sub-lines (vec (sub-line/criterion 2 (str)))))
    (assert (same-lines? (render-item (settings-118) item)
                         (vec (str "14:02:12  rm-8bdc  build ✓ review ↺ merge ○"
                                   "  changes      Empty note")
                              (str "          ╰─ criterion 2  "))))))

(deftest renders-the-styled-parts-in-truecolor
  (let (reset "\u{1b}[0m"
        secondary "\u{1b}[38;2;122;127;135m"
        bold "\u{1b}[1m"
        success "\u{1b}[38;2;91;208;138m"
        failure "\u{1b}[38;2;242;95;92m"
        outcome "\u{1b}[38;2;224;176;92m"
        banner (render-banner (settings-truecolor)
                              (->banner-line :time (str "14:02:11")
                                             :roadmap (str "factory-mvp")
                                             :manager (some (str "kw-manager"))
                                             :poll-seconds 30))
        item (render-item (settings-truecolor) (changes-118-item))
        stop (render-stop (settings-truecolor)
                          (->stop-line
                            :time (str "14:23:02")
                            :merged 1
                            :accepted 1
                            :failed 1
                            :running (vec (->running-item
                                            :id (str "rm-9a01")
                                            :status running-status/building
                                            :minutes 4))
                            :rerun (str "kogworks controller --repo . --poll 30"))))
    (assert (same-lines?
              banner
              (vec (str secondary "14:02:11" reset "  ● "
                        bold "kogworks" reset "  " secondary
                        "roadmap" reset " factory-mvp "
                        secondary "·" reset " " secondary
                        "manager" reset " kw-manager "
                        secondary "·" reset " " secondary
                        "poll 30s" reset))))
    (assert (same-lines?
              item
              (vec (str secondary "14:09:12" reset "  " bold
                        "rm-8bdc" reset "  " secondary
                        "build" reset " " success "✓" reset
                        " " bold "review" reset " " outcome
                        "↺" reset " " secondary "merge"
                        reset " " secondary "○" reset "  "
                        outcome "changes" reset "      "
                        "Disarm auto-merge when the approved head changes"
                        " or the ite…")
                   (str "          " secondary "├─ " reset
                        secondary "criterion 2" reset
                        "  no test shows the disarm when the approved"
                        " head changes")
                   (str "          " secondary "├─ " reset
                        secondary "criterion 4" reset
                        "  the return to fixing leaves auto-merge armed")
                   (str "          " secondary "╰─ " reset
                        secondary "reviewer" reset
                        "     review-rm-8bdc-7da1703, behavior review"))))
    (assert
      (same-lines?
        stop
        (vec (str secondary "14:23:02" reset "  " failure
                  "■" reset " " bold "controller stopped"
                  reset "  " success "1 merged" reset " "
                  secondary "·" reset " " success
                  "1 accepted" reset " " secondary "·" reset
                  " " failure "1 failed" reset " " secondary
                  "·" reset " 1 running")
             (str "          " secondary "├─ " reset
                  secondary "running" reset "      " bold
                  "rm-9a01" reset " building 4m " secondary
                  "· its session keeps running" reset)
             (str "          " secondary "╰─ " reset
                  secondary "rerun" reset "        " bold
                  "kogworks controller --repo . --poll 30"
                  reset))))
    (assert (balanced-spans? (join banner "\n")))
    (assert (balanced-spans? (join item "\n")))
    (assert (balanced-spans? (join stop "\n")))))

(deftest colors-the-owner-on-a-forced-color-stream
  (let (settings (->log-settings :colors color-mode/truecolor
                                 :width none
                                 :target output-target/stream
                                 :remote none)
        sub-lines (vec (sub-line/manager (str "kw-manager")))
        line (join (render-sub-lines settings "rm-35cb" sub-lines) "\n"))
    (assert (contains? line
                       (as-str (str "\u{1b}[38;2;122;127;135mrm-35cb\u{1b}[0m  "))))
    (assert (balanced-spans? line))))

(deftest colors-a-wrapped-running-sub-line
  (let (reset "\u{1b}[0m"
        secondary "\u{1b}[38;2;122;127;135m"
        bold "\u{1b}[1m"
        settings (->log-settings :colors color-mode/truecolor
                                 :width (some 47)
                                 :target output-target/terminal
                                 :remote none)
        item (->running-item :id (str "rm-9a01")
                             :status running-status/building
                             :minutes 4)
        lines (render-sub-lines settings "rm-9a01"
                                (vec (sub-line/running item)))
        indent "                "
        wrapped (str indent secondary "its session keeps" reset)
        last (str indent secondary "running" reset))
    (assert (same-lines?
              lines
              (vec (str "          " secondary "╰─ " reset
                        secondary "running" reset "      "
                        bold "rm-9a01" reset " building 4m "
                        secondary "·" reset)
                   (str "          " wrapped)
                   (str "          " last))))
    (assert (balanced-spans? (join lines "\n")))))
