(use controller/failure merge-error merge-error->message)

(use fixtures/controller-fixture default-settings exit-code
                                 prepare-repo read-text
                                 run-controller stderr-text
                                 write-fakes)

(def merge-slug (str "fake-owner/fake-repo"))

(def moved-head
  (str "1234567890abcdef1234567890abcdef12345678"))

(def merge-next
  (str "{\"next\":[{\"item\":\"" merge-item
       "\",\"actions\":["
       "{\"action\":\"merge\",\"actor\":\"controller\"}]}]}"))

(def merge-item-json
  (str "{\"item\":{\"id\":\"" merge-item "\","
       "\"title\":\"Merge the approved head\","
       "\"kind\":\"build\"," "\"status\":\"in_review\","
       "\"session\":{\"name\":\"" merge-worker
       "\",\"branch\":\"" merge-worker "\"}},"
       "\"pull_request\":{\"number\":" merge-pr ","
       "\"head\":\"" approved-head "\","
       "\"approved\":true," "\"approval\":{\"head\":\""
       approved-head "\"}}}"))

(def fixing-item-json
  (str "{\"item\":{\"id\":\"" merge-item "\","
       "\"title\":\"Merge the approved head\","
       "\"kind\":\"build\"," "\"status\":\"fixing\","
       "\"session\":{\"name\":\"" merge-worker
       "\",\"branch\":\"" merge-worker "\"}},"
       "\"pull_request\":{\"number\":" merge-pr ","
       "\"head\":\"" approved-head "\","
       "\"approved\":false," "\"approval\":{\"head\":\""
       approved-head "\"}}}"))

(def unapproved-item-json
  (str "{\"item\":{\"id\":\"" merge-item "\","
       "\"title\":\"Merge the approved head\","
       "\"kind\":\"build\"," "\"status\":\"in_review\","
       "\"session\":{\"name\":\"" merge-worker
       "\",\"branch\":\"" merge-worker "\"}},"
       "\"pull_request\":{\"number\":" merge-pr ","
       "\"head\":\"" approved-head "\","
       "\"approved\":false," "\"approval\":{\"head\":\""
       approved-head "\"}}}"))

(def merging-item-json
  (str "{\"item\":{\"id\":\"" merge-item "\","
       "\"title\":\"Merge the approved head\","
       "\"kind\":\"build\"," "\"status\":\"merging\","
       "\"session\":{\"name\":\"" merge-worker
       "\",\"branch\":\"" merge-worker "\"}},"
       "\"pull_request\":{\"number\":" merge-pr ","
       "\"head\":\"" approved-head "\","
       "\"approved\":true," "\"approval\":{\"head\":\""
       approved-head "\"}}}"))

(def merge-item (str "rm-0009"))

(def merge-pr (str "12"))

(def merge-worker (str "build-rm-0009"))

(def merged-view
  (str "{\"state\":\"MERGED\",\"mergedAt\":\"2026-11-26T00:00:00Z\","
       "\"headRefOid\":\"" approved-head "\"}"))

(def open-view
  (str "{\"state\":\"OPEN\",\"mergedAt\":null,"
       "\"headRefOid\":\"" approved-head "\"}"))

(def clean-status-error
  (str "failed to enable auto-merge: Pull request is in clean status"
       " (enablePullRequestAutoMerge)"))

(def already-disarmed-error
  (str "failed to disable auto-merge: Pull request is not in auto merge state"
       " (disablePullRequestAutoMerge)"))

(def network-error
  (str "Post \"https://api.github.com/graphql\":"
       " net/http: TLS handshake timeout"))

(def conflict-error
  (str "Pull Request has merge conflicts"))

(def approved-head
  (str "abcdef0123456789abcdef0123456789abcdef01"))

(defn armed-view ()
  (str "{\"state\":\"OPEN\",\"headRefOid\":\"" approved-head
       "\","
       "\"autoMergeRequest\":{\"enabledAt\":\"2026-11-26T00:00:00Z\","
       "\"mergeMethod\":\"MERGE\"}}"))

(defn unarmed-view ()
  (str "{\"state\":\"OPEN\",\"headRefOid\":\"" approved-head
       "\"," "\"autoMergeRequest\":null}"))

(defn merged-resume-view ()
  (str "{\"state\":\"MERGED\",\"headRefOid\":\""
       approved-head "\"," "\"autoMergeRequest\":null}"))

(defn moved-resume-view ()
  (str "{\"state\":\"OPEN\",\"headRefOid\":\"" moved-head
       "\"," "\"autoMergeRequest\":null}"))

(defn assert-transient-retry (name error)
  (let (root (unwrap-ok (setup name
                               (assoc (merge-settings)
                                      :merge-network-failures 1
                                      :network-error (clone error)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root)
                 (str (merge-preface)
                      (merge-line)
                      (show-line)
                      (view-line)
                      (close-line))))
      (assert (contains? (stderr-text output)
                         (as-str (str "● kogworks")))))))

(defn moved-view ()
  (str "{\"state\":\"OPEN\",\"mergedAt\":null,"
       "\"headRefOid\":\"" moved-head "\"}"))

(defn merge-settings ()
  (assoc (default-settings (clone merge-next) (str "{\"ready\":[]}"))
         :item-json (clone merge-item-json)
         :slug (clone merge-slug)
         :allow-auto-merge (str "true")
         :required-checks (str "1")
         :view-json (clone merged-view)))

(defn setup (name settings)
  (let (root (str "target/knave/controller-tests/" name))
    (match (prepare-repo (as-str root))
      ((err reason) (err reason))
      ((ok _)
       (match (write-fakes (as-str root) settings)
         ((err reason) (err reason))
         ((ok _) (ok root)))))))

(defn run (root)
  (run-with root
            (vec (str "--once")
                 (str "--merge-retry-delay")
                 (str "0"))))

(defn run-with (root args)
  (run-controller (as-str (str root "/bin"))
                  (as-str (str root "/repo"))
                  args))

(defn sequence-text (root)
  (unwrap-ok (read-text (as-str (str root "/sequence")))))

(defn stderr-has? (output text)
  (contains? (stderr-text output) (as-str text)))

(defn appears-before? (text first second)
  (let (parts (collect (map (split (as-str text) (as-str first))
                         (fn (part) (str part)))))
    (if (< (len parts) 2)
      false
      (contains? (join (collect (map (range 1 (len parts))
                                  (fn (index) (clone (at parts index)))))
                       (as-str first))
                 (as-str second)))))

(defn merged-sequence ()
  (str (poll-preface)
       (view-line)
       (close-line)))

(defn clean-status-sequence ()
  (str (merge-preface)
       (direct-merge-line)
       (show-line)
       (view-line)
       (close-line)))

(defn poll-preface ()
  (str (merge-preface) (show-line)))

(defn view-line ()
  (str "gh pr view " merge-pr
       " --json state,mergedAt,headRefOid\n"))

(defn resume-view-line ()
  (str "gh pr view " merge-pr
       " --json state,headRefOid,autoMergeRequest\n"))

(defn disarm-line ()
  (str "gh pr merge " merge-pr " --disable-auto\n"))

(defn close-line ()
  (str "rmap item close " merge-item "\n"))

(defn merge-preface ()
  (str (preflight-preface)
       (required-checks-line)
       (advance-line)
       (merge-line)))

(defn required-checks-line ()
  (str "gh api repos/" merge-slug
       "/branches/main/protection"
       " --jq .required_status_checks.contexts | length\n"))

(defn advance-line ()
  (str "rmap item advance " merge-item " merging\n"))

(defn merge-line ()
  (str "gh pr merge " merge-pr
       " --auto --merge --match-head-commit " approved-head
       "\n"))

(defn direct-merge-line ()
  (str "gh pr merge " merge-pr
       " --merge --match-head-commit " approved-head "\n"))

(defn update-branch-line ()
  (str "gh pr update-branch " merge-pr "\n"))

(defn fixing-line ()
  (str "rmap item advance " merge-item " fixing\n"))

(defn record-head-line (head)
  (str "rmap pr head " merge-item " " head "\n"))

(defn worker-send-line (message)
  (str "ringleader send " merge-worker " " message "\n"))

(defn rebase-text ()
  (str "rebase: " merge-item ": PR " merge-pr
       " has merge conflicts and `gh pr update-branch "
       merge-pr "` exited 4: branch cannot be updated."
       " Rebase the pull request branch on main, push it, and record"
       " a fixed report with the new head. A fresh review is needed"
       " at the new head."))

(defn preflight-preface ()
  (str (next-line)
       (show-line)
       (repo-view-line)
       (auto-merge-line)))

(defn next-line ()
  (str "rmap next --roadmap fake-roadmap --json\n"))

(defn show-line ()
  (str "rmap item show " merge-item " --json\n"))

(defn repo-view-line ()
  (str "gh repo view --json nameWithOwner -q .nameWithOwner\n"))

(defn auto-merge-line ()
  (str "gh api repos/" merge-slug " --jq .allow_auto_merge\n"))

(defn refusal-sequence (lines message)
  (str lines (send-line message) (show-line)))

(defn send-line (message)
  (str "ringleader send fake-manager " message "\n"))

(deftest merges-the-approved-head-and-closes-the-item
  (let (root (unwrap-ok (setup "merge" (merge-settings))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root) (merged-sequence)))
      (assert (contains? (stderr-text output)
                         (as-str (str "● kogworks")))))))

(deftest records-the-new-head-when-the-update-moves-the-head
  (let (root (unwrap-ok (setup "merge-conflict-update-moved"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone conflict-error)
                                      :view-json (moved-view)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root)
                 (str (merge-preface)
                      (update-branch-line)
                      (view-line)
                      (record-head-line moved-head))))
      (assert (not (contains? (sequence-text root) "item close")))
      (assert (not (contains? (sequence-text root) "ringleader send")))
      (assert (contains? (stderr-text output)
                         (as-str (str "● kogworks"))))
      (assert (stderr-has? output (str "merging"))))))

(deftest retries-the-merge-when-the-update-leaves-the-head
  (let (root (unwrap-ok (setup "merge-conflict-update-same"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone conflict-error)
                                      :view-json (clone open-view)
                                      :later-view-json (clone merged-view)))))
    (let (output (unwrap-ok (run-with root
                                      (vec (str "--once")
                                           (str "--merge-poll")
                                           (str "0")))))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root)
                 (str (merge-preface)
                      (update-branch-line)
                      (view-line)
                      (merge-line)
                      (show-line)
                      (view-line)
                      (close-line))))
      (assert (not (contains? (sequence-text root) "pr head")))
      (assert (contains? (stderr-text output)
                         (as-str (str "● kogworks")))))))

(deftest rebases-a-conflicted-branch-when-the-update-is-refused
  (let (root (unwrap-ok (setup "merge-conflict-rebase"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone conflict-error)
                                      :update-branch-exit 4
                                      :update-branch-error (str "branch cannot be updated")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root)
                 (str (merge-preface)
                      (update-branch-line)
                      (fixing-line)
                      (show-line)
                      (worker-send-line (rebase-text)))))
      (assert (not (contains? (sequence-text root) "pr view")))
      (assert (not (contains? (sequence-text root) "item close")))
      (assert (contains? (stderr-text output)
                         (as-str (str "● kogworks"))))
      (assert (stderr-has? output (str "merging"))))))

(deftest merges-directly-when-auto-merge-is-refused-for-a-clean-pull-request
  (let (root (unwrap-ok (setup "merge-clean-status"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone
                                                     clean-status-error)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root) (clean-status-sequence)))
      (assert (contains? (stderr-text output)
                         (as-str (str "● kogworks"))))
      (assert (appears-before? (stderr-text output)
                               (str "merging")
                               (str "merged #12"))))))

(deftest stops-when-the-clean-pull-request-merge-is-refused
  (let (root (unwrap-ok (setup "merge-clean-status-refused"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone clean-status-error)
                                      :direct-merge-exit 4
                                      :direct-merge-error (str "direct merge refused")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (merge-preface) (direct-merge-line))
                                   (str "merge: " merge-item
                                        ": `gh pr merge "
                                        merge-pr
                                        " --merge --match-head-commit "
                                        approved-head
                                        "` exited 4: direct merge refused"))))
      (assert (not (contains? (sequence-text root) "pr view")))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest stops-before-advancing-when-auto-merge-is-disabled
  (let (root (unwrap-ok (setup "merge-auto-off"
                               (assoc (merge-settings)
                                      :allow-auto-merge (str "false")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence
                   (preflight-preface)
                   (str "merge: " merge-item
                        ": `gh api repos/" merge-slug
                        " --jq .allow_auto_merge` printed `false`,"
                        " not `true`"))))
      (assert (stderr-has? output (str "#12  build-rm-0009 @ abcdef0")))
      (assert (not (contains? (sequence-text root) "item advance"))))))

(deftest stops-before-advancing-without-a-required-check
  (let (root (unwrap-ok (setup "merge-no-check"
                               (assoc (merge-settings)
                                      :required-checks (str "0")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence
                   (str (preflight-preface) (required-checks-line))
                   (str "merge: " merge-item
                        ": `gh api repos/" merge-slug
                        "/branches/main/protection --jq"
                        " .required_status_checks.contexts | length`"
                        " reports no required status check"))))
      (assert (not (contains? (sequence-text root) "item advance"))))))

(deftest stops-before-advancing-when-the-settings-call-is-refused
  (let (root (unwrap-ok (setup "merge-settings-refused"
                               (assoc (merge-settings)
                                      :api-exit 4
                                      :api-error (str "forbidden")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (preflight-preface)
                                   (str "merge: " merge-item
                                        ": `gh api repos/"
                                        merge-slug
                                        " --jq .allow_auto_merge` exited 4:"
                                        " forbidden"))))
      (assert (not (contains? (sequence-text root) "item advance"))))))

(deftest stops-when-the-head-moved
  (let (root (unwrap-ok (setup "merge-head-moved"
                               (assoc (merge-settings)
                                      :view-json (moved-view)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence
                   (str (poll-preface)
                        (view-line)
                        (disarm-line))
                   (str "merge: " merge-item ": PR "
                        merge-pr " head is " moved-head
                        ", not the approved "
                        approved-head))))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest stops-when-the-disarm-after-a-head-change-is-refused
  (let (root (unwrap-ok (setup "merge-disarm-refused"
                               (assoc (merge-settings)
                                      :view-json (moved-view)
                                      :disarm-exit 9
                                      :disarm-error (str "cannot disarm")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (poll-preface)
                                        (view-line)
                                        (disarm-line))
                                   (str "merge: " merge-item
                                        ": `gh pr merge "
                                        merge-pr
                                        " --disable-auto` exited 9: cannot disarm"))))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest retries-the-disarm-after-a-transient-network-error
  (let (root (unwrap-ok (setup "merge-disarm-network-retry"
                               (assoc (merge-settings)
                                      :view-json (moved-view)
                                      :disarm-network-failures 1
                                      :network-error (clone network-error)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence
                   (str (poll-preface)
                        (view-line)
                        (disarm-line)
                        (disarm-line))
                   (str "merge: " merge-item ": PR "
                        merge-pr " head is " moved-head
                        ", not the approved "
                        approved-head))))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest keeps-the-intended-message-when-auto-merge-is-already-off
  (let (root (unwrap-ok (setup "merge-disarm-already-off"
                               (assoc (merge-settings)
                                      :item-later-json (clone fixing-item-json)
                                      :disarm-exit 1
                                      :disarm-error (clone already-disarmed-error)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (poll-preface) (disarm-line))
                                   (str "merge: " merge-item
                                        ": the item is fixing, so auto-merge on PR "
                                        merge-pr
                                        " is disarmed"))))
      (assert (not (contains? (sequence-text root) "pr view")))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest disarms-when-the-item-returns-to-fixing
  (let (root (unwrap-ok (setup "merge-fixing"
                               (assoc (merge-settings)
                                      :item-later-json (clone
                                                         fixing-item-json)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (poll-preface) (disarm-line))
                                   (str "merge: " merge-item
                                        ": the item is fixing, so auto-merge on PR "
                                        merge-pr
                                        " is disarmed"))))
      (assert (not (contains? (sequence-text root) "pr view")))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest disarms-before-arming-when-the-item-is-fixing
  (let (root (unwrap-ok (setup "merge-fixing-start"
                               (assoc (merge-settings)
                                      :item-json (clone fixing-item-json)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (next-line)
                                        (show-line)
                                        (disarm-line))
                                   (str "merge: " merge-item
                                        ": the item is fixing, so auto-merge on PR "
                                        merge-pr
                                        " is disarmed"))))
      (assert (not (contains? (sequence-text root) "allow_auto_merge")))
      (assert (not (contains? (sequence-text root) "item advance")))
      (assert (not (contains? (sequence-text root) "--auto"))))))

(deftest stops-before-arming-without-an-approving-review
  (let (root (unwrap-ok (setup "merge-not-approved"
                               (assoc (merge-settings)
                                      :item-json (clone
                                                   unapproved-item-json)))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (next-line)
                                        (show-line)
                                        (disarm-line))
                                   (str "merge: " merge-item
                                        ": PR " merge-pr
                                        " is not approved at head "
                                        approved-head))))
      (assert (not (contains? (sequence-text root) "item advance")))
      (assert (not (contains? (sequence-text root) "--auto"))))))

(deftest disarms-when-the-poll-view-is-refused
  (let (root (unwrap-ok (setup "merge-view-refused"
                               (assoc (merge-settings)
                                      :view-exit 9
                                      :view-error (str "view refused")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (poll-preface)
                                        (view-line)
                                        (disarm-line))
                                   (str "merge: " merge-item
                                        ": `gh pr view "
                                        merge-pr
                                        " --json state,mergedAt,headRefOid`"
                                        " exited 9: view refused"))))
      (assert (stderr-has? output (str "#12  build-rm-0009 @ abcdef0")))
      (assert (stderr-has? output
                           (str "disarmed     gh pr merge 12 --disable-auto")))
      (assert (stderr-has? output (str "build ✓ review ✓ merge ✗")))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest disarms-when-the-poll-view-is-invalid
  (let (root (unwrap-ok (setup "merge-view-invalid"
                               (assoc (merge-settings) :view-json (str "{")))))
    (let (output (unwrap-ok (run root)))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (refusal-sequence (str (poll-preface)
                                        (view-line)
                                        (disarm-line))
                                   (str "merge: " merge-item
                                        ": `gh pr view "
                                        merge-pr
                                        " --json state,mergedAt,headRefOid`"
                                        " exited 0: invalid poll JSON:"
                                        " unexpected end at 1"))))
      (assert (stderr-has? output
                           (str "disarmed     gh pr merge 12 --disable-auto")))
      (assert (not (contains? (sequence-text root) "item close"))))))

(deftest disarms-when-the-poll-item-show-is-refused
