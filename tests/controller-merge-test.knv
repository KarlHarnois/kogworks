(use fixtures/controller-fixture default-settings exit-code
                                 prepare-repo read-text
                                 run-controller stderr-text
                                 write-fakes write-text)

(def merge-next
  (str "{\"next\":[{\"item\":\"" merge-item
       "\",\"actions\":["
       "{\"action\":\"merge\",\"actor\":\"controller\"}]}]}"))

(def merging-item-json (item-json (str "merging") true))

(def fixing-item-json (item-json (str "fixing") false))

(def unapproved-item-json (item-json (str "merging") false))

(def approved-item-json (item-json (str "in_review") true))

(def merged-view
  (str "{\"state\":\"MERGED\",\"headRefOid\":\""
       approved-head "\"," "\"autoMergeRequest\":null}"))

(def open-view
  (str "{\"state\":\"OPEN\",\"headRefOid\":\"" approved-head
       "\"," "\"autoMergeRequest\":null}"))

(def armed-view
  (str "{\"state\":\"OPEN\",\"headRefOid\":\"" approved-head
       "\","
       "\"autoMergeRequest\":{\"enabledAt\":\"2026-11-26T00:00:00Z\","
       "\"mergeMethod\":\"MERGE\"}}"))

(def moved-view
  (str "{\"state\":\"OPEN\",\"headRefOid\":\"" moved-head
       "\"," "\"autoMergeRequest\":null}"))

(def review-next
  (str "{\"next\":[{\"item\":\"" review-item
       "\",\"actions\":["
       "{\"action\":\"review\",\"actor\":\"controller\"}]}]}"))

(def review-item-json
  (str "{\"item\":{\"id\":\"" review-item "\","
       "\"title\":\"Start a review\"," "\"kind\":\"build\","
       "\"criteria\":[\"the controller starts one reviewer\"],"
       "\"session\":{\"branch\":\"" review-branch
       "\",\"kind\":\"work\",\"name\":\"" review-branch
       "\"}," "\"status\":\"in_review\"},"
       "\"pull_request\":{\"number\":21,\"head\":\""
       approved-head "\"}}"))

(def merge-slug (str "fake-owner/fake-repo"))

(def merge-item (str "rm-0009"))

(def second-item (str "rm-0010"))

(def merge-pr (str "12"))

(def second-pr (str "13"))

(def merge-worker (str "build-rm-0009"))

(def approved-head
  (str "abcdef0123456789abcdef0123456789abcdef01"))

(def moved-head
  (str "1234567890abcdef1234567890abcdef12345678"))

(def empty-next (str "{\"next\":[]}"))

(def empty-ready (str "{\"ready\":[]}"))

(def clean-status-error
  (str "failed to enable auto-merge: Pull request is in clean status"
       " (enablePullRequestAutoMerge)"))

(def conflict-error
  (str "Pull Request has merge conflicts"))

(def network-error
  (str "Post \"https://api.github.com/graphql\":"
       " net/http: TLS handshake timeout"))

(def old-log
  (str "{\"events\":[{\"at\":\"2020-01-01T00:00:00Z\","
       "\"type\":\"item-advanced\","
       "\"payload\":{\"changes\":{\"status\":"
       "{\"new\":\"merging\",\"old\":\"in_review\"}}}}]}"))

(def build-ready
  (str "{\"ready\":[{\"id\":\"rm-0001\",\"kind\":\"build\"}]}"))

(def review-item (str "rm-0002"))

(def review-session (str "review-rm-0002-abcdef0"))

(def review-branch (str "build-rm-0002"))

(defn preflight-lines ()
  (str (show-line merge-item)
       (repo-view-line)
       (auto-merge-line)
       (required-checks-line)
       (advance-line)
       (merge-line)))

(defn setup-timeout (name settings)
  (match (setup-merging name settings merging-item-json)
    ((err reason) (err reason))
    ((ok root)
     (match (write-file root (str "log-" merge-item ".json") old-log)
       ((err reason) (err reason))
       ((ok _) (ok root))))))

(defn setup-two (name settings)
  (match (setup name settings)
    ((err reason) (err reason))
    ((ok root)
     (match (two-item-files root)
       ((err reason) (err reason))
       ((ok _) (ok root))))))

(defn setup-merging (name settings text)
  (match (setup name settings)
    ((err reason) (err reason))
    ((ok root)
     (match (item-file root merge-item text)
       ((err reason) (err reason))
       ((ok _) (ok root))))))

(defn two-item-files (root)
  (let-try (_ (item-file root merge-item merging-item-json)
            _ (item-file
                root second-item
                (item-json-for second-item (str "merging") true second-pr))
            _ (write-file root (str "view-" merge-pr ".json") armed-view))
    (write-file root (str "view-" second-pr ".json") armed-view)))

(defn item-file (root id text)
  (write-file root (str "item-" id ".json") text))

(defn write-file (root name text)
  (write-text (as-str (str root "/" name))
              (as-str text)))

(defn setup (name settings)
  (let (root (str "target/knave/controller-tests/" name))
    (match (prepare-repo (as-str root))
      ((err reason) (err reason))
      ((ok _)
       (match (write-fakes (as-str root) settings)
         ((err reason) (err reason))
         ((ok _) (ok root)))))))

(defn run (root)
  (run-with root
            (vec (str "--once")
                 (str "--merge-retry-delay")
                 (str "0"))))

(defn poll (root)
  (run-with root
            (vec (str "--poll")
                 (str "0")
                 (str "--merge-retry-delay")
                 (str "0"))))

(defn run-with (root args)
  (run-controller (as-str (str root "/bin"))
                  (as-str (str root "/repo"))
                  args))

(defn sequence-text (root)
  (unwrap-ok (read-text (as-str (str root "/sequence")))))

(defn stderr-has? (output text)
  (contains? (stderr-text output) (as-str text)))

(defn occurrences (text needle)
  (dec (len (collect (split (as-str text) (as-str needle))))))

(defn next-line ()
  (str "rmap next --roadmap fake-roadmap --json\n"))

(defn ready-line ()
  (str "rmap ready --roadmap fake-roadmap --json\n"))

(defn show-line (item)
  (str "rmap item show " item " --json\n"))

(defn repo-view-line ()
  (str "gh repo view --json nameWithOwner -q .nameWithOwner\n"))

(defn auto-merge-line ()
  (str "gh api repos/" merge-slug " --jq .allow_auto_merge\n"))

(defn required-checks-line ()
  (str "gh api repos/" merge-slug
       "/branches/main/protection"
       " --jq .required_status_checks.contexts | length\n"))

(defn advance-line ()
  (str "rmap item advance " merge-item " merging\n"))

(defn fixing-line ()
  (str "rmap item advance " merge-item " fixing\n"))

(defn merge-line ()
  (str "gh pr merge " merge-pr
       " --auto --merge --match-head-commit " approved-head
       "\n"))

(defn direct-merge-line ()
  (str "gh pr merge " merge-pr
       " --merge --match-head-commit " approved-head "\n"))

(defn update-branch-line ()
  (str "gh pr update-branch " merge-pr "\n"))

(defn disarm-line (pr)
  (str "gh pr merge " pr " --disable-auto\n"))

(defn resume-view-line (pr)
  (str "gh pr view " pr
       " --json state,headRefOid,autoMergeRequest\n"))

(defn close-line (item) (str "rmap item close " item "\n"))

(defn record-head-line (head)
  (str "rmap pr head " merge-item " " head "\n"))

(defn worker-send-line (message)
  (str "ringleader send " merge-worker " " message "\n"))

(defn rebase-text ()
  (str "rebase: " merge-item ": PR " merge-pr
       " has merge conflicts and `gh pr update-branch "
       merge-pr "` exited 4: branch cannot be updated."
       " Rebase the pull request branch on main, push it, and record"
       " a fixed report with the new head. A fresh review is needed"
       " at the new head."))

(defn merge-settings ()
  (assoc (default-settings (clone merge-next) (clone empty-ready))
         :item-json (clone approved-item-json)
         :slug (clone merge-slug)
         :allow-auto-merge (str "true")
         :required-checks (str "1")
         :view-json (clone merged-view)))

(defn item-json (status approved)
  (item-json-for merge-item status approved merge-pr))

(defn item-json-for (id status approved pull-request)
  (str "{\"item\":{\"id\":\"" id "\","
       "\"title\":\"Merge the approved head\","
       "\"kind\":\"build\",\"status\":\"" status "\","
       "\"session\":{\"name\":\"" merge-worker
       "\",\"branch\":\"" merge-worker "\"}},"
       "\"pull_request\":{\"number\":" pull-request ","
       "\"head\":\"" approved-head "\"," "\"approved\":"
       (if approved "true" "false")
       "," "\"approval\":{\"head\":\"" approved-head
       "\"}}}"))

(defn merging-items (ids)
  (str "{\"items\":["
       (join (collect (map (iter ids)
                        (fn (id)
                          (str "{\"id\":\"" id "\",\"status\":\"merging\"}"))))
             ",")
       "]}"))

(deftest arms-without-waiting
  (let (root (unwrap-ok (setup "merge-arm" (merge-settings)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (next-line) (preflight-lines))))
    (assert (not (contains? (sequence-text root) "pr view")))
    (assert (not (contains? (sequence-text root) "item close")))
    (assert (= (occurrences (stderr-text output) (str "merging"))
               1))))

(deftest prints-nothing-while-the-pull-request-is-open
  (let (root (unwrap-ok (setup-merging "merge-open"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-json (clone armed-view))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (show-line merge-item)
                    (resume-view-line merge-pr)
                    (next-line)
                    (ready-line))))
    (assert (not (stderr-has? output (str "merging"))))
    (assert (not (stderr-has? output (str "merged #"))))))

(deftest closes-a-merge-that-finished-while-the-controller-was-down
  (let (root (unwrap-ok (setup-merging "merge-finished"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-json (clone merged-view))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (show-line merge-item)
                    (resume-view-line merge-pr)
                    (close-line merge-item)
                    (next-line)
                    (ready-line))))
    (assert (= (occurrences (stderr-text output) (str "merged #12"))
               1))))

(deftest closes-on-a-later-pass
  (let (root (unwrap-ok (setup-merging "merge-later"
                                       (assoc
                                         (merge-settings)
                                         :items-json (merging-items (vec (clone merge-item)))
                                         :view-json (clone open-view)
                                         :later-view-json (clone merged-view)
                                         :stop-after 3)
                                       (clone merging-item-json)))
        output (unwrap-ok (poll root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (close-line merge-item))))
    (assert (= (occurrences (stderr-text output) (str "merged #12"))
               1))))

(deftest checks-every-merging-build-each-pass
  (let (root (unwrap-ok (setup-two "merge-two"
                                   (assoc (merge-settings)
                                          :items-json (merging-items (vec
                                                                       (clone merge-item)
                                                                       (clone second-item))))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (show-line merge-item)
                    (resume-view-line merge-pr)
                    (show-line second-item)
                    (resume-view-line second-pr)
                    (next-line)
                    (ready-line))))))

(deftest dispatches-while-a-pull-request-stays-open
  (let (root (unwrap-ok (setup-merging "merge-dispatch"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-json (clone armed-view)
                                              :next-json (clone empty-next)
                                              :ready-json (clone build-ready))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (contains? (sequence-text root)
                       (as-str (str "rmap item claim rm-0001"))))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest starts-a-review-while-a-pull-request-stays-open
  (let (root (unwrap-ok (setup-merging "merge-review"
                                       (assoc
                                         (merge-settings)
                                         :items-json (merging-items (vec (clone merge-item)))
                                         :view-json (clone armed-view)
                                         :next-json (clone review-next)
                                         :item-json (clone review-item-json))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (contains?
              (sequence-text root)
              (as-str (str "rmap review start " review-item
                           " --session " review-session))))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest re-arms-an-open-pull-request-that-is-not-armed
  (let (root (unwrap-ok (setup-merging "merge-rearm"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-json (clone open-view))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (show-line merge-item)
                    (resume-view-line merge-pr)
                    (merge-line)
                    (next-line)
                    (ready-line))))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest merges-directly-when-auto-merge-is-refused-for-a-clean-pull-request
  (let (root (unwrap-ok (setup "merge-clean"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone clean-status-error))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (next-line)
                    (preflight-lines)
                    (direct-merge-line)
                    (close-line merge-item))))
    (assert (= (occurrences (stderr-text output) (str "merged #12"))
               1))))

(deftest records-the-new-head-when-the-update-moves-the-head
  (let (root (unwrap-ok (setup "merge-update-moved"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone conflict-error)
                                      :view-json (clone moved-view))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (next-line)
                    (preflight-lines)
                    (update-branch-line)
                    (resume-view-line merge-pr)
                    (record-head-line moved-head))))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest retries-the-merge-when-the-update-leaves-the-head
  (let (root (unwrap-ok (setup "merge-update-same"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone conflict-error)
                                      :view-json (clone open-view))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (next-line)
                    (preflight-lines)
                    (update-branch-line)
                    (resume-view-line merge-pr)
                    (merge-line))))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest rebases-a-conflicted-branch-when-the-update-is-refused
  (let (root (unwrap-ok (setup "merge-rebase"
                               (assoc (merge-settings)
                                      :merge-exit 1
                                      :merge-error (clone conflict-error)
                                      :update-branch-exit 4
                                      :update-branch-error (str "branch cannot be updated"))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (next-line)
                    (preflight-lines)
                    (update-branch-line)
                    (fixing-line)
                    (show-line merge-item)
                    (worker-send-line (rebase-text)))))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest stops-before-advancing-when-auto-merge-is-disabled
  (let (root (unwrap-ok (setup "merge-auto-off"
                               (assoc (merge-settings)
                                      :allow-auto-merge (str "false"))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (auto-merge-line))))
    (assert (not (contains? (sequence-text root) "item advance")))))

(deftest times-out-from-the-rmap-move-time
  (let (root (unwrap-ok (setup-timeout "merge-timeout"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-json (clone armed-view))))
        output (unwrap-ok (run-with root
                                    (vec (str "--once")
                                         (str "--merge-retry-delay")
                                         (str "0")
                                         (str "--merge-timeout")
                                         (str "1")))))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (disarm-line merge-pr))))
    (assert (not (contains? (sequence-text root) "pr view")))
    (assert (stderr-has? output
                         (str "PR 12 did not merge within 1 seconds")))))

(deftest stops-when-the-head-moved
  (let (root (unwrap-ok (setup-merging "merge-head-moved"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-json (clone moved-view))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (show-line merge-item))))
    (assert (contains? (sequence-text root)
                       (as-str (resume-view-line merge-pr))))
    (assert (contains? (sequence-text root)
                       (as-str (disarm-line merge-pr))))
    (assert (stderr-has? output (str "not the approved")))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest disarms-when-the-item-returns-to-fixing
  (let (root (unwrap-ok (setup-merging "merge-fixing"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item))))
                                       (clone fixing-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (show-line merge-item))))
    (assert (contains? (sequence-text root)
                       (as-str (disarm-line merge-pr))))
    (assert (stderr-has? output
                         (str "the item is fixing, so auto-merge on PR 12 is disarmed")))
    (assert (not (contains? (sequence-text root) "pr view")))))

(deftest disarms-when-the-approval-is-gone
  (let (root (unwrap-ok (setup-merging "merge-unapproved"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item))))
                                       (clone unapproved-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (show-line merge-item))))
    (assert (contains? (sequence-text root)
                       (as-str (disarm-line merge-pr))))
    (assert (stderr-has? output (str "is not approved at head")))
    (assert (not (contains? (sequence-text root) "pr view")))))

(deftest disarms-when-the-view-is-refused
  (let (root (unwrap-ok (setup-merging "merge-view-refused"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-exit 9
                                              :view-error (str "view refused"))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (show-line merge-item))))
    (assert (contains? (sequence-text root)
                       (as-str (resume-view-line merge-pr))))
    (assert (contains? (sequence-text root)
                       (as-str (disarm-line merge-pr))))
    (assert (stderr-has? output (str "view refused")))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest stops-when-the-close-is-refused
  (let (root (unwrap-ok (setup-merging "merge-close-refused"
                                       (assoc (merge-settings)
                                              :items-json (merging-items (vec (clone
                                                                                merge-item)))
                                              :view-json (clone merged-view)
                                              :close-exit 5
                                              :close-error (str "not-approved"))
                                       (clone merging-item-json)))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (close-line merge-item))))
    (assert (stderr-has? output (str "not-approved")))))

(deftest stops-when-the-advance-is-refused
  (let (root (unwrap-ok (setup "merge-advance-refused"
                               (assoc (merge-settings)
                                      :advance-exit 2
                                      :advance-error (str "not-approved"))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (next-line))))
    (assert (contains? (sequence-text root)
                       (as-str (advance-line))))
    (assert (not (contains? (sequence-text root) "pr merge")))))

(deftest retries-the-merge-after-a-transient-network-error
  (let (root (unwrap-ok (setup "merge-network-retry"
                               (assoc (merge-settings)
                                      :merge-network-failures 1
                                      :network-error (clone network-error))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 0))
    (assert (= (sequence-text root)
               (str (next-line)
                    (preflight-lines)
                    (merge-line))))
    (assert (contains? (stderr-text output)
                       (as-str (str "● kogworks"))))))

(deftest disarms-every-merging-build-on-a-signal
  (let (root (unwrap-ok (setup-two "merge-signal"
                                   (assoc (merge-settings)
                                          :items-json (merging-items (vec
                                                                       (clone merge-item)
                                                                       (clone second-item)))
                                          :next-json (clone empty-next)
                                          :next-signal (str "INT"))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (contains? (sequence-text root)
                       (as-str (disarm-line merge-pr))))
    (assert (contains? (sequence-text root)
                       (as-str (disarm-line second-pr))))
    (assert (stderr-has? output (str "SIGINT")))
    (assert (not (contains? (sequence-text root) "item close")))))

(deftest exits-on-a-signal-with-no-merging-build
  (let (root (unwrap-ok (setup "merge-signal-none"
                               (assoc (merge-settings)
                                      :next-signal (str "INT"))))
        output (unwrap-ok (run root)))
    (assert (= (exit-code output) 1))
    (assert (stderr-has? output (str "SIGINT")))
    (assert (stderr-has? output (str "no merge was armed")))
    (assert (not (contains? (sequence-text root) "pr merge")))))
