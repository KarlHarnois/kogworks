(use fixtures/controller-fixture ->fake-settings
                                 absolute-path
                                 default-settings exit-code
                                 prepare-repo read-text
                                 run-controller stderr-text
                                 stdout-text write-fakes
                                 write-text)

(def ignored-next
  (str "{\"next\":["
       "{\"item\":\"rm-0000\",\"actions\":[{\"action\":\"review\","
       "\"actor\":\"worker\",\"session\":\"review-rm-0000\"}]},"
       "{\"item\":\"rm-0001\",\"actions\":[{\"action\":\"wait\","
       "\"actor\":\"controller\"}]},"
       "{\"item\":\"rm-0002\",\"actions\":[{\"action\":\"send-fixes\","
       "\"actor\":\"manager\"}]},"
       "{\"item\":\"rm-0003\",\"actions\":[{\"action\":\"dispatch\","
       "\"actor\":\"controller\"}]}" "]}"))

(def build-ready
  (str "{\"ready\":["
       "{\"id\":\"rm-research\",\"kind\":\"research\",\"score\":1e3},"
       "{\"id\":\"rm-0001\",\"kind\":\"build\",\"weight\":1.5},"
       "{\"id\":\"rm-0002\",\"kind\":\"build\"}" "]}"))

(def wait-next
  (str "{\"next\":[{\"item\":\"rm-0001\",\"actions\":["
       "{\"action\":\"wait\",\"actor\":\"controller\"}]}]}"))

(def research-ready
  (str "{\"ready\":["
       "{\"id\":\"rm-research\",\"kind\":\"research\",\"score\":1e3},"
       "{\"id\":\"rm-design\",\"kind\":\"design\"}" "]}"))

(def review-item (str "rm-0009"))

(def review-session (str "review-rm-0009-abcdef0"))

(def review-item-json
  (str "{\"item\":{"
       "\"criteria\":[\"the controller starts one reviewer\","
       "\"the brief names the head\"],"
       "\"session\":{\"branch\":\"" review-branch
       "\",\"kind\":\"work\"," "\"name\":\"" review-branch
       "\"}," "\"status\":\"in_review\"},"
       "\"pull_request\":{\"number\":12,\"head\":\""
       review-head "\"}}"))

(def substituted-criterion
  (str "Every placeholder, including the reviewer's fake-manager, "
       "SHALL still be covered."))

(def criterion-item-json
  (str "{\"item\":{" "\"criteria\":[\""
       criterion-with-manager "\"],"
       "\"session\":{\"branch\":\"" review-branch
       "\",\"kind\":\"work\"," "\"name\":\"" review-branch
       "\"}," "\"status\":\"in_review\"},"
       "\"pull_request\":{\"number\":12,\"head\":\""
       review-head "\"}}"))

(def review-head
  (str "abcdef0123456789abcdef0123456789abcdef01"))

(def review-branch (str "build-rm-0009"))

(def criterion-with-manager
  (str "Every placeholder, including the reviewer's {{manager}}, "
       "SHALL still be covered."))

(defn next-with (action item)
  (str "{\"next\":[{\"item\":\"" item "\",\"actions\":["
       "{\"action\":\"" action
       "\",\"actor\":\"controller\"}]}]}"))

(defn setup (name settings)
  (let (root (str "target/knave/controller-tests/" name))
    (match (prepare-repo (as-str root))
      ((err reason) (err reason))
      ((ok _)
       (match (write-fakes (as-str root) settings)
         ((err reason) (err reason))
         ((ok _) (ok root)))))))

(defn run (root args)
  (run-controller (as-str (str root "/bin"))
                  (as-str (str root "/repo"))
                  args))

(defn sequence-text (root)
  (unwrap-ok (read-text (as-str (str root "/sequence")))))

(defn prompt-text (root)
  (unwrap-ok (read-text (as-str (str root "/prompt")))))

(defn new-failure-sequence (root)
  (let (repo (absolute-repo-of root))
    (str (dispatch-sequence root)
         "rmap session end build-rm-0001 --reason abandoned\n"
         (send-line (str "dispatch: rm-0001: `ringleader new --name build-rm-0001 --repo "
                         repo
                         " --agent fake-agent --prompt <filled brief>` "
                         "exited 4: cannot start session")))))

(defn dispatch-sequence (root)
  (let (repo (absolute-repo-of root))
    (str
      (next-line (str "fake-roadmap"))
      (ready-line (str "fake-roadmap"))
      "rmap item claim rm-0001 --session build-rm-0001 --branch build-rm-0001\n"
      "ringleader new --name build-rm-0001 --repo " repo
      " --agent fake-agent --prompt <filled>\n")))

(defn review-settings (next-json)
  (assoc (default-settings next-json (clone build-ready))
         :item-json (clone review-item-json)))

(defn review-prompt ()
  (str "item=" review-item " roadmap=fake-roadmap "
       "session=" review-session " pr=12 head=" review-head
       " criteria=(1) the controller starts one reviewer; "
       "(2) the brief names the head base=main "
       "skill=fake-reviewer-skill manager=fake-manager\n"))

(defn verify-stress ()
  (str "Verify action: the head is approved, but at least one acceptance "
       "criterion has no verdict on it. Record every missing "
       "`rmap item verify` verdict before `rmap pr review`.\n\n"))

(defn review-refusal-sequence (error)
  (str (review-preface)
       (send-line (str "review: " review-item
                       ": `rmap review start " review-item
                       " --session " review-session
                       "` exited 5: " error))))

(defn review-new-failure-sequence (root)
  (let (repo (absolute-repo-of root))
    (str (review-sequence root)
         "rmap session end " review-session
         " --reason abandoned\n"
         (send-line (str "review: " review-item
                         ": `ringleader new --name "
                         review-session " --repo " repo
                         " --agent fake-reviewer-agent"
                         " --base-branch " review-branch
                         " --prompt <filled brief>` "
                         "exited 4: cannot start session")))))

(defn review-sequence (root)
  (str (review-preface) (reviewer-start-line root)))

(defn review-preface ()
  (str (next-line (str "fake-roadmap"))
       "rmap item show " review-item " --json\n"
       "rmap review start " review-item " --session "
       review-session "\n"))

(defn reviewer-start-line (root)
  (let (repo (absolute-repo-of root))
    (str "ringleader new --name " review-session " --repo "
         repo " --agent fake-reviewer-agent"
         " --base-branch " review-branch
         " --prompt <filled>\n")))

(defn absolute-repo-of (root)
  (unwrap-ok (absolute-path (as-str (repo-of root)))))

(defn repo-of (root) (str root "/repo"))

(defn missing-detail-sequence ()
  (str (next-line (str "fake-roadmap"))
       "rmap item show " review-item " --json\n"
       (send-line (str "review: " review-item
                       ": `rmap item show " review-item
                       " --json` exited 0: invalid item JSON: "
                       "`pull_request` is missing"))))

(defn claim-refusal-sequence ()
  (str
    (next-line (str "fake-roadmap"))
    (ready-line (str "fake-roadmap"))
    "rmap item claim rm-0001 --session build-rm-0001 --branch build-rm-0001\n"
    (send-line (str "dispatch: rm-0001: `rmap item claim rm-0001 "
                    "--session build-rm-0001 --branch build-rm-0001` "
                    "exited 5: not-ready"))))

(defn poll-sequence ()
  (str (next-line (str "fake-roadmap"))
       (ready-line (str "fake-roadmap"))
       (next-line (str "fake-roadmap"))
       (ready-line (str "fake-roadmap"))
       (next-line (str "fake-roadmap"))
       (send-line (str "next: -: `rmap next --roadmap fake-roadmap "
                       "--taken-by controller --json` exited 7: poll limit"))))

(defn next-line (roadmap)
  (str "rmap next --roadmap " roadmap
       " --taken-by controller --json\n"))

(defn ready-line (roadmap)
  (str "rmap ready --roadmap " roadmap " --json\n"))

(defn send-line (message)
  (str "ringleader send fake-manager " message "\n"))

(deftest dispatches-with-a-relative-repo
  (let (root (unwrap-ok (setup "relative-repo"
                               (default-settings (clone ignored-next)
                                                 (clone build-ready)))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (let (repo (absolute-repo-of root)
            relative-repo (repo-of root))
        (assert (not= (as-str repo) (as-str relative-repo)))
        (assert (starts-with? (as-str repo) "/"))
        (assert (= (exit-code output) 0))
        (assert (= (stdout-text output) (str "build-rm-0001\n")))
        (assert (= (sequence-text root) (dispatch-sequence root))))
      (assert (= (prompt-text root)
                 (str "item=rm-0001 roadmap=fake-roadmap "
                      "session=build-rm-0001 branch=build-rm-0001 "
                      "base=main skill=fake-skill\n"))))))

(deftest dispatches-the-first-ready-build
  (let (root (unwrap-ok (setup "dispatch"
                               (default-settings (clone ignored-next)
                                                 (clone build-ready)))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 0))
      (assert (= (stdout-text output) (str "build-rm-0001\n")))
      (assert (= (sequence-text root) (dispatch-sequence root)))
      (assert (= (prompt-text root)
                 (str "item=rm-0001 roadmap=fake-roadmap "
                      "session=build-rm-0001 branch=build-rm-0001 "
                      "base=main skill=fake-skill\n"))))))

(deftest ends-the-session-when-ringleader-new-fails
  (let (root (unwrap-ok (setup "new-fails"
                               (assoc (default-settings (clone ignored-next)
                                                        (clone build-ready))
                                      :new-exit 4
                                      :new-error (str
                                                   "cannot start session")))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root) (new-failure-sequence root)))
      (assert (contains? (stderr-text output) "cannot start session")))))

(deftest starts-a-reviewer-for-a-controller-review
  (let (root (unwrap-ok (setup "review"
                               (review-settings (next-with (str "review")
                                                           review-item)))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 0))
      (assert (= (stdout-text output) (str review-session "\n")))
      (assert (= (sequence-text root) (review-sequence root)))
      (assert (= (prompt-text root) (review-prompt)))
      (assert (not (contains? (prompt-text root) "{{")))
      (assert (not (contains? (sequence-text root) "design"))))))

(deftest keeps-a-placeholder-inside-a-criterion
  (let (root (unwrap-ok (setup "review-criterion-token"
                               (assoc (review-settings (next-with (str "review")
                                                                  review-item))
                                      :item-json (clone criterion-item-json)))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root) (review-sequence root)))
      (assert (contains? (prompt-text root)
                         (as-str criterion-with-manager)))
      (assert (not (contains? (prompt-text root)
                              (as-str substituted-criterion))))
      (assert (contains? (prompt-text root) "manager=fake-manager")))))

(deftest starts-a-reviewer-for-a-controller-verify
  (let (root (unwrap-ok (setup "verify"
                               (review-settings (next-with (str "verify")
                                                           review-item)))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 0))
      (assert (= (sequence-text root) (review-sequence root)))
      (assert (= (prompt-text root)
                 (str (verify-stress) (review-prompt))))
      (assert (not (contains? (sequence-text root) "design"))))))

(deftest stops-when-the-review-is-refused
  (let (root (unwrap-ok (setup "review-refused"
                               (assoc (review-settings (next-with (str "review")
                                                                  review-item))
                                      :review-exit 5
                                      :review-error (str
                                                      "review-already-live")))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (review-refusal-sequence (str "review-already-live"))))
      (assert (not (contains? (sequence-text root) "ringleader new")))
      (assert (not (contains? (sequence-text root) "session end"))))))

(deftest ends-the-review-session-when-ringleader-new-fails
  (let (root (unwrap-ok (setup "review-new-fails"
                               (assoc (review-settings (next-with (str "review")
                                                                  review-item))
                                      :new-exit 4
                                      :new-error (str
                                                   "cannot start session")))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root) (review-new-failure-sequence root)))
      (assert (contains? (stderr-text output) "cannot start session")))))

(deftest stops-when-the-item-detail-is-missing
  (let (root (unwrap-ok (setup "review-no-pull"
                               (assoc (review-settings (next-with (str "review")
                                                                  review-item))
                                      :item-json (str
                                                   "{\"item\":{"
                                                   "\"criteria\":[\"a criterion\"],"
                                                   "\"session\":{\"branch\":"
                                                   "\"build-rm-0009\"}}}")))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root) (missing-detail-sequence)))
      (assert (not (contains? (sequence-text root) "review start")))
      (assert (not (contains? (sequence-text root) "ringleader new"))))))

(deftest stops-when-the-claim-is-refused
  (let (root (unwrap-ok (setup "claim-refused"
                               (assoc (default-settings (clone ignored-next)
                                                        (clone build-ready))
                                      :claim-exit 5
                                      :claim-error (str "not-ready")))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root) (claim-refusal-sequence)))
      (assert (not (contains? (sequence-text root) "ringleader new")))
      (assert (not (contains? (sequence-text root) "session end"))))))

(deftest polls-when-no-action-exists
  (let (root (unwrap-ok (setup "poll"
                               (assoc (default-settings (clone wait-next)
                                                        (clone research-ready))
                                      :stop-after 3))))
    (let (output (unwrap-ok (run root
                                 (vec (str "--poll") (str "0")))))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root) (poll-sequence)))
      (assert (not (contains? (sequence-text root) "ringleader new")))
      (assert (not (contains? (sequence-text root) "item claim"))))))

(deftest help-states-the-restart-and-bootstrap-rules
  (let (root (unwrap-ok (setup "help"
                               (default-settings (clone wait-next)
                                                 (clone research-ready)))))
    (let (output (unwrap-ok (run root (vec (str "--help"))))
          text (stdout-text output))
      (assert (= (exit-code output) 0))
      (assert (contains? text "exits 1 on the first failure"))
      (assert (contains? text "restarts it"))
      (assert (contains?
                text
                "merge pull requests that change the controller itself"))
      (assert (contains?
                text
                "running binary stays at the version it was built from"))
      (assert (contains? text "rebuilds and restarts it"))
      (assert (contains? text "no automatic restart"))
      (assert (contains? text "starts no design reviewer")))))

(deftest notifies-the-manager-when-the-factory-is-incomplete
  (let (root (unwrap-ok (setup "factory-incomplete"
                               (default-settings (clone wait-next)
                                                 (clone research-ready)))))
    (unwrap-ok (write-text (as-str (str root "/repo/.kogworks/factory.json"))
                           (as-str (str "{\"manager\":\"fake-manager\","
                                        "\"roadmap\":\"fake-roadmap\","
                                        "\"merge\":\"gh-auto\"}"))))
    (let (output (unwrap-ok (run root (vec (str "--once")))))
      (assert (= (exit-code output) 1))
      (assert (= (sequence-text root)
                 (str "ringleader send fake-manager "
                      "controller: the factory field `roles` is missing\n")))
      (assert (contains? (stderr-text output)
                         "the factory field `roles` is missing")))))
