(use fixtures/factory-fixture prepare-factory)
(use synth synth-factory)

(deftest empty-roles-json-has-no-blank-line
  (let (dir (str "target/knave/test-factories/empty-roles"))
    (unwrap-ok (prepare-factory dir
                                (str "(deffactory empty-sample\n"
                                     "  :manager \"sample-manager\"\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto\n"
                                     "  :runner ringleader\n"
                                     "  (roles))\n")))
    (unwrap-ok (synth-factory (as-str dir)))
    (assert (= (unwrap-ok (slurp (as-str (str dir "/factory.json"))))
               (str "{\n" "  \"schema\": 0,\n"
                    "  \"name\": \"empty-sample\",\n"
                    "  \"manager\": \"sample-manager\",\n"
                    "  \"roadmap\": \"sample-roadmap\",\n"
                    "  \"max_active\": 1,\n"
                    "  \"merge\": \"gh-auto\",\n"
                    "  \"runner\": \"ringleader\",\n"
                    "  \"roles\": {}\n" "}\n")))))
