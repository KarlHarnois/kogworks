(use controller/factory merge-method read-factory)
(use controller/fields field-error)

(use controller/failure factory-error
                        factory-error->message)

(use fixtures/controller-fixture prepare-repo reset-dir
                                 write-text)

(deftest read-factory-reads-the-manager-roadmap-and-roles
  (let (root (str "target/knave/controller-tests/factory-read"))
    (unwrap-ok (prepare-repo (as-str root)))
    (match (read-factory (as-str (str root "/repo")))
      ((ok config)
       (assert (= (:manager config) (str "fake-manager")))
       (assert (= (:roadmap config) (str "fake-roadmap")))
       (assert (= (:merge config) merge-method/gh-auto))
       (assert (= (:agent (:worker config))
                  (str "fake-agent")))
       (assert (= (:skill (:worker config))
                  (str "fake-skill")))
       (assert (= (:brief (:worker config))
                  (str ".kogworks/briefs/worker.md")))
       (assert (= (:agent (:reviewer config))
                  (str "fake-reviewer-agent")))
       (assert (= (:skill (:reviewer config))
                  (str "fake-reviewer-skill")))
       (assert (= (:brief (:reviewer config))
                  (str ".kogworks/briefs/reviewer.md"))))
      ((err _) (assert false)))))

(deftest read-factory-reports-a-missing-factory
  (let (root (str "target/knave/controller-tests/factory-missing"))
    (unwrap-ok (reset-dir (as-str root)))
    (match (read-factory (as-str (str root "/repo")))
      ((err (missing-factory path))
       (assert (contains? path "factory.json")))
      (_ (assert false)))))

(deftest read-factory-reports-malformed-json
  (let (root (str "target/knave/controller-tests/factory-malformed"))
    (unwrap-ok (prepare-repo (as-str root)))
    (unwrap-ok (write-text (as-str (str root "/repo/.kogworks/factory.json"))
                           (as-str (str "{"))))
    (match (read-factory (as-str (str root "/repo")))
      ((err (malformed-factory path reason))
       (assert (contains? path "factory.json"))
       (assert (contains? reason "unexpected end")))
      (_ (assert false)))))

(deftest read-factory-rejects-an-unsupported-merge-method
  (let (root (str "target/knave/controller-tests/factory-merge-method"))
    (unwrap-ok (prepare-repo (as-str root)))
    (unwrap-ok (write-text (as-str (str root "/repo/.kogworks/factory.json"))
                           (as-str (str "{\"manager\":\"fake-manager\","
                                        "\"roadmap\":\"fake-roadmap\","
                                        "\"merge\":\"gh-api\"}"))))
    (match (read-factory (as-str (str root "/repo")))
      ((err (unsupported-merge-method method))
       (assert (= method (str "gh-api"))))
      (_ (assert false)))))

(deftest names-a-non-number-factory-field
  (assert (= (factory-error->message (factory-error/field (field-error/non-number-field
                                                            (str "worker.weight"))))
             (str "the factory field `worker.weight` is not a number"))))
