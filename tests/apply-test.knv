(use apply apply-error apply-error->message cap-from-text)

(use apply-fixture calls exit-code export-document
                   factory-json prepare-repo
                   prepare-repo-without-factory
                   prepare-repo-without-roadmap
                   roadmap-max-active run-apply stderr-text
                   stdout-text)

(def refusal-factory-json
  (str "{\"roadmap\": \"missing-roadmap\", \"max_active\": 3}\n"))

(deftest cap-from-text-reads-the-roadmap-and-max-active
  (match (cap-from-text "factory.json"
                        "{\"roadmap\": \"factory-mvp\", \"max_active\": 3}")
    ((ok cap)
     (assert (= (:roadmap cap) (str "factory-mvp")))
     (assert (= (:max-active cap) 3)))
    ((err _) (assert false))))

(deftest cap-from-text-rejects-a-fractional-max-active
  (match (cap-from-text "factory.json"
                        "{\"roadmap\": \"factory-mvp\", \"max_active\": 3.5}")
    ((err (invalid-max-active path _))
     (assert (= path (str "max_active"))))
    (_ (assert false))))

(deftest cap-from-text-rejects-a-missing-roadmap
  (match (cap-from-text "factory.json" "{\"max_active\": 3}")
    ((err (missing-field path))
     (assert (= path (str "roadmap"))))
    (_ (assert false))))

(deftest cap-from-text-rejects-a-missing-max-active
  (match (cap-from-text "factory.json"
                        "{\"roadmap\": \"factory-mvp\"}")
    ((err (missing-field path))
     (assert (= path (str "max_active"))))
    (_ (assert false))))

(deftest cap-from-text-rejects-a-text-max-active
  (match (cap-from-text "factory.json"
                        "{\"roadmap\": \"factory-mvp\", \"max_active\": \"3\"}")
    ((err (non-number-field path))
     (assert (= path (str "max_active"))))
    (_ (assert false))))

(deftest cap-from-text-rejects-a-text-roadmap
  (match (cap-from-text "factory.json"
                        "{\"roadmap\": 7, \"max_active\": 3}")
    ((err (non-text-field path))
     (assert (= path (str "roadmap"))))
    (_ (assert false))))

(deftest cap-from-text-rejects-malformed-json
  (match (cap-from-text "factory.json" "{")
    ((err (malformed-factory path _))
     (assert (= path (str "factory.json"))))
    (_ (assert false))))

(deftest apply-error-messages-name-the-failure
  (assert (= (apply-error->message (apply-error/missing-factory (str "f.json")))
             (str "no factory at f.json")))
  (assert (= (apply-error->message (apply-error/unreadable-factory
                                     (str "f.json")
                                     (str "denied")))
             (str "cannot read f.json: denied")))
  (assert (= (apply-error->message (apply-error/malformed-factory (str "f.json")
                                                                  (str "bad")))
             (str "cannot parse f.json: bad")))
  (assert (= (apply-error->message (apply-error/missing-field (str "roadmap")))
             (str "the factory has no `roadmap`")))
  (assert (= (apply-error->message (apply-error/non-text-field (str "roadmap")))
             (str "the factory field `roadmap` is not text")))
  (assert (= (apply-error->message (apply-error/non-number-field (str "max_active")))
             (str "the factory field `max_active` is not a number")))
  (match (the (result int (parse-error int))
              (parse "3.5"))
    ((err cause)
     (assert (= (apply-error->message (apply-error/invalid-max-active (str "max_active")
                                                                      cause))
                (str "the factory field `max_active` is not a whole number: "
                     "invalid digit found in string"))))
    ((ok _) (assert false)))
  (assert (= (apply-error->message (apply-error/unreadable-repository (str
                                                                        "repo")
                                                                      (str "gone")))
             (str "cannot resolve the repository repo: gone"))))

(deftest apply-stores-the-factory-max-active
  (let (root (str "target/knave/apply-tests/stores"))
    (unwrap-ok (prepare-repo (as-str root)
                             (as-str factory-json)
                             "factory-mvp"))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 0))
      (assert (empty? (stderr-text outcome)))
      (assert (= (str (trim (as-str (stdout-text outcome))))
                 (str "Set the max active of roadmap factory-mvp to 3.")))
      (assert (= (calls (as-str root))
                 (vec (str "roadmap set factory-mvp --max-active 3"))))
      (let (document (unwrap-ok (export-document (as-str root))))
        (assert (= (roadmap-max-active document "factory-mvp")
                   (some (str "3"))))))))

(deftest apply-passes-through-an-rmap-refusal
  (let (root (str "target/knave/apply-tests/refusal"))
    (unwrap-ok (prepare-repo-without-roadmap (as-str root)
                                             (as-str refusal-factory-json)))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 1))
      (assert (contains? (stderr-text outcome) "roadmap-not-found"))
      (assert (= (calls (as-str root))
                 (vec (str "roadmap set missing-roadmap --max-active 3")))))))

(deftest apply-reports-a-missing-factory
  (let (root (str "target/knave/apply-tests/missing-factory"))
    (unwrap-ok (prepare-repo-without-factory (as-str root)))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 1))
      (assert (contains? (stderr-text outcome) "no factory at"))
      (assert (contains? (stderr-text outcome) ".kogworks/factory.json")))))
