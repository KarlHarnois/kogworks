(use apply apply-error apply-error->message)
(use controller/cap cap-from-document)
(use controller/failure factory-error)
(use controller/fields field-error)
(use controller/json parse-json)

(use apply-fixture ->fake-rmap exit-code export-document
                   factory-json prepare-real-repo
                   prepare-repo prepare-repo-without-factory
                   recorded-command recorded-dir repo-dir
                   rmap-call-count rmap-path
                   roadmap-max-active run-apply run-apply-in
                   stderr-text stdout-text stored-max-active
                   write-unreadable-factory)

(def stored-factory-json
  (str "{\"roadmap\": \"factory-mvp\", \"max_active\": 5}\n"))

(def refusal-factory-json
  (str "{\"roadmap\": \"missing-roadmap\", \"max_active\": 4}\n"))

(deftest cap-from-document-reads-the-roadmap-and-max-active
  (let (document (unwrap-ok (parse-json (as-str (str "{\"roadmap\": \"factory-mvp\", \"max_active\": 3}")))))
    (match (cap-from-document document)
      ((ok cap)
       (assert (= (:roadmap cap) (str "factory-mvp")))
       (assert (= (:max-active cap) 3)))
      ((err _) (assert false)))))

(deftest cap-from-document-rejects-a-fractional-max-active
  (let (document (unwrap-ok (parse-json (as-str (str "{\"roadmap\": \"factory-mvp\", \"max_active\": 3.5}")))))
    (match (cap-from-document document)
      ((err (field (non-whole-number-field path _)))
       (assert (= path (str "max_active"))))
      (_ (assert false)))))

(deftest cap-from-document-rejects-a-missing-roadmap
  (let (document (unwrap-ok (parse-json (as-str (str "{\"max_active\": 3}")))))
    (match (cap-from-document document)
      ((err (field (missing-field path)))
       (assert (= path (str "roadmap"))))
      (_ (assert false)))))

(deftest cap-from-document-rejects-a-missing-max-active
  (let (document (unwrap-ok (parse-json (as-str (str "{\"roadmap\": \"factory-mvp\"}")))))
    (match (cap-from-document document)
      ((err (field (missing-field path)))
       (assert (= path (str "max_active"))))
      (_ (assert false)))))

(deftest cap-from-document-rejects-a-text-max-active
  (let (document (unwrap-ok (parse-json (as-str (str "{\"roadmap\": \"factory-mvp\", \"max_active\": \"3\"}")))))
    (match (cap-from-document document)
      ((err (field (non-number-field path)))
       (assert (= path (str "max_active"))))
      (_ (assert false)))))

(deftest cap-from-document-rejects-a-text-roadmap
  (let (document (unwrap-ok (parse-json (as-str (str "{\"roadmap\": 7, \"max_active\": 3}")))))
    (match (cap-from-document document)
      ((err (field (non-text-field path)))
       (assert (= path (str "roadmap"))))
      (_ (assert false)))))

(deftest apply-error-messages-name-the-failure
  (assert (= (apply-error->message (apply-error/factory (factory-error/missing-factory
                                                          (str "f.json"))))
             (str "no factory at f.json")))
  (assert (= (apply-error->message (apply-error/factory (factory-error/unreadable-factory
                                                          (str "f.json")
                                                          (str "denied"))))
             (str "cannot read f.json: denied")))
  (assert (= (apply-error->message (apply-error/factory (factory-error/malformed-factory
                                                          (str "f.json")
                                                          (str "bad"))))
             (str "cannot parse f.json: bad")))
  (assert (= (apply-error->message (apply-error/factory (factory-error/field
                                                          (field-error/missing-field
                                                            (str "roadmap")))))
             (str "the factory field `roadmap` is missing")))
  (assert (= (apply-error->message (apply-error/factory (factory-error/field
                                                          (field-error/non-text-field
                                                            (str "roadmap")))))
             (str "the factory field `roadmap` is not text")))
  (assert (= (apply-error->message (apply-error/factory
                                     (factory-error/field
                                       (field-error/non-number-field (str "max_active")))))
             (str "the factory field `max_active` is not a number")))
  (match (the (result int (parse-error int))
              (parse "3.5"))
    ((err cause)
     (assert (= (apply-error->message
                  (apply-error/factory (factory-error/field (field-error/non-whole-number-field
                                                              (str "max_active")
                                                              cause))))
                (str "the factory field `max_active` is not a whole number: "
                     "invalid digit found in string"))))
    ((ok _) (assert false)))
  (assert (= (apply-error->message (apply-error/unreadable-repo (str "repo")
                                                                (str "gone")))
             (str "cannot resolve the repository repo: gone"))))

(deftest apply-stores-the-factory-max-active
  (let (root (str "target/knave/apply-tests/stores"))
    (unwrap-ok (prepare-repo (as-str root)
                             (as-str stored-factory-json)
                             (->fake-rmap :stdout (str "Set the max active of roadmap factory-mvp to 5.")
                                          :stderr (str)
                                          :code 0)))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 0))
      (assert (= (stdout-text outcome)
                 (str "Set the max active of roadmap factory-mvp to 5.")))
      (assert (empty? (stderr-text outcome)))
      (assert (= (recorded-command (as-str root))
                 (some (str "roadmap set factory-mvp --max-active 5"))))
      (assert (= (recorded-dir (as-str root))
                 (some (unwrap-ok (repo-dir (as-str root))))))
      (assert (= (stored-max-active (as-str root))
                 (some (str "5"))))
      (assert (= (rmap-call-count (as-str root)) 1)))))

(deftest apply-accepts-the-repo-option-and-defaults-to-the-current-directory
  (let (explicit-root (str "target/knave/apply-tests/repo-explicit"))
    (unwrap-ok (prepare-repo (as-str explicit-root)
                             (as-str stored-factory-json)
                             (->fake-rmap :stdout (str) :stderr (str) :code 0)))
    (let (explicit (unwrap-ok (run-apply (as-str (str explicit-root "/bin"))
                                         (as-str (str explicit-root "/repo")))))
      (assert (= (exit-code explicit) 0))
      (assert (= (recorded-dir (as-str explicit-root))
                 (some (unwrap-ok (repo-dir (as-str explicit-root))))))))
  (let (default-root (str "target/knave/apply-tests/repo-default"))
    (unwrap-ok (prepare-repo (as-str default-root)
                             (as-str stored-factory-json)
                             (->fake-rmap :stdout (str) :stderr (str) :code 0)))
    (let (default (unwrap-ok (run-apply-in (as-str (str default-root "/bin"))
                                           (as-str (str default-root
                                                        "/repo")))))
      (assert (= (exit-code default) 0))
      (assert (= (recorded-dir (as-str default-root))
                 (some (unwrap-ok (repo-dir (as-str default-root)))))))))

(deftest apply-reports-a-missing-factory-in-the-working-directory
  (let (root (str "target/knave/apply-tests/default-missing-factory"))
    (unwrap-ok (prepare-repo-without-factory (as-str root)))
    (let (outcome (unwrap-ok (run-apply-in (as-str (str root "/bin"))
                                           (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 1))
      (assert (contains? (stderr-text outcome) "no factory at"))
      (assert (contains? (stderr-text outcome)
                         (as-str (str (unwrap-ok (repo-dir (as-str root)))
                                      "/.kogworks/factory.json")))))))

(deftest apply-passes-through-an-rmap-refusal
  (let (root (str "target/knave/apply-tests/refusal"))
    (unwrap-ok (prepare-repo (as-str root)
                             (as-str refusal-factory-json)
                             (->fake-rmap :stdout (str)
                                          :stderr (str "error: no roadmap is named missing-roadmap (roadmap-not-found)")
                                          :code 1)))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 1))
      (assert (= (stdout-text outcome) (str)))
      (assert (= (stderr-text outcome)
                 (str "error: no roadmap is named missing-roadmap (roadmap-not-found)")))
      (assert (= (recorded-command (as-str root))
                 (some (str "roadmap set missing-roadmap --max-active 4"))))
      (assert (= (recorded-dir (as-str root))
                 (some (unwrap-ok (repo-dir (as-str root))))))
      (assert (= (stored-max-active (as-str root)) none))
      (assert (= (rmap-call-count (as-str root)) 1)))))

(deftest apply-reports-a-missing-factory
  (let (root (str "target/knave/apply-tests/missing-factory"))
    (unwrap-ok (prepare-repo-without-factory (as-str root)))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 1))
      (assert (contains? (stderr-text outcome) "no factory at"))
      (assert (contains? (stderr-text outcome) ".kogworks/factory.json"))
      (assert (= (rmap-call-count (as-str root)) 0)))))

(deftest apply-reports-an-unreadable-factory
  (let (root (str "target/knave/apply-tests/unreadable-factory"))
    (unwrap-ok (prepare-repo (as-str root)
                             (as-str factory-json)
                             (->fake-rmap :stdout (str) :stderr (str) :code 0)))
    (unwrap-ok (write-unreadable-factory (as-str root)))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 1))
      (assert (= (stdout-text outcome) (str)))
      (assert (contains? (stderr-text outcome) "cannot read"))
      (assert (contains? (stderr-text outcome) "factory.json"))
      (assert (= (rmap-call-count (as-str root)) 0)))))

(deftest apply-reports-a-malformed-factory
  (let (root (str "target/knave/apply-tests/malformed-factory"))
    (unwrap-ok (prepare-repo (as-str root)
                             (as-str (str "{"))
                             (->fake-rmap :stdout (str) :stderr (str) :code 0)))
    (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                        (as-str (str root "/repo")))))
      (assert (= (exit-code outcome) 1))
      (assert (= (stdout-text outcome) (str)))
      (assert (contains? (stderr-text outcome) "cannot parse"))
      (assert (contains? (stderr-text outcome) "factory.json"))
      (assert (= (rmap-call-count (as-str root)) 0)))))

(deftest apply-stores-the-factory-max-active-with-real-rmap
  (match (rmap-path)
    ((some _)
     (let (root (str "target/knave/apply-tests/real-store"))
       (unwrap-ok (prepare-real-repo (as-str root)
                                     (as-str factory-json)
                                     "factory-mvp"))
       (let (outcome (unwrap-ok (run-apply (as-str (str root "/bin"))
                                           (as-str (str root "/repo")))))
         (assert (= (exit-code outcome) 0))
         (let (document (unwrap-ok (export-document (as-str root))))
           (assert (= (roadmap-max-active document "factory-mvp")
                      (some (str "3"))))))))
    (none (println "rmap is not on PATH; skipping the real store check"))))
