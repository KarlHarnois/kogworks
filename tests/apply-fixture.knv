(module
  "Builds a temporary governed repository and runs the apply command against it.")

(use controller/json json json-array json-error->message
                     json-field json-text parse-json)

(use controller/process ->command canonical-path
                        command-detail execute successful?)

(export ->fake-rmap exit-code export-document factory-json
        prepare-real-repo prepare-repo
        prepare-repo-without-factory recorded-command
        recorded-dir repo-dir rmap-call-count rmap-path
        roadmap-max-active run-apply stderr-text stdout-text
        stored-max-active write-unreadable-factory)

(def factory-json
  (str "{\"schema\": 0,\n" " \"name\": \"apply-fixture\",\n"
       " \"manager\": \"apply-manager\",\n"
       " \"roadmap\": \"factory-mvp\",\n"
       " \"max_active\": 3,\n" " \"merge\": \"gh-auto\",\n"
       " \"roles\": {}}\n"))

(def reset-dir
  (rust "{{
    match std::fs::remove_dir_all({0}) {{
      Ok(_) => Ok(()),
      Err(error) if error.kind() == std::io::ErrorKind::NotFound => Ok(()),
      Err(error) => Err(error.to_string()),
    }}
  }}"
    (fn ((ref str)) (result unit string))))

(def make-dir
  (rust "std::fs::create_dir_all({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result unit string))))

(def write-text
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(def read-text
  (rust "std::fs::read_to_string({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result string string))))

(def write-invalid-utf8
  (rust "std::fs::write({0}, [0xFFu8, 0xFEu8]).map_err(|error| error.to_string())"
    (fn ((ref str)) (result unit string))))

(def make-executable
  (rust "{{
    use std::os::unix::fs::PermissionsExt;
    let mut permissions = std::fs::metadata({0})
      .map_err(|error| error.to_string())?
      .permissions();
    permissions.set_mode(0o755);
    std::fs::set_permissions({0}, permissions)
      .map_err(|error| error.to_string())
  }}"
    (fn ((ref str)) (result unit string))))

(def rmap-path
  (rust "std::process::Command::new(\"sh\").args([\"-c\", \"command -v rmap\"]).output().ok().and_then(|output| if output.status.success() {{ String::from_utf8(output.stdout).ok().map(|text| text.trim().to_string()) }} else {{ None }})"
    (fn () (option string))))

(def fake-rmap-script
  (str "#!/bin/sh\n"
       "root=$(cd \"$(dirname \"$0\")/..\" && pwd)\n"
       "printf '%s\n' \"$*\" >> \"$root/rmap-commands\"\n"
       "printf '%s' \"$(pwd -P)\" > \"$root/rmap-dir\"\n"
       "if [ [CODE] -eq 0 ] && [ \"$1 $2\" = \"roadmap set\" ]; then\n"
       "  printf '%s' \"$5\" > \"$root/stored-max-active\"\n"
       "fi\n" "printf '%s' '[STDOUT]'\n"
       "printf '%s' '[STDERR]' >&2\n" "exit [CODE]\n"))

(def run-apply-process
  (rust "{{
    let bin = std::fs::canonicalize({0}).map_err(|error| error.to_string())?;
    let path = format!(\"{{}}:{{}}\",
                       bin.display(),
                       std::env::var(\"PATH\").unwrap_or_default());
    std::process::Command::new(\"./target/knave/kogworks/kogworks\")
      .args([\"apply\", \"--repo\", {1}])
      .env(\"PATH\", path)
      .output()
      .map_err(|error| error.to_string())
  }}"
    (fn ((ref str) (ref str))
      (result process-output string))))

(def exit-code
  (rust "{0}.status.code().map(i64::from).unwrap_or(-1)"
    (fn ((ref process-output)) int)))

(def stdout-text
  (rust "String::from_utf8_lossy({0}.stdout.as_slice()).into_owned()"
    (fn ((ref process-output)) string)))

(def stderr-text
  (rust "String::from_utf8_lossy({0}.stderr.as_slice()).into_owned()"
    (fn ((ref process-output)) string)))

(defstruct fake-rmap
  :stdout string
  :stderr string
  :code int)

(deftype process-output (rust "std::process::Output"))

(defn prepare-repo (root factory-text settings)
  (let-try (_ (prepare-directories root)
            _ (write-factory root factory-text))
    (write-fake-rmap root settings)))

(defn prepare-real-repo (root factory-text roadmap)
  (let-try (_ (prepare-directories root)
            _ (write-factory root factory-text)
            _ (run-in root "git"
                      (vec (str "init") (str "-q"))
                      "git init")
            _ (run-in root "rmap" (vec (str "init")) "rmap init"))
    (rmap-new root roadmap)))

(defn prepare-repo-without-factory (root)
  (let-try (_ (reset-dir root)
            _ (make-dir (as-str (str root "/bin"))))
    (make-dir (as-str (str root "/repo")))))

(type write-unreadable-factory
  (fn ((ref str)) (result unit string)))

(defn write-unreadable-factory (root)
  (write-invalid-utf8 (as-str (str root "/repo/.kogworks/factory.json"))))

(defn run-apply (bin repo) (run-apply-process bin repo))

(type recorded-command
  (fn ((ref str)) (option string)))

(defn recorded-command (root)
  (match (read-option (as-str (str root "/rmap-commands")))
    ((some text) (some (str (trim (as-str text)))))
    (none none)))

(type rmap-call-count
  (fn ((ref str)) int))

(defn rmap-call-count (root)
  (match (read-option (as-str (str root "/rmap-commands")))
    ((some text) (len (collect (lines (as-str text)))))
    (none 0)))

(type recorded-dir
  (fn ((ref str)) (option string)))

(defn recorded-dir (root)
  (read-option (as-str (str root "/rmap-dir"))))

(type stored-max-active
  (fn ((ref str)) (option string)))

(defn stored-max-active (root)
  (read-option (as-str (str root "/stored-max-active"))))

(type repo-dir
  (fn ((ref str)) (result string string)))

(defn repo-dir (root)
  (canonical-path (as-str (str root "/repo"))))

(type export-document
  (fn ((ref str)) (result json string)))

(defn export-document (root)
  (let (outcome (execute (as-str (str root "/repo"))
                         (->command :program (str "rmap")
                                    :args (vec (str "export"))
                                    :label (str "rmap export"))))
    (if (successful? outcome)
      (map-err (parse-json (as-str (:stdout outcome)))
        (fn (failure) (json-error->message failure)))
      (err (command-detail outcome)))))

(defn roadmap-max-active (document name)
  (match (named-roadmap document name)
    ((some object) (max-active-text object))
    (none none)))

(defn prepare-directories (root)
  (let-try (_ (reset-dir root)
            _ (make-dir (as-str (str root "/repo/.kogworks"))))
    (make-dir (as-str (str root "/bin")))))

(defn write-factory (root factory-text)
  (write-text (as-str (str root "/repo/.kogworks/factory.json"))
              factory-text))

(defn write-fake-rmap (root settings)
  (let-try (_ (write-text (as-str (str root "/bin/rmap"))
                          (as-str (replaced-script settings))))
    (make-executable (as-str (str root "/bin/rmap")))))

(type replaced-script
  (fn ((ref fake-rmap)) string))

(defn replaced-script (settings)
  (-> (clone fake-rmap-script)
      (replace-token (str "[STDOUT]")
                     (clone (:stdout settings)))
      (replace-token (str "[STDERR]")
                     (clone (:stderr settings)))
      (replace-token (str "[CODE]")
                     (str (:code settings)))))

(defn replace-token (text token value)
  (-> text as-str
      (split (as-str token))
      collect
      (join (as-str value))))

(type rmap-new
  (fn ((ref str) (ref str))
    (result unit string)))

(defn rmap-new (root roadmap)
  (run-in root "rmap"
          (vec (str "new")
               (str roadmap)
               (str "--manager")
               (str "apply-test"))
          (as-str (str "rmap new " roadmap))))

(defn run-in (root program args label)
  (let (outcome (execute (as-str (str root "/repo"))
                         (->command :program (str program)
                                    :args args
                                    :label (str label))))
    (if (successful? outcome)
      (ok (do))
      (err (command-detail outcome)))))

(defn read-option (path)
  (match (read-text path)
    ((ok text) (some text))
    ((err _) none)))

(defn named-roadmap (document name)
  (let (items (unwrap-or (roadmaps document) (vec)))
    (map-some (find (iter items)
                (fn (item) (named? item name)))
              (fn (item) (clone item)))))

(defn roadmaps (document)
  (match (json-field document "roadmaps")
    ((some value) (json-array value))
    (none none)))

(defn named? (object name)
  (match (json-field object "name")
    ((some value) (text-is? value name))
    (none false)))

(defn text-is? (value expected)
  (match (json-text value)
    ((some text) (= (as-str text) expected))
    (none false)))

(defn max-active-text (object)
  (match (json-field object "max_active")
    ((some value) (number-text value))
    (none none)))

(defn number-text (value)
  (match value
    ((number text) (some (clone text)))
    (_ none)))
