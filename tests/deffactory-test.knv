(use fixtures/factory-fixture prepare-factory)
(use synth synth-factory)

(deftest deffactory-writes-the-factory-json
  (let (dir (str "target/knave/test-factories/deffactory-sample"))
    (unwrap-ok (prepare-factory dir
                                (str
                                  "(deffactory sample\n"
                                  "  :manager \"sample-manager\"\n"
                                  "  :roadmap \"sample-roadmap\"\n"
                                  "  :max-active 2\n"
                                  "  :merge gh-auto\n"
                                  "  :runner ringleader\n"
                                  "  (roles (worker :agent \"sample-worker\"\n"
                                  "                  :skill \"sample:worker-skill\"\n"
                                  "                  :brief \"sample/briefs/worker.md\")\n"
                                  "          (reviewer :agent \"sample-reviewer\"\n"
                                  "                    :skill \"sample:reviewer-skill\"\n"
                                  "                    :brief \"sample/briefs/reviewer.md\")))\n")))
    (unwrap-ok (synth-factory (as-str dir)))
    (assert (= (unwrap-ok (slurp (as-str (str dir "/factory.json"))))
               (str "{\n" "  \"schema\": 0,\n"
                    "  \"name\": \"sample\",\n"
                    "  \"manager\": \"sample-manager\",\n"
                    "  \"roadmap\": \"sample-roadmap\",\n"
                    "  \"max_active\": 2,\n"
                    "  \"merge\": \"gh-auto\",\n"
                    "  \"runner\": \"ringleader\",\n"
                    "  \"roles\": {\n" "    \"worker\": {\n"
                    "      \"agent\": \"sample-worker\",\n"
                    "      \"skill\": \"sample:worker-skill\",\n"
                    "      \"brief\": \"sample/briefs/worker.md\"\n"
                    "    },\n" "    \"reviewer\": {\n"
                    "      \"agent\": \"sample-reviewer\",\n"
                    "      \"skill\": \"sample:reviewer-skill\",\n"
                    "      \"brief\": \"sample/briefs/reviewer.md\"\n"
                    "    }\n" "  }\n" "}\n")))))
