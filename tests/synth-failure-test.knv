(deftest setting-value-that-is-a-keyword-reports-the-setting
  (let (directory (str "target/knave/test-factories/setting-value-keyword"))
    (unwrap-ok (prepare-factory directory
                                (str "(deffactory sample\n"
                                     "  :manager\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto\n"
                                     "  (roles (worker :agent \"a\" :skill \"s\" :brief \"b\")))\n")))
    (let (reason (failure-reason (synth-factory (as-str directory)))
          output (unwrap-ok (run-synth (as-str directory))))
      (assert (contains? reason "deffactory needs `:manager`"))
      (assert (not (contains? reason "deffactory needs `:roadmap`")))
      (assert (contains? reason "factory.knv:1:"))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output)
                         "deffactory needs `:manager`")))))
