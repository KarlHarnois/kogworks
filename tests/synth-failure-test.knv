(use synth synth-error synth-factory)

(deftype process-output (rust "std::process::Output"))

(def create-directory
  (rust "std::fs::create_dir_all({0}).map_err(|error| error.to_string())"
    (fn ((ref str)) (result unit string))))

(def write-text
  (rust "std::fs::write({0}, {1}).map_err(|error| error.to_string())"
    (fn ((ref str) (ref str))
      (result unit string))))

(defn prepare-factory (directory factory-text)
  (match (create-directory (as-str directory))
    ((ok _)
     (write-text (as-str (str directory "/factory.knv"))
                 (as-str factory-text)))
    ((err reason) (err reason))))

(def run-synth
  (rust "std::process::Command::new(\"./target/knave/kogworks/kogworks\").args([\"synth\", {0}]).output().map_err(|error| error.to_string())"
    (fn ((ref str))
      (result process-output string))))

(def exit-code
  (rust "{0}.status.code().map(i64::from).unwrap_or(-1)"
    (fn ((ref process-output)) int)))

(def stderr-text
  (rust "String::from_utf8_lossy({0}.stderr.as_slice()).into_owned()"
    (fn ((ref process-output)) string)))

(defn failure-reason (outcome)
  (match outcome
    ((ok _) (str "unexpected success"))
    ((err (unreadable-factory _ reason)) reason)
    ((err (missing-factory path)) (str "missing " path))
    ((err (unwritable-factory-json path reason))
     (str "cannot write " path ": " reason))))

(deftest missing-setting-reports-its-message
  (let (directory (str "target/knave/test-factories/missing-setting"))
    (unwrap-ok (prepare-factory directory
                                (str "(deffactory sample\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto\n"
                                     "  (roles (worker :agent \"a\" :skill \"s\" :brief \"b\")))\n")))
    (let (reason (failure-reason (synth-factory (as-str directory)))
          output (unwrap-ok (run-synth (as-str directory))))
      (assert (contains? reason "deffactory needs `:manager`"))
      (assert (contains? reason "factory.knv:1:"))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output)
                         "deffactory needs `:manager`")))))

(deftest missing-roles-reports-its-message
  (let (directory (str "target/knave/test-factories/missing-roles"))
    (unwrap-ok (prepare-factory directory
                                (str "(deffactory sample\n"
                                     "  :manager \"sample-manager\"\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto)\n")))
    (let (reason (failure-reason (synth-factory (as-str directory)))
          output (unwrap-ok (run-synth (as-str directory))))
      (assert (contains? reason "deffactory needs a `roles` form"))
      (assert (contains? reason "factory.knv:"))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output)
                         "deffactory needs a `roles` form")))))

(deftest malformed-role-clause-reports-its-message
  (let (directory (str "target/knave/test-factories/malformed-role-clause"))
    (unwrap-ok (prepare-factory directory
                                (str "(deffactory sample\n"
                                     "  :manager \"sample-manager\"\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto\n"
                                     "  (roles (worker :agent \"a\" :skill \"s\")))\n")))
    (let (reason (failure-reason (synth-factory (as-str directory)))
          output (unwrap-ok (run-synth (as-str directory))))
      (assert (contains?
                reason
                "a role clause is `(name :agent ... :skill ... :brief ...)`"))
      (assert (contains? reason "factory.knv:6:"))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output)
                         "a role clause is `(name :agent ... :skill ... :brief ...)`")))))
