(deftest setting-value-that-is-a-keyword-reports-the-setting
  (let (dir (str "target/knave/test-factories/setting-value-keyword"))
    (unwrap-ok (prepare-factory dir
                                (str "(deffactory sample\n"
                                     "  :manager\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto\n"
                                     "  (roles (worker :agent \"a\" :skill \"s\" :brief \"b\")))\n")))
    (let (reason (failure-reason (synth-factory (as-str dir)))
          output (unwrap-ok (run-synth (as-str dir))))
      (assert (contains? reason "deffactory needs `:manager`"))
      (assert (not (contains? reason "deffactory needs `:roadmap`")))
      (assert (contains? reason "factory.knv:1:"))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output)
                         "deffactory needs `:manager`")))))

(deftest unknown-setting-reports-the-key-and-the-known-keys
  (let (dir (str "target/knave/test-factories/unknown-setting"))
    (unwrap-ok (prepare-factory dir
                                (str "(deffactory sample\n"
                                     "  :manager \"sample-manager\"\n"
                                     "  :max-activee 9\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto\n"
                                     "  (roles (worker :agent \"a\" :skill \"s\" :brief \"b\")))\n")))
    (let (reason (failure-reason (synth-factory (as-str dir)))
          output (unwrap-ok (run-synth (as-str dir))))
      (assert (contains? reason "deffactory does not know `:max-activee`"))
      (assert (contains? reason
                         "`:manager`, `:roadmap`, `:max-active` or `:merge`"))
      (assert (contains? reason "factory.knv:3:"))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output)
                         "deffactory does not know `:max-activee`")))))

(deftest repeated-setting-reports-the-key
  (let (dir (str "target/knave/test-factories/repeated-setting"))
    (unwrap-ok (prepare-factory dir
                                (str "(deffactory sample\n"
                                     "  :manager \"sample-manager\"\n"
                                     "  :roadmap \"sample-roadmap\"\n"
                                     "  :manager \"sample-manager-again\"\n"
                                     "  :max-active 1\n"
                                     "  :merge gh-auto\n"
                                     "  (roles (worker :agent \"a\" :skill \"s\" :brief \"b\")))\n")))
    (let (reason (failure-reason (synth-factory (as-str dir)))
          output (unwrap-ok (run-synth (as-str dir))))
      (assert (contains? reason "deffactory writes `:manager` twice"))
      (assert (contains? reason "factory.knv:2:"))
      (assert (= (exit-code output) 1))
      (assert (contains? (stderr-text output)
                         "deffactory writes `:manager` twice")))))

